---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import Icon from '../components/Icon.astro';
import site from '../utils/site';
import { waLink } from '../utils/whatsapp';

const title = 'Acerca de nosotros | Óptica Alta Visión 18';
const description =
  'Conoce la historia de Óptica Alta Visión 18: quiénes somos y por qué cuidamos tu visión como si fuera la de nuestra familia.';

const whatsappHref = waLink('nosotros', 'Hola, quiero saber más sobre Óptica Alta Visión 18');

const valores = [
  {
    icon: 'eye' as const,
    title: 'Atención personalizada',
    text: 'Cada examen visual se adapta a las necesidades de cada paciente, sin afán y con seguimiento.',
  },
  // Solo con dato real (Configuración → Años de experiencia).
  ...(site.aniosExperiencia !== null
    ? [
        {
          icon: 'shield' as const,
          title: 'Confianza y experiencia',
          text: `${site.aniosExperiencia} años atendiendo a familias${site.barrio ? ` de ${site.barrio}` : ''}, recomendando siempre lo que el paciente realmente necesita.`,
        },
      ]
    : []),
  {
    icon: 'star' as const,
    title: 'Calidad garantizada',
    text: 'Trabajamos con monturas y lentes de marcas reconocidas, con garantía y soporte postventa.',
  },
];

// La tarjeta de historia solo se muestra con datos reales del CMS (Configuración → Optómetra).
// TODO: agregar un campo de historia/biografía cuando el cliente la entregue.
const { nombre, cargo, tarjetaProfesional, foto } = site.optometra;
---

<BaseLayout
  title={title}
  description={description}
  canonical="https://optica-alta-vision-18.netlify.app/nosotros"
>
  <Header />

  <section class="bg-aguamarina py-10 text-white md:py-14">
    <div class="mx-auto max-w-6xl px-4">
      <h1 class="text-2xl font-bold md:text-3xl">Acerca de nosotros</h1>
      <p class="mt-2 text-white/90">
        Detrás de cada par de gafas hay una historia de cuidado y confianza.
      </p>
    </div>
  </section>

  {
    nombre && (
      <section class="bg-white py-12 md:py-20">
        <div
          class:list={[
            'mx-auto grid max-w-6xl gap-10 px-4 md:items-center md:gap-14',
            foto && 'md:grid-cols-2',
          ]}
        >
          {foto && (
            <div class="overflow-hidden rounded-2xl bg-aguamarina/10">
              <img
                src={foto}
                alt={cargo ? `${nombre}, ${cargo} de Óptica Alta Visión 18` : nombre}
                width="600"
                height="600"
                loading="lazy"
                class="aspect-square w-full object-cover"
              />
            </div>
          )}

          <div class="space-y-4">
            <p class="text-sm font-semibold uppercase tracking-wide text-fucsia">Quién te atiende</p>
            <h2 class="text-2xl font-bold text-slate-900 md:text-3xl">{nombre}</h2>
            {cargo && <p class="font-medium text-aguamarina">{cargo}</p>}
            {tarjetaProfesional && (
              <p class="text-sm text-slate-600">Tarjeta profesional {tarjetaProfesional}</p>
            )}
            {site.aniosExperiencia !== null && (
              <p class="text-slate-600">{site.aniosExperiencia} años de experiencia.</p>
            )}

            <a
              href={whatsappHref}
              data-cta="nosotros"
              class="inline-flex items-center gap-1.5 rounded-full bg-verde-neon px-6 py-3 text-sm font-semibold text-slate-900 shadow-sm transition-all hover:shadow-md"
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon name="whatsapp" class="h-4 w-4" />
              Conócenos por WhatsApp
            </a>
          </div>
        </div>
      </section>
    )
  }

  <section class="bg-aguamarina/5 py-12 md:py-16">
    <div class="mx-auto max-w-6xl px-4">
      <h2 class="text-center text-2xl font-bold text-slate-900 md:text-3xl">
        Lo que nos hace diferentes
      </h2>

      <div class:list={['mt-10 grid gap-6', valores.length === 3 ? 'sm:grid-cols-3' : 'sm:grid-cols-2']}>
        {
          valores.map((valor) => (
            <div class="rounded-2xl border border-slate-200 bg-white p-6 text-center shadow-sm">
              <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-aguamarina/10 text-aguamarina">
                <Icon name={valor.icon} class="h-6 w-6" />
              </div>
              <h3 class="mt-4 font-semibold text-slate-900">{valor.title}</h3>
              <p class="mt-2 text-sm text-slate-600">{valor.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <Footer />
  <WhatsAppFloat />
</BaseLayout>
