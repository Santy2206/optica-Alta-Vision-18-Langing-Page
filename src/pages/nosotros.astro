---
import BaseLayout from '../layouts/BaseLayout.astro';
import { seo } from '../utils/seo';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import Icon from '../components/Icon.astro';
import site from '../utils/site';
import { waLink } from '../utils/whatsapp';

const { title, description } = seo.nosotros;

const whatsappHref = waLink('nosotros', 'Hola, quiero saber más sobre Óptica Alta Visión 18');

// Cada bloque de esta página se oculta si su campo está vacío (Configuración → Optómetra / Página Nosotros).
const { nombre, cargo, tarjetaProfesional, foto } = site.optometra;
const { historia, cita, fotosLocal } = site.nosotros;
const historiaParrafos = historia
  .split('\n')
  .map((p) => p.trim())
  .filter(Boolean);

const cifras = [
  site.aniosExperiencia !== null && { valor: site.aniosExperiencia.toLocaleString('es-CO'), label: 'años de experiencia' },
  site.clientesAtendidos !== null && {
    valor: `+${site.clientesAtendidos.toLocaleString('es-CO')}`,
    label: 'clientes atendidos',
  },
].filter((c): c is { valor: string; label: string } => Boolean(c));
---

<BaseLayout title={title} description={description}>
  <Header />

  <section class="bg-brand-tint py-10 md:py-14">
    <div class="mx-auto max-w-6xl px-4">
      <h1 class="text-2xl font-bold text-slate-900 md:text-3xl">Acerca de nosotros</h1>
      <p class="mt-2 text-slate-600">Detrás de cada par de gafas hay una historia de cuidado y confianza.</p>
    </div>
  </section>

  {
    nombre && (
      <section class="bg-white py-12 md:py-20">
        <div class:list={['mx-auto grid max-w-6xl gap-10 px-4 md:items-center md:gap-14', foto && 'md:grid-cols-2']}>
          {foto && (
            <div class="overflow-hidden rounded-2xl bg-slate-100">
              <img
                src={foto}
                alt={cargo ? `${nombre}, ${cargo} de Óptica Alta Visión 18` : nombre}
                width="600"
                height="600"
                loading="lazy"
                class="aspect-square w-full object-cover"
              />
            </div>
          )}

          <div class="space-y-4">
            <p class="text-sm font-semibold uppercase tracking-wide text-fucsia">Quién te atiende</p>
            <h2 class="text-2xl font-bold text-slate-900 md:text-3xl">{nombre}</h2>
            {cargo && <p class="font-medium text-slate-700">{cargo}</p>}
            {tarjetaProfesional && <p class="text-sm text-slate-600">Tarjeta profesional {tarjetaProfesional}</p>}

            <a
              href={whatsappHref}
              data-cta="nosotros"
              class="inline-flex items-center gap-1.5 rounded-full border-2 border-slate-900 bg-verde-neon px-6 py-3 text-sm font-semibold text-slate-900 shadow-sm transition-all hover:shadow-md"
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon name="whatsapp" class="h-4 w-4" />
              Conócenos por WhatsApp
            </a>
          </div>
        </div>
      </section>
    )
  }

  {
    historiaParrafos.length > 0 && (
      <section class="bg-brand-tint py-12 md:py-16">
        <div class="mx-auto grid max-w-5xl items-center gap-10 px-4 md:grid-cols-2 md:gap-14">
          <div class="overflow-hidden rounded-2xl shadow-sm">
            <img
              src="/uploads/nosotros/placeholder-historia.webp"
              alt="Óptica Alta Visión 18"
              width="800"
              height="800"
              loading="lazy"
              class="aspect-square w-full object-cover"
            />
          </div>
          <div class="space-y-4">
            <h2 class="text-2xl font-bold text-slate-900 md:text-3xl">Nuestra historia</h2>
            {historiaParrafos.map((parrafo) => (
              <p class="text-slate-700">{parrafo}</p>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    cita && (
      <section class="bg-white py-12 md:py-16">
        <blockquote class="mx-auto max-w-2xl border-l-4 border-fucsia px-6 text-center">
          <p class="font-display text-xl font-semibold italic text-slate-900 md:text-2xl">“{cita}”</p>
        </blockquote>
      </section>
    )
  }

  {
    fotosLocal.length > 0 && (
      <section class="bg-brand-tint py-12 md:py-16">
        <div class="mx-auto max-w-6xl px-4">
          <h2 class="mb-8 text-center text-2xl font-bold text-slate-900 md:text-3xl">Nuestro local</h2>
          <div class="grid grid-cols-2 gap-4 sm:grid-cols-3">
            {fotosLocal.map((foto, i) => (
              <img
                src={foto}
                alt="Óptica Alta Visión 18"
                width="400"
                height="400"
                loading={i === 0 ? 'eager' : 'lazy'}
                class="aspect-square w-full rounded-2xl object-cover shadow-sm"
              />
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    cifras.length > 0 && (
      <section class="bg-white py-12 md:py-16">
        <dl class="mx-auto flex max-w-3xl flex-wrap justify-center gap-x-16 gap-y-6 px-4 text-center">
          {cifras.map((c) => (
            <div class="flex flex-col-reverse items-center">
              <dt class="text-sm font-medium text-slate-600">{c.label}</dt>
              <dd class="font-display text-4xl font-extrabold text-slate-900 md:text-5xl">{c.valor}</dd>
            </div>
          ))}
        </dl>
      </section>
    )
  }

  <section class="bg-brand-footer py-14 md:py-16">
    <div class="mx-auto max-w-2xl px-4 text-center">
      <h2 class="text-2xl font-bold text-slate-900 md:text-3xl">¿Quieres conocernos mejor?</h2>
      <a
        href={whatsappHref}
        data-cta="nosotros"
        class="mt-6 inline-flex items-center gap-1.5 rounded-full border-2 border-slate-900 bg-verde-neon px-6 py-3 text-sm font-semibold text-slate-900 shadow-sm transition-all hover:shadow-md"
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icon name="whatsapp" class="h-4 w-4" />
        Escríbenos por WhatsApp
      </a>
    </div>
  </section>

  <Footer />
  <WhatsAppFloat />
</BaseLayout>
