---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ComoFunciona from '../components/ComoFunciona.astro';
import PromoCarrusel from '../components/PromoCarrusel.astro';
import Promociones from '../components/Promociones.astro';
import EncuentraTusGafas from '../components/EncuentraTusGafas.astro';
import Catalogo from '../components/Catalogo.astro';
import PruebaSocial from '../components/PruebaSocial.astro';
import Confianza from '../components/Confianza.astro';
import Servicios from '../components/Servicios.astro';
import FAQ from '../components/FAQ.astro';
import Ubicacion from '../components/Ubicacion.astro';
import CtaFinal from '../components/CtaFinal.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import TryOnModal from '../components/TryOnModal.astro';
import FaceShapeTest from '../components/FaceShapeTest.astro';
import site from '../content/configuracion/site.json';

// TODO: reemplazar "Bogotá" por el barrio exacto cuando se confirme la dirección
const title = 'Óptica Alta Visión 18 | Óptica en Bogotá';
const description =
  'Óptica en Bogotá: exámenes de optometría y monturas formuladas y de sol. Agenda tu cita por WhatsApp hoy.';

// Mapeo básico para openingHoursSpecification (site.horario = "Lunes a Sábado, 11am - 8pm")
const dayMap: Record<string, string> = {
  lunes: 'Monday',
  martes: 'Tuesday',
  miércoles: 'Wednesday',
  jueves: 'Thursday',
  viernes: 'Friday',
  sábado: 'Saturday',
  domingo: 'Sunday',
};

const daysOfWeek = Object.entries(dayMap)
  .filter(([es]) => site.horario.toLowerCase().includes(es))
  .map(([, en]) => en);

// TODO: ajustar días y horarios exactos cuando el cliente confirme
const openingHours = {
  '@type': 'OpeningHoursSpecification',
  dayOfWeek: daysOfWeek,
  opens: '11:00',
  closes: '20:00',
};

const socialLinks = Object.values(site.redesSociales).filter((url) => url && url.trim() !== '');

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'Optician',
  name: 'Óptica Alta Visión 18',
  telephone: `+${site.telefono}`,
  // TODO (Fase 7): migrar a PostalAddress estructurado
  ...(site.direccion.trim() && { address: site.direccion }),
  url: 'https://optica-alta-vision-18.netlify.app',
  openingHoursSpecification: [openingHours],
  sameAs: socialLinks,
};
---

<BaseLayout
  title={title}
  description={description}
  canonical="https://optica-alta-vision-18.netlify.app"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(localBusiness)} />
  </Fragment>

  <Header />
  <Hero />
  <ComoFunciona />
  <PromoCarrusel />
  <Promociones />
  <EncuentraTusGafas />
  <Catalogo />
  <PruebaSocial />
  <Confianza />
  <Servicios />
  <FAQ />
  <Ubicacion />
  <CtaFinal />
  <Footer />
  <WhatsAppFloat />
  <TryOnModal />
  <FaceShapeTest />
</BaseLayout>
