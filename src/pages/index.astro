---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ComoFunciona from '../components/ComoFunciona.astro';
import PromoCarrusel from '../components/PromoCarrusel.astro';
import Promociones from '../components/Promociones.astro';
import EncuentraTusGafas from '../components/EncuentraTusGafas.astro';
import Catalogo from '../components/Catalogo.astro';
import PruebaSocial from '../components/PruebaSocial.astro';
import Servicios from '../components/Servicios.astro';
import TiposLente from '../components/TiposLente.astro';
import FAQ from '../components/FAQ.astro';
import Ubicacion from '../components/Ubicacion.astro';
import CtaFinal from '../components/CtaFinal.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import TryOnModal from '../components/TryOnModal.astro';
import FaceShapeTest from '../components/FaceShapeTest.astro';
import site from '../utils/site';
import { seo, zonaCompleta } from '../utils/seo';

const { title, description } = seo.home;
const siteUrl = Astro.site ?? new URL(Astro.url.origin);

// Mismo origen que el texto visible (site.horario): Configuración → Horario.
// TODO: confirmar la hora de apertura con el cliente (Google Maps dice 10am).
const { horarioSchema } = site;

const socialLinks = Object.values(site.redesSociales).filter(Boolean);
const { calle, localidad } = site.direccionPostal;
const { lat, lng } = site.geo;

// Sin aggregateRating: las pautas de Google no permiten reseñas de terceros (Google Maps)
// en el schema propio del negocio. La calificación se muestra solo en la página.
const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'Optician',
  '@id': new URL('/#optica', siteUrl).href,
  name: 'Óptica Alta Visión 18',
  url: siteUrl.href,
  image: new URL(site.heroImagen || '/og-default.png', siteUrl).href,
  logo: new URL('/logo.png', siteUrl).href,
  telephone: `+${site.telefono}`,
  ...(calle && {
    address: {
      '@type': 'PostalAddress',
      streetAddress: calle,
      addressLocality: localidad,
      addressRegion: 'Bogotá D.C.',
      addressCountry: 'CO',
    },
  }),
  ...(lat !== null &&
    lng !== null && {
      geo: { '@type': 'GeoCoordinates', latitude: lat, longitude: lng },
    }),
  ...(site.googleReviews.url && { hasMap: site.googleReviews.url }),
  areaServed: zonaCompleta,
  ...(horarioSchema && {
    openingHoursSpecification: [
      {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: horarioSchema.dias,
        opens: horarioSchema.abre,
        closes: horarioSchema.cierra,
      },
    ],
  }),
  ...(socialLinks.length > 0 && { sameAs: socialLinks }),
};
---

<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(localBusiness)} />
  </Fragment>

  <Header />
  <Hero />
  <ComoFunciona />
  <PromoCarrusel />
  <Promociones />
  <EncuentraTusGafas />
  <Catalogo />
  <PruebaSocial />
  <Servicios />
  <TiposLente />
  <FAQ />
  <Ubicacion />
  <CtaFinal />
  <Footer />
  <WhatsAppFloat />
  <TryOnModal />
  <FaceShapeTest />
</BaseLayout>
