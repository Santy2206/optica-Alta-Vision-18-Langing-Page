</style>

<style is:global>
  /* Permite animar el color de acento al cambiar de opción (sin esto el brillo de fondo salta). */
  @property --acc {
    syntax: '<color>';
    inherits: true;
    initial-value: #019fd8;
  }
  .tabs {
    transition: --acc 0.6s ease;
  }
</style>

<script>
  const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const header = document.querySelector<HTMLElement>('[data-header]');
  const setHeader = () => document.documentElement.style.setProperty('--hh', `${header?.offsetHeight ?? 64}px`);
  setHeader();
  addEventListener('resize', setHeader, { passive: true });

  // Ajuste de las gafas del hero: como cuando uno se las acomoda — bajan un poquito,
  // suben de golpe y asientan con un rebote pequeño. Se dispara al terminar el tipeo
  // y en cada hover sobre la imagen.
  const heroImg = document.querySelector<HTMLElement>('[data-hero] .hero__img');
  const ajusteGafas: Keyframe[] = [
    { transform: 'translateY(0) rotate(0deg)' },
    { transform: 'translateY(2.4%) rotate(-4.5deg)', offset: 0.22 },
    { transform: 'translateY(-1.9%) rotate(3deg)', offset: 0.48 },
    { transform: 'translateY(0.7%) rotate(-1.4deg)', offset: 0.7 },
    { transform: 'translateY(-0.25%) rotate(0.5deg)', offset: 0.86 },
    { transform: 'translateY(0) rotate(0deg)' },
  ];
  const ajustarGafas = () =>
    heroImg?.animate(ajusteGafas, { duration: 850, easing: 'cubic-bezier(0.3, 0.7, 0.3, 1)' });
  if (heroImg && !reduce) heroImg.addEventListener('mouseenter', ajustarGafas);

  // Tipeo del titular: escribe cada línea letra por letra con el cursor pegado al último
  // carácter; al terminar parpadea un rato y se retira. Sin JS o con "reducir movimiento"
  // el título sale completo de una vez.
  const tipeos = Array.from(document.querySelectorAll<HTMLElement>('[data-type]'));
  if (tipeos.length > 0 && !reduce) {
    const cursorEl = document.createElement('i');
    cursorEl.className = 'cursor-tipeo';
    cursorEl.setAttribute('aria-hidden', 'true');
    const textos = tipeos.map((el) => el.textContent ?? '');
    tipeos.forEach((el) => (el.textContent = ''));
    let li = 0;
    let ci = 0;
    const teclear = () => {
      const el = tipeos[li];
      ci += 1;
      el.textContent = textos[li].slice(0, ci);
      el.after(cursorEl);
      if (ci < textos[li].length) {
        setTimeout(teclear, 85);
        return;
      }
      li += 1;
      ci = 0;
      if (li < tipeos.length) setTimeout(teclear, 420);
      else {
        ajustarGafas();
        setTimeout(() => cursorEl.remove(), 2600);
      }
    };
    setTimeout(teclear, 450);
  }

  // Revelado al entrar: lo que está bajo el primer pantallazo aparece una sola vez.
  if (!reduce) {
    const rv = Array.from(document.querySelectorAll<HTMLElement>('.rv'));
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          (e.target as HTMLElement).classList.remove('rv-hide');
          io.unobserve(e.target);
        }),
      { threshold: 0.12 },
    );
    rv.forEach((el) => {
      if (el.getBoundingClientRect().top > innerHeight * 0.9) {
        el.classList.add('rv-hide');
        io.observe(el);
      }
    });
  }

  // Selectores: cada grupo [data-tabs] cambia sus paneles con chips, flechas o un gesto de lado.
  const roots = Array.from(document.querySelectorAll<HTMLElement>('[data-tabs]'));
  roots.forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-panel]'));
    const accs: string[] = JSON.parse(root.dataset.accs || '[]');
    let cur = -1;

    const set = (raw: number, desdeUsuario = false) => {
      const n = tabs.length;
      const i = ((raw % n) + n) % n;
      if (i === cur) return;
      cur = i;
      panels.forEach((p) => {
        const on = Number(p.dataset.panel) === i;
        p.classList.toggle('is-active', on);
        p.inert = !on;
      });
      tabs.forEach((t, k) => t.setAttribute('aria-pressed', String(k === i)));
      if (accs[i]) root.style.setProperty('--acc', accs[i]);
      root.dataset.current = String(i);
      root.dispatchEvent(new CustomEvent('cambio', { detail: i }));
      if (desdeUsuario) tabs[i].scrollIntoView({ inline: 'center', block: 'nearest', behavior: reduce ? 'auto' : 'smooth' });
    };

    tabs.forEach((t, k) => t.addEventListener('click', () => set(k, true)));
    root.querySelector('[data-prev]')?.addEventListener('click', () => set(cur - 1, true));
    root.querySelector('[data-next]')?.addEventListener('click', () => set(cur + 1, true));

    // Gesto de lado (solo táctil; el scroll vertical sigue funcionando).
    const swipe = root.querySelector<HTMLElement>('[data-swipe]');
    if (swipe) {
      let x0 = 0;
      let y0 = 0;
      swipe.addEventListener('pointerdown', (e) => {
        if (e.pointerType === 'mouse') return;
        x0 = e.clientX;
        y0 = e.clientY;
      });
      swipe.addEventListener('pointerup', (e) => {
        if (e.pointerType === 'mouse') return;
        const dx = e.clientX - x0;
        if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(e.clientY - y0) * 1.5) set(cur + (dx < 0 ? 1 : -1), true);
      });
    }

    set(0);
  });

  // Fotocromático: un deslizador controla cuánto sol recibe el lente. Al elegir la pestaña se hace una
  // demostración suave una sola vez; si la persona toca el deslizador, se detiene y manda ella.
  const lentesRoot = document.querySelector<HTMLElement>('[data-sol-tab]');
  const lente = lentesRoot?.querySelector<HTMLElement>('.lente2');
  const slider = lentesRoot?.querySelector<HTMLInputElement>('[data-sol]');
  if (lentesRoot && lente && slider) {
    const aplicar = (v: number) => {
      slider.value = String(Math.round(v * 100));
      lente.style.setProperty('--sol', v.toFixed(3));
    };
    let manual = false;
    let demostrado = false;
    slider.addEventListener('input', () => {
      manual = true;
      lente.style.setProperty('--sol', String(Number(slider.value) / 100));
    });
    lentesRoot.addEventListener('cambio', (e) => {
      if ((e as CustomEvent<number>).detail !== Number(lentesRoot.dataset.solTab) || demostrado || reduce) return;
      demostrado = true;
      const t0 = performance.now();
      const DUR = 2400;
      const paso = (now: number) => {
        if (manual) return;
        const k = clamp((now - t0 - 500) / DUR);
        aplicar(k < 0.5 ? 2 * k * k : 1 - Math.pow(-2 * k + 2, 2) / 2);
        if (k < 1) requestAnimationFrame(paso);
      };
      requestAnimationFrame(paso);
    });
  }

  // Cifras: cuentan hacia arriba una sola vez al entrar en pantalla. El HTML ya trae el valor final,
  // así que sin JS o con "reducir movimiento" se ve completo y quieto.
  const conf = document.querySelector<HTMLElement>('[data-confianza]');
  if (conf) {
    const nums = Array.from(conf.querySelectorAll<HTMLElement>('[data-count]'));
    const fmtN = (v: number, dec: number) => v.toFixed(dec).replace('.', ',');
    if (!reduce) nums.forEach((el) => (el.textContent = fmtN(0, Number(el.dataset.dec))));
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        conf.classList.add('is-in');
        if (reduce) return;
        const t0 = performance.now();
        const DUR = 1600;
        const tick = (now: number) => {
          const k = clamp((now - t0) / DUR);
          const e = 1 - Math.pow(1 - k, 3);
          nums.forEach((el) => {
            el.textContent = fmtN(Number(el.dataset.count) * (k >= 1 ? 1 : e), Number(el.dataset.dec));
          });
          if (k < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      },
      { threshold: 0.35 },
    );
    io.observe(conf);
  }
</script>
