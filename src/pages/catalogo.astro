---
import BaseLayout from '../layouts/BaseLayout.astro';
import { seo } from '../utils/seo';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import Icon from '../components/Icon.astro';
import TryOnModal from '../components/TryOnModal.astro';
import FaceShapeTest from '../components/FaceShapeTest.astro';
import { waLink } from '../utils/whatsapp';
import { priceLabel as getPriceLabel, isFallbackPrice } from '../utils/precio';
import { isPlaceholderImage } from '../utils/images';
import { getFrameShape, FRAME_SHAPES, frameShapeLabel } from '../data/frameShape';
import { faceShapeInfo, frameRecommendations } from '../data/faceShapeQuiz';
import FrameShapeIcon from '../components/FrameShapeIcon.astro';
import { getDisplayImage, getTryOnOverlayImage, getTryOnPhotochromicImage } from '../utils/cutout';
import FlowPasos from '../components/flow/FlowPasos.astro';
import FlowOpiniones from '../components/flow/FlowOpiniones.astro';
import FlowLenteModal from '../components/flow/FlowLenteModal.astro';
import FlowReveal from '../components/flow/FlowReveal.astro';
import '../styles/flow.css';
import { getCollection } from 'astro:content';

const { title, description } = seo.catalogo;

const items = await getCollection('catalogo');

const categorias = [
  { value: 'todos', label: 'Todos' },
  { value: 'formuladas', label: 'Formuladas' },
  { value: 'sol', label: 'Sol' },
  { value: 'ninos', label: 'Niños' },
  { value: 'deportivas', label: 'Deportivas' },
  { value: 'contacto', label: 'Lentes blandos' },
] as const;

const generos = [
  { value: 'todos', label: 'Todos' },
  { value: 'unisex', label: 'Unisex' },
  { value: 'hombre', label: 'Hombre' },
  { value: 'mujer', label: 'Mujer' },
] as const;

// Filtro por forma de rostro: las caras salen del mismo mapa que usa el test
// (faceShapeInfo) — una montura aparece para un rostro si su frameShape está
// recomendada para él (frameRecommendations).
const rostros = [
  { value: 'todos', label: 'Todos' },
  ...Object.entries(faceShapeInfo).map(([value, info]) => ({
    value,
    label: info.label,
  })),
] as const;

// Filtro por forma de la montura (el estilo del marco, no el rostro).
const formas = [
  { value: 'todos', label: 'Todas' },
  ...FRAME_SHAPES.map((value) => ({ value, label: frameShapeLabel[value] })),
] as const;
---

<BaseLayout
  title={title}
  description={description}
>
  <Header />

  <main class="flow">
  <section class="fl-pagina">
    <div class="fl-glow fl-glow--cian" style="top:-28vmax;right:-18vmax" aria-hidden="true"></div>
    <div class="fl-glow fl-glow--magenta" style="bottom:-34vmax;left:-24vmax;opacity:.22" aria-hidden="true"></div>
    <div class="fl-sec__inner">
      <p class="fl-eyebrow">Óptica Alta Visión 18</p>
      <h1 class="fl-h1">Catálogo <span class="fl-grad">completo</span></h1>
      <p class="fl-lead">Filtra por tipo, género, rostro o estilo y encuentra tu montura ideal.</p>
      <button type="button" data-facetest-open class="fl-btn fl-btn--lima mt-6">
        ¿No sabes cuál elegir? Haz el test de tu rostro
      </button>
    </div>
  </section>

  <section class="fl-sec !pt-4 md:!pt-6">
    <div class="fl-sec__inner">
      <div class="fl-filtros mb-8">
        <label class="fl-filtro">
          <span class="fl-filtro__label">Tipo <span>¿Qué estás buscando?</span></span>
          <select class="fl-select" data-filter-select aria-label="Filtrar por tipo de producto">
            {categorias.map((cat, i) => <option value={cat.value}>{i === 0 ? 'Todos los tipos' : cat.label}</option>)}
          </select>
        </label>
        <label class="fl-filtro">
          <span class="fl-filtro__label">Género <span>¿Para quién es?</span></span>
          <select class="fl-select" data-genero-select aria-label="Filtrar por género">
            {generos.map((g) => <option value={g.value}>{g.label}</option>)}
          </select>
        </label>
        <label class="fl-filtro">
          <span class="fl-filtro__label">Tu rostro <span>Solo lo que te favorece</span></span>
          <select class="fl-select" data-rostro-select aria-label="Filtrar por forma de rostro">
            {rostros.map((r, i) => <option value={r.value}>{i === 0 ? 'Todos los rostros' : r.label}</option>)}
          </select>
        </label>
        <label class="fl-filtro">
          <span class="fl-filtro__label">Estilo <span>La forma de la montura</span></span>
          <select class="fl-select" data-forma-select aria-label="Filtrar por forma de la montura">
            {formas.map((f) => <option value={f.value}>{f.label}</option>)}
          </select>
        </label>
      </div>

      {
        items.length > 0 ? (
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4" data-catalog-grid>
            {items.map((item, idx) => {
              const origen = `catalogo:${item.id}`;
              const waHref = waLink(origen, `Hola, quiero información sobre ${item.data.name}`);
              const priceLabel = getPriceLabel(item.data.price);
              const firstColor = item.data.colors[0];
              const tryOnFrame = firstColor?.name ?? '';
              const tryOnLenses = firstColor?.lenses ?? [];
              // "Probar con cámara" solo aparece si ya existe el recorte transparente
              // (scripts/generate-cutouts.mjs) de la foto de este color / de la montura.
              const overlayImage = getTryOnOverlayImage(firstColor?.image || item.data.image);
              const overlayImagePhotochromic = getTryOnPhotochromicImage(firstColor?.image || item.data.image);
              // Foto con fondo recortado automáticamente (scripts/generate-cutouts.mjs),
              // o la original si el recorte todavía no corrió para esta foto.
              const displayImage = isPlaceholderImage(item.data.image)
                ? item.data.image
                : getDisplayImage(item.data.image);
              // Hover: modelImage del color tiene prioridad; si no, hoverImage de la montura.
              // Misma foto de fondo recortado que displayImage para que combine con bg-slate-100.
              const hoverSource = firstColor?.modelImage || item.data.hoverImage;
              const hoverImage = hoverSource ? getDisplayImage(hoverSource) : '';
              // Rostros a los que favorece (filtro "forma de rostro"): primero el
              // campo `rostros` del JSON (lo llena la IA; el CMS lo puede corregir);
              // si está vacío se deriva del frameShape con la matriz del test.
              const shape = getFrameShape(item.data);
              const rostrosFavorecidos = item.data.rostros.length
                ? item.data.rostros
                : shape
                  ? (Object.keys(frameRecommendations) as Array<keyof typeof frameRecommendations>).filter(
                      (rostro) => frameRecommendations[rostro].includes(shape),
                    )
                  : [];

              return (
                <article
                  id={item.id}
                  class="fl-card fl-producto flex flex-col overflow-hidden scroll-mt-24"
                  data-catalog-item
                  data-category={item.data.category}
                  data-genero={item.data.genero ?? 'unisex'}
                  data-rostro={rostrosFavorecidos.join(' ')}
                  data-forma={shape ?? ''}
                >
                  <div class="relative aspect-[4/3] overflow-hidden bg-slate-100" data-photo-hover>
                    {isPlaceholderImage(item.data.image) ? (
                      <div class="flex h-full w-full items-center justify-center text-slate-400">
                        <FrameShapeIcon shape={getFrameShape(item.data) ?? 'ovalada'} class="h-16 w-16" />
                      </div>
                    ) : (
                      <img
                        src={displayImage}
                        alt={item.data.name}
                        loading={idx < 4 ? 'eager' : 'lazy'}
                        fetchpriority={idx < 4 ? 'high' : 'auto'}
                        decoding="async"
                        class="h-full w-full object-contain"
                        data-product-image
                        data-default-image={displayImage}
                        data-hover-image={hoverImage}
                        data-product-hover-image={item.data.hoverImage ? getDisplayImage(item.data.hoverImage) : ''}
                      />
                    )}
                  </div>
                  <div class="flex flex-1 flex-col gap-2 p-4">
                    <div>
                      <h2 class="line-clamp-3 min-h-[4.125rem] text-[0.95rem] font-semibold leading-[1.375rem] text-white sm:text-base md:line-clamp-2 md:min-h-[2.75rem]" title={item.data.name}>{item.data.name}</h2>
                      <p class="text-sm text-white/60">{item.data.brand}</p>
                    </div>

                    {item.data.colors.length > 0 && (
                      <div class="flex flex-wrap gap-2" role="group" aria-label="Colores del marco">
                        {item.data.colors.map((color, ci) => (
                          <button
                            type="button"
                            class:list={['fl-swatch', ci === 0 && 'is-sel']}
                            style={
                              color.hex2
                                ? `background: linear-gradient(135deg, ${color.hex} 50%, ${color.hex2} 50%)`
                                : `background-color: ${color.hex}`
                            }
                            title={color.name}
                            aria-label={`Marco ${color.name}`}
                            data-swatch
                            data-image={color.image ?? ''}
                            data-model-image={color.modelImage ? getDisplayImage(color.modelImage) : ''}
                            data-overlay-image={getTryOnOverlayImage(color.image || item.data.image) ?? ''}
                            data-overlay-image-photochromic={getTryOnPhotochromicImage(color.image || item.data.image) ?? ''}
                            data-lenses={JSON.stringify(color.lenses)}
                          />
                        ))}
                      </div>
                    )}

                    <p class:list={[isFallbackPrice(item.data.price) ? "text-sm text-white/70" : "text-base font-medium text-white"]}>{priceLabel}</p>
                    {item.data.category === 'formuladas' ? (
                      <button
                        type="button"
                        class="fl-btn fl-btn--lima fl-btn--sm mt-auto"
                        data-lente-open
                        data-name={item.data.name}
                        data-origen={origen}
                      >
                        Me interesa
                      </button>
                    ) : (
                      <a
                        href={waHref}
                        data-cta={origen}
                        class="fl-btn fl-btn--lima fl-btn--sm mt-auto"
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        Me interesa
                      </a>
                    )}
                    {overlayImage && (
                      <button
                        type="button"
                        class="fl-btn fl-btn--linea fl-btn--sm"
                        data-tryon-open
                        data-slug={item.id}
                        data-overlay-image={overlayImage}
                        data-overlay-image-photochromic={overlayImagePhotochromic ?? ''}
                        data-name={item.data.name}
                        data-frame={tryOnFrame}
                        data-lenses={JSON.stringify(tryOnLenses)}
                      >
                        <Icon name="eye" class="h-4 w-4" />
                        Probar con cámara
                      </button>
                    )}
                  </div>
                </article>
              );
            })}
          </div>
        ) : (
          <p class="text-center text-sm text-white/60">
            Catálogo vacío — agrega monturas desde el CMS.
          </p>
        )
      }

      <p class="mt-8 hidden text-center text-sm text-white/60" data-empty-message>
        No hay monturas con estos filtros todavía.
      </p>
    </div>
  </section>

  <FlowPasos />
  <FlowOpiniones />
  <FlowLenteModal />
  </main>

  <Footer />
  <WhatsAppFloat />
  <TryOnModal />
  <FaceShapeTest />
  <FlowReveal />
</BaseLayout>

<script>
  const selects = {
    categoria: document.querySelector<HTMLSelectElement>('[data-filter-select]'),
    genero: document.querySelector<HTMLSelectElement>('[data-genero-select]'),
    rostro: document.querySelector<HTMLSelectElement>('[data-rostro-select]'),
    forma: document.querySelector<HTMLSelectElement>('[data-forma-select]'),
  };
  const items = document.querySelectorAll<HTMLElement>('[data-catalog-item]');
  const emptyMessage = document.querySelector<HTMLElement>('[data-empty-message]');

  const state = { categoria: 'todos', genero: 'todos', rostro: 'todos', forma: 'todos' };
  type FiltroKey = keyof typeof state;

  const applyFilters = () => {
    let visibleCount = 0;

    items.forEach((item) => {
      const matches =
        (state.categoria === 'todos' || item.dataset.category === state.categoria) &&
        (state.genero === 'todos' || (item.dataset.genero ?? 'unisex') === state.genero) &&
        (state.rostro === 'todos' || (item.dataset.rostro ?? '').split(' ').includes(state.rostro)) &&
        (state.forma === 'todos' || (item.dataset.forma ?? '') === state.forma);
      item.classList.toggle('hidden', !matches);
      if (matches) visibleCount += 1;
    });

    emptyMessage?.classList.toggle('hidden', visibleCount > 0);

    (Object.keys(selects) as FiltroKey[]).forEach((key) => {
      const select = selects[key];
      if (select && select.value !== state[key]) select.value = state[key];
    });
  };

  (Object.keys(selects) as FiltroKey[]).forEach((key) => {
    selects[key]?.addEventListener('change', () => {
      state[key] = selects[key]!.value;
      applyFilters();
    });
  });

  const params = new URLSearchParams(window.location.search);
  const paramNames: Record<FiltroKey, string> = {
    categoria: 'categoria',
    genero: 'genero',
    rostro: 'rostro',
    forma: 'forma',
  };
  (Object.keys(selects) as FiltroKey[]).forEach((key) => {
    const value = params.get(paramNames[key]);
    const select = selects[key];
    if (value && select && Array.from(select.options).some((o) => o.value === value)) {
      state[key] = value;
    }
  });
  applyFilters();

  document.addEventListener('click', (e) => {
    const swatch = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-swatch]');
    if (!swatch) return;

    const article = swatch.closest('article');
    if (!article) return;

    const image = article.querySelector<HTMLImageElement>('[data-product-image]');
    if (image) {
      if (swatch.dataset.image) {
        image.src = swatch.dataset.image;
        image.dataset.defaultImage = swatch.dataset.image;
      }
      // modelImage del color, o si no la hoverImage original de la montura
      image.dataset.hoverImage = swatch.dataset.modelImage || image.dataset.productHoverImage || '';
    }

    article.querySelectorAll<HTMLButtonElement>('[data-swatch]').forEach((s) => {
      const selected = s === swatch;
      s.classList.toggle('is-sel', selected);
    });
  });

  document.querySelectorAll<HTMLElement>('[data-photo-hover]').forEach((container) => {
    const image = container.querySelector<HTMLImageElement>('[data-product-image]');
    if (!image) return;

    container.addEventListener('mouseenter', () => {
      if (image.dataset.hoverImage) image.src = image.dataset.hoverImage;
    });

    container.addEventListener('mouseleave', () => {
      if (image.dataset.defaultImage) image.src = image.dataset.defaultImage;
    });
  });
</script>
