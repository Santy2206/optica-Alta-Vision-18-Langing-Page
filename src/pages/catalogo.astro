---
import BaseLayout from '../layouts/BaseLayout.astro';
import { seo } from '../utils/seo';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import Icon from '../components/Icon.astro';
import TryOnModal from '../components/TryOnModal.astro';
import FaceShapeTest from '../components/FaceShapeTest.astro';
import { waLink } from '../utils/whatsapp';
import { priceLabel as getPriceLabel, isFallbackPrice } from '../utils/precio';
import { isPlaceholderImage } from '../utils/images';
import { getFrameShape } from '../data/frameShape';
import FrameShapeIcon from '../components/FrameShapeIcon.astro';
import { getDisplayImage, getTryOnOverlayImage, getTryOnPhotochromicImage } from '../utils/cutout';
import { getCollection } from 'astro:content';

const { title, description } = seo.catalogo;

const items = await getCollection('catalogo');

const categorias = [
  { value: 'todos', label: 'Todos' },
  { value: 'formuladas', label: 'Formuladas' },
  { value: 'sol', label: 'Sol' },
  { value: 'ninos', label: 'Niños' },
  { value: 'deportivas', label: 'Deportivas' },
  { value: 'contacto', label: 'Lentes blandos' },
] as const;
---

<BaseLayout
  title={title}
  description={description}
>
  <Header />

  <section class="bg-brand-tint py-10 md:py-14">
    <div class="mx-auto max-w-6xl px-4">
      <h1 class="text-2xl font-bold md:text-3xl">Catálogo completo</h1>
      <p class="mt-2 text-slate-600">Filtra por categoría y encuentra tu montura ideal.</p>
      <button
        type="button"
        data-facetest-open
        class="border-2 border-slate-900 mt-4 inline-block rounded-full bg-verde-neon px-5 py-2.5 text-sm font-semibold text-slate-900 shadow-sm transition-shadow hover:shadow-md"
      >
        ¿No sabes cuál elegir? Haz el test de tu rostro
      </button>
    </div>
  </section>

  <section class="bg-white py-10 md:py-16">
    <div class="mx-auto max-w-6xl px-4">
      <div class="mb-8 flex flex-wrap gap-2" role="group" aria-label="Filtrar por categoría" data-filter-group>
        {
          categorias.map((cat, i) => (
            <button
              type="button"
              class:list={[
                'rounded-full border px-4 py-2 text-sm font-medium transition-colors',
                i === 0
                  ? 'border-aguamarina bg-aguamarina text-slate-900'
                  : 'border-slate-300 bg-white text-slate-700 hover:border-aguamarina hover:text-aguamarina',
              ]}
              data-filter-btn
              data-filter={cat.value}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              {cat.label}
            </button>
          ))
        }
      </div>

      {
        items.length > 0 ? (
          <div class="grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-4" data-catalog-grid>
            {items.map((item) => {
              const origen = `catalogo:${item.id}`;
              const waHref = waLink(origen, `Hola, quiero información sobre ${item.data.name}`);
              const priceLabel = getPriceLabel(item.data.price);
              const firstColor = item.data.colors[0];
              const tryOnFrame = firstColor?.name ?? '';
              const tryOnLenses = firstColor?.lenses ?? [];
              // "Probar con cámara" solo aparece si ya existe el recorte transparente
              // (scripts/generate-cutouts.mjs) de la foto de este color / de la montura.
              const overlayImage = getTryOnOverlayImage(firstColor?.image || item.data.image);
              const overlayImagePhotochromic = getTryOnPhotochromicImage(firstColor?.image || item.data.image);
              // Foto con fondo recortado automáticamente (scripts/generate-cutouts.mjs),
              // o la original si el recorte todavía no corrió para esta foto.
              const displayImage = isPlaceholderImage(item.data.image)
                ? item.data.image
                : getDisplayImage(item.data.image);
              // Hover: modelImage del color tiene prioridad; si no, hoverImage de la montura.
              // Misma foto de fondo recortado que displayImage para que combine con bg-slate-100.
              const hoverSource = firstColor?.modelImage || item.data.hoverImage;
              const hoverImage = hoverSource ? getDisplayImage(hoverSource) : '';

              return (
                <article
                  class="flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition-shadow hover:shadow-md"
                  data-catalog-item
                  data-category={item.data.category}
                >
                  <div class="relative flex aspect-[4/3] items-center justify-center bg-slate-100 p-5 sm:p-6" data-photo-hover>
                    {isPlaceholderImage(item.data.image) ? (
                      <div class="flex h-full w-full items-center justify-center text-slate-400">
                        <FrameShapeIcon shape={getFrameShape(item.data) ?? 'ovalada'} class="h-16 w-16" />
                      </div>
                    ) : (
                      <img
                        src={displayImage}
                        alt={item.data.imageAlt}
                        loading="lazy"
                        class="max-h-full max-w-full object-contain"
                        data-product-image
                        data-default-image={displayImage}
                        data-hover-image={hoverImage}
                        data-product-hover-image={item.data.hoverImage ? getDisplayImage(item.data.hoverImage) : ''}
                      />
                    )}
                  </div>
                  <div class="flex flex-1 flex-col gap-2 p-4">
                    <div>
                      <h2 class="font-semibold text-slate-900">{item.data.name}</h2>
                      <p class="text-sm text-slate-500">{item.data.brand}</p>
                    </div>

                    {item.data.colors.length > 0 && (
                      <div class="flex flex-wrap gap-2" role="group" aria-label="Colores del marco">
                        {item.data.colors.map((color, ci) => (
                          <button
                            type="button"
                            class:list={[
                              'h-6 w-6 rounded-full border border-slate-300 transition-shadow',
                              ci === 0 && 'ring-2 ring-offset-2 ring-slate-900',
                            ]}
                            style={
                              color.hex2
                                ? `background: linear-gradient(135deg, ${color.hex} 50%, ${color.hex2} 50%)`
                                : `background-color: ${color.hex}`
                            }
                            title={color.name}
                            aria-label={`Marco ${color.name}`}
                            data-swatch
                            data-image={color.image ?? ''}
                            data-model-image={color.modelImage ? getDisplayImage(color.modelImage) : ''}
                            data-overlay-image={getTryOnOverlayImage(color.image || item.data.image) ?? ''}
                            data-overlay-image-photochromic={getTryOnPhotochromicImage(color.image || item.data.image) ?? ''}
                            data-lenses={JSON.stringify(color.lenses)}
                          />
                        ))}
                      </div>
                    )}

                    <p class:list={[isFallbackPrice(item.data.price) ? "text-sm text-slate-600" : "text-base font-medium text-slate-900"]}>{priceLabel}</p>
                    <a
                      href={waHref}
                      data-cta={origen}
                      class="border-2 border-slate-900 mt-auto inline-block rounded-full bg-verde-neon px-4 py-2 text-center text-sm font-semibold text-slate-900 transition-shadow hover:shadow-md"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Me interesa
                    </a>
                    {overlayImage && (
                      <button
                        type="button"
                        class="inline-flex items-center justify-center gap-1.5 rounded-full border border-slate-300 px-4 py-2 text-center text-sm font-semibold text-slate-700 transition-colors hover:border-aguamarina hover:text-aguamarina"
                        data-tryon-open
                        data-slug={item.id}
                        data-overlay-image={overlayImage}
                        data-overlay-image-photochromic={overlayImagePhotochromic ?? ''}
                        data-name={item.data.name}
                        data-frame={tryOnFrame}
                        data-lenses={JSON.stringify(tryOnLenses)}
                      >
                        <Icon name="eye" class="h-4 w-4" />
                        Probar con cámara
                      </button>
                    )}
                  </div>
                </article>
              );
            })}
          </div>
        ) : (
          <p class="text-center text-sm text-slate-500">
            Catálogo vacío — agrega monturas desde el CMS.
          </p>
        )
      }

      <p class="mt-8 hidden text-center text-sm text-slate-500" data-empty-message>
        No hay monturas en esta categoría todavía.
      </p>
    </div>
  </section>

  <Footer />
  <WhatsAppFloat />
  <TryOnModal />
  <FaceShapeTest />
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter-btn]');
  const items = document.querySelectorAll<HTMLElement>('[data-catalog-item]');
  const emptyMessage = document.querySelector<HTMLElement>('[data-empty-message]');

  const applyFilter = (filter: string) => {
    let visibleCount = 0;

    items.forEach((item) => {
      const matches = filter === 'todos' || item.dataset.category === filter;
      item.classList.toggle('hidden', !matches);
      if (matches) visibleCount += 1;
    });

    emptyMessage?.classList.toggle('hidden', visibleCount > 0);

    buttons.forEach((btn) => {
      const active = btn.dataset.filter === filter;
      btn.setAttribute('aria-pressed', active ? 'true' : 'false');
      btn.classList.toggle('border-aguamarina', active);
      btn.classList.toggle('bg-aguamarina', active);
      btn.classList.toggle('text-slate-900', active);
      btn.classList.toggle('bg-white', !active);
      btn.classList.toggle('text-slate-700', !active);
    });
  };

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      if (btn.dataset.filter) applyFilter(btn.dataset.filter);
    });
  });

  const params = new URLSearchParams(window.location.search);
  const initialFilter = params.get('categoria');
  if (initialFilter && Array.from(buttons).some((b) => b.dataset.filter === initialFilter)) {
    applyFilter(initialFilter);
  }

  document.addEventListener('click', (e) => {
    const swatch = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-swatch]');
    if (!swatch) return;

    const article = swatch.closest('article');
    if (!article) return;

    const image = article.querySelector<HTMLImageElement>('[data-product-image]');
    if (image) {
      if (swatch.dataset.image) {
        image.src = swatch.dataset.image;
        image.dataset.defaultImage = swatch.dataset.image;
      }
      // modelImage del color, o si no la hoverImage original de la montura
      image.dataset.hoverImage = swatch.dataset.modelImage || image.dataset.productHoverImage || '';
    }

    article.querySelectorAll<HTMLButtonElement>('[data-swatch]').forEach((s) => {
      const selected = s === swatch;
      s.classList.toggle('ring-2', selected);
      s.classList.toggle('ring-offset-2', selected);
      s.classList.toggle('ring-slate-900', selected);
    });
  });

  document.querySelectorAll<HTMLElement>('[data-photo-hover]').forEach((container) => {
    const image = container.querySelector<HTMLImageElement>('[data-product-image]');
    if (!image) return;

    container.addEventListener('mouseenter', () => {
      if (image.dataset.hoverImage) image.src = image.dataset.hoverImage;
    });

    container.addEventListener('mouseleave', () => {
      if (image.dataset.defaultImage) image.src = image.dataset.defaultImage;
    });
  });
</script>
