            <path d="M93 70q7 5 14 0" stroke="#334155" stroke-width="1.8" fill="none" stroke-linecap="round" />
            <path class="prep-lock-l" d="M78 42c-9 4-14 14-14 28 0 14 3 30 3 46l15 2c-4-18-6-36-5-54z" fill="#475569" />
            <path class="prep-lock-r" d="M122 42c9 4 14 14 14 28 0 14-3 30-3 46l-15 2c4-18 6-36 5-54z" fill="#475569" />
            <ellipse cx="100" cy="40" rx="27" ry="14" fill="#475569" />
            <path class="prep-fringe" d="M73 55q27-20 54 0l-3-15q-24-15-48 0z" fill="#475569" />
            <path class="prep-sparkle" d="M140 26l2 5.5 5.5 2-5.5 2-2 5.5-2-5.5-5.5-2 5.5-2z" fill="#fbbf24" />
