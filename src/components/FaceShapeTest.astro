          class="absolute inset-0 z-10 hidden flex-col items-center justify-center gap-3 bg-slate-900 p-6 text-center text-white"
          role="status"
          aria-live="polite"
          data-facetest-analyzing
        >
          <svg class="h-10 w-10 animate-spin text-verde-neon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="3" opacity="0.25" />
            <path d="M21 12a9 9 0 0 0-9-9" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
          </svg>
          <p class="text-sm font-semibold">Analizando tu rostro…</p>
          <p class="text-xs text-white/80">Solo tomará un momento.</p>
        </div>
      </div>
      <p class="mt-2 text-center text-[11px] text-slate-400">
        Tu foto se analiza en tu propio navegador — nunca se guarda ni se envía a ningún servidor.
      </p>
      <button
        type="button"
        class="border-2 border-slate-900 mt-4 w-full rounded-full bg-verde-neon px-4 py-2.5 text-center text-sm font-semibold text-slate-900 shadow-sm transition-shadow hover:shadow-md disabled:cursor-not-allowed disabled:opacity-40 disabled:shadow-none"
        data-facetest-capture
        disabled
      >
        Tomar foto
      </button>
    </div>

    <!-- Paso 3: resultado -->
    <div class="hidden" data-facetest-step="result">
      <div class="mb-4 flex items-center gap-4">
        {
          faceShapeIds.map((id) => (
            <img
              src={faceShapeInfo[id].image}
              alt={`Rostro ${faceShapeInfo[id].label}`}
              class="hidden h-16 w-16 object-contain"
              data-facetest-result-image={id}
            />
          ))
        }
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-aguamarina">Tu forma de rostro es</p>
          {
            faceShapeIds.map((id) => (
              <h4 class="hidden text-xl font-bold text-slate-900" data-facetest-result-label={id}>
                {faceShapeInfo[id].label}
              </h4>
            ))
          }
          <p class="mt-0.5 hidden text-sm font-medium text-aguamarina" data-facetest-result-subtype></p>
        </div>
      </div>

      <figure class="mb-4 hidden" data-facetest-overlay>
        <canvas
          class="w-full rounded-xl bg-slate-900"
          role="img"
          aria-label="Tu foto con las medidas del rostro marcadas"
          data-facetest-overlay-canvas
        ></canvas>
        <figcaption class="mt-2 text-sm text-slate-600">
          <strong class="block text-slate-900" data-facetest-overlay-headline></strong>
          <span data-facetest-overlay-detail></span>
        </figcaption>
      </figure>

      {
        faceShapeIds.map((id) => (
          <p class="hidden mb-3 text-sm text-slate-600" data-facetest-result-description={id}>
            {faceShapeInfo[id].description}
          </p>
        ))
      }

      <p class="mb-3 hidden text-sm text-slate-600" data-facetest-result-summary></p>

      <div
        class="mb-4 hidden rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-xs text-slate-600"
        data-facetest-result-ratios
      ></div>

      <p class="mb-5 hidden text-sm text-slate-500" data-facetest-uncertainty>
        ¿No estás seguro/a?{' '}
        <button
          type="button"
          class="font-semibold text-aguamarina underline-offset-2 hover:underline"
          data-facetest-goto-manual
        >
          Intenta con la guía de medición
        </button>
      </p>

      <div class="mb-4 flex flex-wrap items-center gap-2" role="group" aria-label="Filtrar monturas por género">
        <span class="text-sm font-semibold text-slate-900">Monturas:</span>
        {
          generoTabs.map(({ value, label }) => (
            <button
              type="button"
              aria-pressed={value === 'todos' ? 'true' : 'false'}
              data-facetest-genero-tab={value}
              class="rounded-full border-2 border-slate-900 bg-white px-3.5 py-1.5 text-xs font-semibold text-slate-900 transition-colors hover:bg-slate-100 aria-pressed:bg-verde-neon"
            >
              {label}
            </button>
          ))
        }
      </div>

      {
        faceShapeResults.map(({ shapeId, byGenero }) =>
          byGenero.map(({ value: generoValue, matches }) => (
          <div class="hidden" data-facetest-result-grid={shapeId} data-facetest-genero-grid={generoValue}>
            {matches.length > 0 ? (
              <>
              <div class="grid grid-cols-2 gap-4 sm:grid-cols-3">
                {matches.map((item, itemIdx) => (
                  <article
                    class:list={[
                      'flex flex-col overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm',
                      itemIdx >= 6 && 'hidden',
                      item.overlayImage && 'cursor-pointer transition-shadow hover:shadow-md',
                    ]}
                    data-vermas-item={itemIdx >= 6 ? '' : undefined}
                    data-tryon-card={item.overlayImage ? '' : undefined}
                  >
                    <div class="flex aspect-[4/3] items-center justify-center bg-aguamarina/10 p-5">
                      <img src={item.image} alt={item.imageAlt} loading="lazy" class="max-h-full max-w-full object-contain" />
                    </div>
                    <div class="flex flex-1 flex-col gap-1 p-3">
                      <h5 class="line-clamp-2 min-h-10 text-sm font-semibold leading-5 text-slate-900" title={item.name}>{item.name}</h5>
                      <p class="text-xs text-slate-500">{item.brand}</p>
                      <p class="text-sm font-medium text-slate-900">
                        {priceLabel(item.price)}
                      </p>
                      <a
                        href={waLink(`test-rostro:${shapeId}:${item.slug}`, `Hola, hice el test de rostro y me interesa ${item.name}`)}
                        data-cta={`test-rostro:${shapeId}:${item.slug}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="border-2 border-slate-900 mt-auto inline-block rounded-full bg-verde-neon px-3 py-1.5 text-center text-xs font-semibold text-slate-900 transition-shadow hover:shadow-md"
                      >
                        Me interesa
                      </a>
                      {item.overlayImage && (
                        <button
                          type="button"
                          class="inline-flex items-center justify-center gap-1 rounded-full border border-slate-300 px-3 py-1.5 text-center text-xs font-semibold text-slate-700 transition-colors hover:border-aguamarina hover:text-aguamarina"
                          data-tryon-open
                          data-slug={item.slug}
                          data-overlay-image={item.overlayImage}
                          data-overlay-image-photochromic={item.overlayImagePhotochromic ?? ''}
                          data-name={item.name}
                        >
                          <Icon name="eye" class="h-3.5 w-3.5" />
                          Probar
                        </button>
                      )}
                    </div>
                  </article>
                ))}
              </div>
              {matches.length > 6 && (
                <div class="mt-4 text-center">
                  <button
                    type="button"
                    data-facetest-vermas
                    data-count={matches.length}
                    aria-expanded="false"
                    class="rounded-full border border-slate-300 px-4 py-2 text-xs font-semibold text-slate-700 transition-colors hover:border-aguamarina hover:text-aguamarina"
                  >
                    Ver las {matches.length} monturas
                  </button>
                </div>
              )}
              </>
            ) : (
              <p class="text-sm text-slate-500">
                Escríbenos y te recomendamos las monturas que mejor le van a tu forma de rostro.
              </p>
            )}
          </div>
          ))
        )
      }

      <div class="mt-6 flex flex-col gap-3 sm:flex-row">
        <a
          href="/catalogo"
          class="border-2 border-slate-900 flex flex-1 items-center justify-center gap-2 rounded-full bg-verde-neon px-4 py-3 text-center text-sm font-semibold text-slate-900 shadow-sm transition-shadow hover:shadow-md"
          data-facetest-result-catalogo
        >
          <Icon name="eye" class="h-4 w-4 shrink-0" />
          <span data-facetest-result-catalogo-label>Ver monturas para mi rostro</span>
        </a>
        <button
          type="button"
          class="rounded-full border border-slate-300 px-4 py-2.5 text-center text-sm font-semibold text-slate-700 transition-colors hover:border-aguamarina hover:text-aguamarina"
          data-facetest-retry
        >
          Volver a intentar
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import { calculateFaceShape, InvalidMeasurementsError, isValidMeasurement, validateMeasurements } from '../data/faceShapeQuiz';
  import type { FaceMeasurements, FaceShapeResult, JawContour } from '../data/faceShapeQuiz';
  import {
    checkAlignment,
    detectFaceShape,
    captureFrames,
    drawMeasurementOverlay,
    resetMotionGate,
    AUTO_CAPTURE_STILL_MS,
    preloadFaceLandmarker,
    FaceShapeCameraError,
    type AlignmentResult,
  } from '../scripts/faceShapeCamera';

  const modal = document.querySelector<HTMLElement>('[data-facetest-modal]');

  if (modal) {
    const steps = ['intro', 'prepare', 'quiz', 'camera', 'result'] as const;
    type Step = (typeof steps)[number];

    const showStep = (step: Step) => {
      steps.forEach((s) => {
        modal.querySelector<HTMLElement>(`[data-facetest-step="${s}"]`)?.classList.toggle('hidden', s !== step);
      });
    };

    const video = modal.querySelector<HTMLVideoElement>('[data-facetest-video]');
    const captureBtn = modal.querySelector<HTMLButtonElement>('[data-facetest-capture]');
    const cameraLoading = modal.querySelector<HTMLElement>('[data-facetest-camera-loading]');
    const cameraError = modal.querySelector<HTMLElement>('[data-facetest-camera-error]');
    const cameraErrorMessage = modal.querySelector<HTMLElement>('[data-facetest-camera-error-message]');
    const analyzing = modal.querySelector<HTMLElement>('[data-facetest-analyzing]');

    const guide = modal.querySelector<SVGElement>('[data-facetest-guide]');
    const noseDot = modal.querySelector<SVGCircleElement>('[data-facetest-nose-dot]');
    const hint = modal.querySelector<HTMLElement>('[data-facetest-hint]');
    const prep = modal.querySelector<HTMLElement>('[data-facetest-prep]');
    let prepTimer: number | undefined;

    const hidePrep = () => {
      window.clearTimeout(prepTimer);
      prep?.classList.add('hidden');
    };

    const showPrep = () => {
      prep?.classList.remove('hidden');
      window.clearTimeout(prepTimer);
      prepTimer = window.setTimeout(hidePrep, 5000);
    };

    // Secuencia animada de preparación (3 escenas) previa a abrir la cámara.
    const prepScenes = Array.from(modal.querySelectorAll<HTMLElement>('[data-facetest-prep-scene]'));
    const prepDots = Array.from(modal.querySelectorAll<HTMLElement>('[data-facetest-prep-dot]'));
    const prepCaption = modal.querySelector<HTMLElement>('[data-facetest-prep-caption]');
    const PREP_PHASE_MS = 2200;
    const prepCaptions = [
      'Quítate la gorra y las gafas',
      'Ponte frente a la luz — evita la contraluz',
      'Despeja tu frente: recoge tu cabello',
    ];
    let prepSeqTimer: number | undefined;

    const cancelPrepSequence = () => {
      window.clearTimeout(prepSeqTimer);
      prepSeqTimer = undefined;
    };

    const setPrepPhase = (index: number) => {
      prepScenes.forEach((el, i) => el.classList.toggle('hidden', i !== index));
      prepDots.forEach((el, i) => {
        el.classList.toggle('bg-aguamarina', i === index);
        el.classList.toggle('bg-slate-300', i !== index);
      });
      if (prepCaption) prepCaption.textContent = prepCaptions[index] ?? '';
    };

    let stream: MediaStream | null = null;
    let alignTimer: number | undefined;
    let capturing = false;
    let cameraFailures = 0;
    const fallbackBanner = modal.querySelector<HTMLElement>('[data-facetest-fallback]');

    const updateFallbackBanner = () => {
      const show = cameraFailures >= 2;
      fallbackBanner?.classList.toggle('hidden', !show);
      fallbackBanner?.classList.toggle('flex', show);
    };

    const resetCameraFailures = () => {
      cameraFailures = 0;
      updateFallbackBanner();
    };

    const ALIGN_INTERVAL_MS = 200;

    const hintText = ({ issue, direction, stillMs = 0 }: AlignmentResult): string => {
      switch (issue) {
        case 'NO_FACE':
          return 'Ubica tu rostro frente a la cámara';
        case 'TOO_FAR':
          return 'Acércate un poco a la cámara';
        case 'TOO_CLOSE':
          return 'Aléjate un poco de la cámara';
        case 'OFF_CENTER':
          return `Mueve tu rostro hacia ${direction === 'arriba' || direction === 'abajo' ? '' : 'la '}${direction}: la punta de tu nariz va en el círculo`;
        case 'TURNED':
          return 'Gira un poco: mira directo a la cámara';
        case 'TILTED':
          return 'Endereza la cabeza, sin inclinarla hacia un hombro';
        case 'PITCHED':
          return 'Mantén la cara de frente (no inclines la cabeza)';
        default:
          return stillMs > 0
            ? `¡Perfecto! No te muevas… ${Math.max(0, (AUTO_CAPTURE_STILL_MS - stillMs) / 1000).toFixed(1)} s`
            : 'Quédate totalmente quieto para que la foto salga nítida';
      }
    };

    const renderAlignment = (alignment: AlignmentResult) => {
      const ok = alignment.issue === null;
      guide?.classList.toggle('text-emerald-400', ok);
      guide?.classList.toggle('text-white/80', !ok);
      if (noseDot) {
        noseDot.classList.toggle('hidden', !alignment.nose);
        if (alignment.nose) {
          noseDot.setAttribute('cx', alignment.nose.x.toFixed(1));
          noseDot.setAttribute('cy', alignment.nose.y.toFixed(1));
        }
      }
      if (hint) {
        hint.textContent = hintText(alignment);
        hint.classList.remove('hidden');
      }
      if (captureBtn) captureBtn.disabled = !ok;
      if (ok && (alignment.stillMs ?? 0) >= AUTO_CAPTURE_STILL_MS && !capturing) {
        resetMotionGate();
        captureBtn?.click();
      }
    };

    const resetAlignment = () => {
      window.clearTimeout(alignTimer);
      alignTimer = undefined;
      resetMotionGate();
      guide?.classList.remove('text-emerald-400');
      guide?.classList.add('text-white/80');
      noseDot?.classList.add('hidden');
      hint?.classList.add('hidden');
    };

    // Revisión en vivo del encuadre (~5 veces por segundo). Si el analizador no
    // carga, se habilita el botón igual y el error se maneja al capturar.
    const alignLoop = async () => {
      const current = stream;
      if (!current || !video) return;
      if (!capturing) {
        try {
          const alignment = await checkAlignment(video);
          if (stream !== current) return;
          renderAlignment(alignment);
        } catch {
          if (stream !== current) return;
          resetAlignment();
          if (captureBtn) captureBtn.disabled = false;
          return;
        }
      }
      alignTimer = window.setTimeout(alignLoop, ALIGN_INTERVAL_MS);
    };

    const showCameraError = (message: string) => {
      if (cameraErrorMessage) cameraErrorMessage.textContent = message;
      cameraError?.classList.remove('hidden');
      cameraError?.classList.add('flex');
    };

    const hideCameraError = () => {
      cameraError?.classList.add('hidden');
      cameraError?.classList.remove('flex');
    };

    const stopCamera = () => {
      stream?.getTracks().forEach((track) => track.stop());
      stream = null;
      hidePrep();
      resetAlignment();
    };

    const startCamera = async () => {
      stopCamera();
      hideCameraError();
      cameraLoading?.classList.remove('hidden');
      if (captureBtn) captureBtn.disabled = true;
      preloadFaceLandmarker();

      try {
        stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user' } });
        if (video) {
          video.srcObject = stream;
          await video.play();
        }
        cameraLoading?.classList.add('hidden');
        showPrep();
        if (hint) {
          hint.textContent = 'Preparando la guía…';
          hint.classList.remove('hidden');
        }
        alignLoop();
      } catch {
        cameraLoading?.classList.add('hidden');
        showCameraError('No pudimos acceder a tu cámara. Verifica los permisos de tu navegador e intenta de nuevo.');
      }
    };

    // Flujo completo: animación de preparación (3 escenas) y luego la cámara.
    // Al terminar la última escena avanza sola; el botón "Abrir cámara" la salta.
    const startCameraFlow = () => {
      cancelPrepSequence();
      resetCameraFailures();
      showStep('prepare');
      let phase = 0;
      setPrepPhase(0);
      const advance = () => {
        phase += 1;
        if (phase >= prepScenes.length) {
          prepSeqTimer = undefined;
          showStep('camera');
          startCamera();
          return;
        }
        setPrepPhase(phase);
        prepSeqTimer = window.setTimeout(advance, PREP_PHASE_MS);
      };
      prepSeqTimer = window.setTimeout(advance, PREP_PHASE_MS);
    };

    modal.querySelector('[data-facetest-prep-skip]')?.addEventListener('click', () => {
      cancelPrepSequence();
      showStep('camera');
      startCamera();
    });
    modal.querySelector('[data-facetest-prep-back]')?.addEventListener('click', () => {
      cancelPrepSequence();
      showStep('intro');
    });

    captureBtn?.addEventListener('click', async () => {
      if (!stream || !video) return;
      captureBtn.disabled = true;
      capturing = true;
      analyzing?.classList.remove('hidden');
      analyzing?.classList.add('flex');
      guide?.classList.add('hidden');
      hint?.classList.add('hidden');

      try {
        const frames = await captureFrames(video);
        stopCamera();
        const result = detectFaceShape(frames);
        resetCameraFailures();
        renderResult(result.shape, 'camera', result);
        showOverlay(result.overlay);
        showStep('result');
      } catch (err) {
        stopCamera();
        cameraFailures++;
        updateFallbackBanner();
        let message = 'No pudimos analizar tu rostro ahora mismo. Prueba con la guía de medición.';
        if (err instanceof FaceShapeCameraError) {
          if (err.code === 'NO_FACE') {
            message = 'No detectamos tu rostro con claridad. Ubícate frente a la cámara con buena luz e intenta de nuevo.';
          } else if (err.code === 'BAD_ANGLE') {
            message = 'Gira tu rostro para mirar directo a la cámara, sin inclinarlo, y toma la foto de nuevo.';
          }
        }
        showCameraError(message);
      } finally {
        capturing = false;
        analyzing?.classList.add('hidden');
        analyzing?.classList.remove('flex');
        guide?.classList.remove('hidden');
      }
    });

    modal.querySelectorAll('[data-facetest-retry-camera]').forEach((btn) => btn.addEventListener('click', startCamera));
    modal.querySelectorAll('[data-facetest-switch-quiz]').forEach((btn) =>
      btn.addEventListener('click', () => {
        stopCamera();
        resetMeasureForm();
        showStep('quiz');
      }),
    );

    // --- Calculadora de medidas ---
    const measureForm = modal.querySelector<HTMLFormElement>('[data-facetest-measure-form]');
    const measureInputs = modal.querySelectorAll<HTMLInputElement>('[data-measure-input]');
    const submitMeasureBtn = modal.querySelector<HTMLButtonElement>('[data-facetest-submit-quiz]');
    const measureError = modal.querySelector<HTMLElement>('[data-facetest-measure-error]');

    const parseCm = (raw: string): number => {
      const normalized = raw.trim().replace(',', '.');
      return Number.parseFloat(normalized);
    };

    const fieldValue = (name: string): string => {
      const el = measureForm?.elements.namedItem(name);
      return el instanceof HTMLInputElement ? el.value : '';
    };

    const readMeasurements = (): FaceMeasurements | null => {
      const forehead = parseCm(fieldValue('forehead'));
      const cheekbones = parseCm(fieldValue('cheekbones'));
      const jaw = parseCm(fieldValue('jaw'));
      const length = parseCm(fieldValue('length'));

      const jawRadio = measureForm?.querySelector<HTMLInputElement>('input[name="jawContour"]:checked');
      const jawContour = (jawRadio?.value === 'angular' ? 'angular' : 'suave') as JawContour;

      if (![forehead, cheekbones, jaw, length].every(isValidMeasurement)) return null;

      return { forehead, cheekbones, jaw, length, jawContour };
    };

    const updateMeasureValidity = () => {
      const values = Array.from(measureInputs).map((input) => parseCm(input.value));
      const ok = values.length === 4 && values.every((v) => isValidMeasurement(v));
      const [forehead, cheekbones, jaw, length] = values;
      const implausible = ok ? validateMeasurements({ forehead, cheekbones, jaw, length }) : null;
      if (submitMeasureBtn) submitMeasureBtn.disabled = !ok || implausible !== null;
      if (measureError) {
        measureError.textContent = implausible ?? '';
        measureError.classList.toggle('hidden', implausible === null);
      }
    };

    const resetMeasureForm = () => {
      measureForm?.reset();
      const soft = measureForm?.querySelector<HTMLInputElement>('input[name="jawContour"][value="suave"]');
      if (soft) soft.checked = true;
      if (submitMeasureBtn) submitMeasureBtn.disabled = true;
      if (measureError) {
        measureError.classList.add('hidden');
        measureError.textContent = '';
      }
    };

    measureInputs.forEach((input) => {
      input.addEventListener('input', updateMeasureValidity);
      input.addEventListener('change', updateMeasureValidity);
    });
    measureForm?.querySelectorAll<HTMLInputElement>('input[name="jawContour"]').forEach((radio) => {
      radio.addEventListener('change', updateMeasureValidity);
    });

    measureForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      const measurements = readMeasurements();
      if (!measurements) {
        if (measureError) {
          measureError.textContent =
            'Revisa las medidas: usa centímetros entre 8 y 30 (ej. 13,5). Las 4 casillas son obligatorias.';
          measureError.classList.remove('hidden');
        }
        return;
      }

      try {
        const result = calculateFaceShape(measurements);
        renderResult(result.shape, 'quiz', result);
        showStep('result');
      } catch (err) {
        if (!(err instanceof InvalidMeasurementsError)) throw err;
        if (measureError) {
          measureError.textContent = err.message;
          measureError.classList.remove('hidden');
        }
      }
    });

    // --- Resultado ---
    const uncertaintyNote = modal.querySelector<HTMLElement>('[data-facetest-uncertainty]');
    const subtypeEl = modal.querySelector<HTMLElement>('[data-facetest-result-subtype]');
    const summaryEl = modal.querySelector<HTMLElement>('[data-facetest-result-summary]');
    const ratiosEl = modal.querySelector<HTMLElement>('[data-facetest-result-ratios]');

    const overlayFigure = modal.querySelector<HTMLElement>('[data-facetest-overlay]');
    const overlayCanvas = modal.querySelector<HTMLCanvasElement>('[data-facetest-overlay-canvas]');
    const overlayHeadline = modal.querySelector<HTMLElement>('[data-facetest-overlay-headline]');
    const overlayDetail = modal.querySelector<HTMLElement>('[data-facetest-overlay-detail]');

    function showOverlay(overlay: Parameters<typeof drawMeasurementOverlay>[1]) {
      if (!overlayCanvas) return;
      drawMeasurementOverlay(overlayCanvas, overlay);
      if (overlayHeadline) overlayHeadline.textContent = overlay.explanation.headline;
      if (overlayDetail) overlayDetail.textContent = overlay.explanation.detail;
      overlayFigure?.classList.remove('hidden');
    }

    let currentShape = '';
    let currentGenero = 'todos';

    function applyGridVisibility() {
      modal!.querySelectorAll<HTMLElement>('[data-facetest-result-grid]').forEach((el) => {
        el.classList.toggle(
          'hidden',
          el.dataset.facetestResultGrid !== currentShape || el.dataset.facetestGeneroGrid !== currentGenero,
        );
      });
      modal!.querySelectorAll<HTMLElement>('[data-facetest-genero-tab]').forEach((el) => {
        el.setAttribute('aria-pressed', String(el.dataset.facetestGeneroTab === currentGenero));
      });
    }

    modal.querySelectorAll<HTMLElement>('[data-facetest-genero-tab]').forEach((tab) =>
      tab.addEventListener('click', () => {
        currentGenero = tab.dataset.facetestGeneroTab ?? 'todos';
        applyGridVisibility();
      }),
    );

    // "Ver las N monturas": despliega el resto de la lista dentro de su propia
    // grilla (cada combinación rostro+género tiene la suya).
    modal.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-facetest-vermas]');
      const grid = btn?.closest<HTMLElement>('[data-facetest-result-grid]');
      if (!btn || !grid) return;
      const items = grid.querySelectorAll<HTMLElement>('[data-vermas-item]');
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      items.forEach((el) => el.classList.toggle('hidden', expanded));
      btn.setAttribute('aria-expanded', String(!expanded));
      btn.textContent = expanded ? `Ver las ${btn.dataset.count ?? ''} monturas` : 'Ver menos';
    });

    function renderResult(shapeId: string, source: 'camera' | 'quiz' | 'manual', detail?: FaceShapeResult) {
      overlayFigure?.classList.add('hidden');
      modal!.querySelectorAll<HTMLElement>('[data-facetest-result-image]').forEach((el) => {
        el.classList.toggle('hidden', el.dataset.facetestResultImage !== shapeId);
      });
      modal!.querySelectorAll<HTMLElement>('[data-facetest-result-label]').forEach((el) => {
        el.classList.toggle('hidden', el.dataset.facetestResultLabel !== shapeId);
      });
      modal!.querySelectorAll<HTMLElement>('[data-facetest-result-description]').forEach((el) => {
        el.classList.toggle('hidden', el.dataset.facetestResultDescription !== shapeId);
      });
      currentShape = shapeId;
      applyGridVisibility();
      uncertaintyNote?.classList.toggle('hidden', source !== 'camera');

      if (subtypeEl) {
        if (detail?.subtype) {
          subtypeEl.textContent = `Subtipo: ${detail.subtype}${detail.confidence === 'media' ? ' (aproximado)' : ''}`;
          subtypeEl.classList.remove('hidden');
        } else {
          subtypeEl.textContent = '';
          subtypeEl.classList.add('hidden');
        }
      }

      if (summaryEl) {
        if (detail?.summary) {
          summaryEl.textContent = detail.summary;
          summaryEl.classList.remove('hidden');
        } else {
          summaryEl.textContent = '';
          summaryEl.classList.add('hidden');
        }
      }

      if (ratiosEl) {
        if (detail?.ratios) {
          const r = detail.ratios;
          // Mismos colores que las líneas del overlay: largo azul, frente amarilla, pómulos fucsia, mandíbula aguamarina.
          const sw = (color: string) =>
            `<span class="inline-block w-3 h-1.5 rounded-full align-middle mr-0.5" style="background:${color}"></span>`;
          const LARGO = '#38bdf8', FRENTE = '#fbbf24', POMULOS = '#ff1493', MANDIBULA = '#00b4b0';
          ratiosEl.innerHTML = `
            <p class="font-semibold text-slate-800 mb-1">Proporciones calculadas</p>
            <ul class="grid grid-cols-2 gap-x-3 gap-y-0.5">
              <li>${sw(LARGO)}Largo / ${sw(POMULOS)}ancho: <strong>${r.lengthToWidth}</strong></li>
              <li>${sw(FRENTE)}Frente / ${sw(MANDIBULA)}mandíbula: <strong>${r.foreheadToJaw}</strong></li>
              <li>${sw(POMULOS)}Pómulos / ${sw(FRENTE)}frente: <strong>${r.cheekToForehead}</strong></li>
              <li>${sw(POMULOS)}Pómulos / ${sw(MANDIBULA)}mandíbula: <strong>${r.cheekToJaw}</strong></li>
            </ul>
          `;
          ratiosEl.classList.remove('hidden');
        } else {
          ratiosEl.innerHTML = '';
          ratiosEl.classList.add('hidden');
        }
      }

      const baseLabel =
        modal!.querySelector<HTMLElement>(`[data-facetest-result-label="${shapeId}"]`)?.textContent ?? '';
      const label = detail?.displayLabel ?? baseLabel;
      // El CTA lleva al catálogo con el filtro de rostro ya aplicado.
      const catalogo = modal!.querySelector<HTMLAnchorElement>('[data-facetest-result-catalogo]');
      if (catalogo) {
        const origen = `test-rostro:${shapeId}`;
        const forma = baseLabel.trim().toLowerCase();
        catalogo.href = `/catalogo?rostro=${shapeId}`;
        catalogo.dataset.cta = origen;
        const ctaLabel = catalogo.querySelector<HTMLElement>('[data-facetest-result-catalogo-label]');
        if (ctaLabel) ctaLabel.textContent = `Ver monturas para rostro ${forma}`;
      }
    }

    modal.querySelector('[data-facetest-goto-manual]')?.addEventListener('click', () => {
      resetMeasureForm();
      showStep('quiz');
    });

    // --- Navegación general del modal ---
    const openModal = () => {
      resetCameraFailures();
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      showStep('intro');
    };

    const closeModal = () => {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      cancelPrepSequence();
      stopCamera();
    };

    modal.querySelector('[data-facetest-close]')?.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeModal();
    });

    modal.querySelector('[data-facetest-start="camera"]')?.addEventListener('click', startCameraFlow);
    modal.querySelector('[data-facetest-start="quiz"]')?.addEventListener('click', () => {
      resetMeasureForm();
      showStep('quiz');
    });

    modal.querySelectorAll('[data-facetest-retry]').forEach((btn) =>
      btn.addEventListener('click', () => {
        resetMeasureForm();
        showStep('intro');
      }),
    );

    // Disparadores en cualquier parte de la página.
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;

      if (target.closest('[data-facetest-open]')) {
        openModal();
        return;
      }

      // data-facetest-direct="camera|quiz": abre el modal saltando directo al
      // paso elegido (botones de la sección puente del inicio).
      const directBtn = target.closest<HTMLElement>('[data-facetest-direct]');
      if (directBtn) {
        openModal();
        if (directBtn.dataset.facetestDirect === 'camera') {
          startCameraFlow();
        } else {
          resetMeasureForm();
          showStep('quiz');
        }
        return;
      }

      const manualBtn = target.closest<HTMLElement>('[data-facetest-manual]');
      if (manualBtn) {
        const shape = manualBtn.dataset.facetestManual;
        if (shape) {
          openModal();
          renderResult(shape, 'manual');
          showStep('result');
        }
      }
    });
  }
</script>

<style>
  /* Escena 1: la gorra sale hacia arriba y las gafas se retiran */
  .prep-cap {
    animation: prep-cap-off 2.2s ease forwards;
  }
  .prep-glasses {
    animation: prep-glasses-off 2.2s ease forwards;
  }
  @keyframes prep-cap-off {
    0%, 25% { transform: translateY(0); opacity: 1; }
    65%, 100% { transform: translateY(-46px); opacity: 0; }
  }
  @keyframes prep-glasses-off {
    0%, 40% { transform: translate(0, 0); opacity: 1; }
    80%, 100% { transform: translate(16px, -30px); opacity: 0; }
  }

  /* Escena 2: sol a contraluz tachado, sol frontal con haces y check final */
  .prep-sun-back {
    animation: prep-sun-back 2.2s ease forwards;
  }
  .prep-slash {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    animation: prep-slash-in 2.2s ease forwards;
  }
  .prep-sun-front {
    opacity: 0;
    animation: prep-sun-in 2.2s ease forwards;
  }
  .prep-beams {
    opacity: 0;
    animation: prep-beams-in 2.2s ease forwards;
  }
  .prep-check {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    animation: prep-check-in 2.2s ease forwards;
  }
  @keyframes prep-sun-back {
    0%, 55% { opacity: 1; }
    85%, 100% { opacity: 0; }
  }
  @keyframes prep-slash-in {
    0%, 28% { opacity: 0; transform: scale(1.4); }
    45%, 100% { opacity: 1; transform: scale(1); }
  }
  @keyframes prep-sun-in {
    0%, 55% { opacity: 0; transform: translateX(-10px); }
    75%, 100% { opacity: 1; transform: translateX(0); }
  }
  @keyframes prep-beams-in {
    0%, 72% { opacity: 0; }
    88%, 100% { opacity: 0.85; }
  }
  @keyframes prep-check-in {
    0%, 78% { opacity: 0; transform: scale(0.3); }
    92%, 100% { opacity: 1; transform: scale(1); }
  }

  /* Escena 3: el flequillo sube hacia atrás, los mechones largos se recogen
     hacia los lados (detrás de las orejas) y aparece el moño */
  .prep-fringe {
    transform-box: fill-box;
    transform-origin: center;
    animation: prep-fringe 2.2s ease forwards;
  }
  .prep-lock-l {
    transform-box: fill-box;
    transform-origin: top center;
    animation: prep-lock-l 2.2s ease forwards;
  }
  .prep-lock-r {
    transform-box: fill-box;
    transform-origin: top center;
    animation: prep-lock-r 2.2s ease forwards;
  }
  .prep-bun {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    animation: prep-bun-in 2.2s ease forwards;
  }
  .prep-sparkle {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    animation: prep-sparkle-in 2.2s ease forwards;
  }
  @keyframes prep-fringe {
    0%, 30% { transform: translateY(0) scale(1); opacity: 1; }
    70%, 100% { transform: translateY(-15px) scale(0.85); opacity: 0; }
  }
  @keyframes prep-lock-l {
    0%, 30% { transform: translate(0, 0) rotate(0deg); }
    80%, 100% { transform: translate(-15px, -3px) rotate(-7deg); }
  }
  @keyframes prep-lock-r {
    0%, 30% { transform: translate(0, 0) rotate(0deg); }
    80%, 100% { transform: translate(15px, -3px) rotate(7deg); }
  }
  @keyframes prep-bun-in {
    0%, 62% { opacity: 0; transform: scale(0.4); }
    82%, 100% { opacity: 1; transform: scale(1); }
  }
  @keyframes prep-sparkle-in {
    0%, 75% { opacity: 0; transform: scale(0.4); }
    90%, 100% { opacity: 1; transform: scale(1); }
  }

  /* Barra de progreso: dura lo mismo que las 3 escenas (~6.6 s) */
  .prep-progress {
    animation: prep-progress 6.6s linear forwards;
  }
  @keyframes prep-progress {
    from { width: 0; }
    to { width: 100%; }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-facetest-step='prepare'] svg * {
      animation-duration: 0.01s !important;
      animation-delay: 0s !important;
    }
  }
</style>
