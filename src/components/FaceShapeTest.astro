            </g>
          </svg>
        </div>
        <p
          class="mt-3 min-h-6 text-center text-sm font-semibold text-slate-900"
          aria-live="polite"
          data-facetest-prep-caption
        ></p>
        <div class="mt-1 flex items-center justify-center gap-1.5">
          <span class="h-1.5 w-1.5 rounded-full bg-slate-300 transition-colors" data-facetest-prep-dot></span>
          <span class="h-1.5 w-1.5 rounded-full bg-slate-300 transition-colors" data-facetest-prep-dot></span>
          <span class="h-1.5 w-1.5 rounded-full bg-slate-300 transition-colors" data-facetest-prep-dot></span>
        </div>
        <div class="mx-auto mt-3 h-1.5 w-40 overflow-hidden rounded-full bg-slate-200">
          <div class="prep-progress h-full rounded-full bg-aguamarina" style="width: 0"></div>
        </div>
      </div>
      <div class="mt-4 flex items-center justify-between gap-3">
        <button
          type="button"
