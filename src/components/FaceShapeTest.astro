---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import { waLink } from '../utils/whatsapp';
import { priceLabel } from '../utils/precio';
import { getFrameShape } from '../data/frameShape';
import type { FrameShape } from '../data/frameShape';
import { getTryOnOverlayImage, getTryOnPhotochromicImage } from '../utils/cutout';
import {
  faceShapeInfo,
  frameRecommendations,
  curatedFrames,
  measurementSteps,
  measurementPrep,
} from '../data/faceShapeQuiz';
import type { FaceShapeId } from '../data/faceShapeQuiz';

const allItems = await getCollection('catalogo');

const catalogForTest = allItems.map((item) => ({
  slug: item.id,
  name: item.data.name,
  brand: item.data.brand,
  price: item.data.price,
  image: item.data.image,
  imageAlt: item.data.name,
  frameShape: getFrameShape(item.data),
  genero: item.data.genero ?? 'unisex',
  overlayImage: getTryOnOverlayImage(item.data.colors[0]?.image || item.data.image),
  overlayImagePhotochromic: getTryOnPhotochromicImage(item.data.colors[0]?.image || item.data.image),
}));

const faceShapeIds = Object.keys(faceShapeInfo) as FaceShapeId[];

/**
 * Reparte los resultados entre las formas recomendadas en vez de agotar la
 * primera (p. ej. "cuadrado" recomienda redonda/ovalada/aviador, pero como hay
 * muchos más aviadores que redondas en el catálogo, tomar los primeros 6 sin
 * más daba solo aviadores). Round-robin por forma: una de cada hasta llenar el
 * cupo, así siempre se ven ejemplos de cada estilo recomendado si existen.
 * `offset` rota el punto de partida de cada forma para que distintos rostros no
 * muestren siempre los mismos primeros productos de cada grupo.
 */
function pickDiverse<T extends { frameShape: FrameShape | null }>(
  items: T[],
  shapes: FrameShape[],
  limit: number,
  offset = 0,
): T[] {
  const buckets = shapes.map((shape) => {
    const bucket = items.filter((item) => item.frameShape === shape);
    const start = bucket.length ? offset % bucket.length : 0;
    return [...bucket.slice(start), ...bucket.slice(0, start)];
  });
  const result: T[] = [];
  let i = 0;
  while (result.length < limit && buckets.some((b) => b.length > 0)) {
    const bucket = buckets[i % buckets.length];
    const next = bucket.shift();
    if (next) result.push(next);
    i++;
  }
  return result;
}

const generoTabs = [
  { value: 'todos', label: 'Todas' },
  { value: 'hombre', label: 'Para hombre' },
  { value: 'mujer', label: 'Para mujer' },
] as const;

// Hombre/mujer incluyen también las monturas unisex.
const faceShapeResults = faceShapeIds.map((shapeId, faceIndex) => {
  const recommended = frameRecommendations[shapeId];
  const curated = curatedFrames[shapeId];
  const candidates = curated
    ? catalogForTest
    : catalogForTest.filter((item) => item.frameShape && recommended.includes(item.frameShape));
  const byGenero = generoTabs.map(({ value }) => {
    const pool = value === 'todos' ? candidates : candidates.filter((c) => c.genero === 'unisex' || c.genero === value);
    return {
      value,
      matches: curated
        ? curated.flatMap((slug) => pool.filter((c) => c.slug === slug))
        : pickDiverse(pool, recommended, pool.length, faceIndex * 3),
    };
  });
  return { shapeId, byGenero };
});
---

<!--
  Test de forma de rostro compartido: cualquier elemento con data-facetest-open
  abre el modal desde el inicio; data-facetest-manual="{forma}" salta directo
  al resultado de esa forma (selección manual, sin cámara ni mediciones).
-->
<div
  class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/60 p-4"
  role="dialog"
  aria-modal="true"
  aria-label="Test de forma de rostro"
  data-facetest-modal
>
  <div class="max-h-[90vh] w-full max-w-2xl overflow-y-auto rounded-2xl bg-white p-6 shadow-xl">
    <div class="mb-4 flex items-start justify-between gap-4">
      <h3 class="text-lg font-bold text-slate-900">Descubre tu forma de rostro</h3>
      <button
        type="button"
        class="rounded-full p-1.5 text-slate-500 transition-colors hover:bg-slate-100 hover:text-slate-900"
        aria-label="Cerrar"
        data-facetest-close
      >
        <Icon name="close" class="h-5 w-5" />
      </button>
    </div>

    <!-- Paso 1: elegir método -->
    <div data-facetest-step="intro">
      <p class="mb-6 text-sm text-slate-600">
        Elige cómo prefieres descubrir tu forma de rostro. Con cualquiera de las dos opciones te recomendamos
        monturas de nuestro catálogo.
      </p>
      <div class="flex flex-col gap-3">
        <button
          type="button"
          class="flex items-center justify-center gap-2 rounded-full border-2 border-slate-900 bg-verde-neon px-6 py-3 font-bold text-slate-900 transition-transform hover:scale-[1.02]"
          data-facetest-start="camera"
        >
          <Icon name="eye" class="h-5 w-5" />
          Hacer el test con cámara
        </button>
        <button
          type="button"
          class="flex items-center justify-center gap-2 rounded-full border-2 border-slate-900 bg-white px-6 py-3 font-bold text-slate-900 transition-colors hover:bg-slate-100"
          data-facetest-start="quiz"
        >
          <Icon name="list" class="h-5 w-5" />
          Medir manual con cinta métrica
        </button>
      </div>
    </div>

    <!-- Paso 1b: preparación animada antes de abrir la cámara -->
