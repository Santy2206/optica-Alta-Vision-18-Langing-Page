              class="flex cursor-pointer items-start gap-2 rounded-xl border border-slate-300 px-3 py-2.5 text-sm text-slate-700 transition-colors has-[:checked]:border-aguamarina has-[:checked]:bg-aguamarina/10"
            >
              <input type="radio" name="jawContour" value="angular" class="mt-0.5 accent-[#00B4B0]" data-measure-jaw />
              <span>
                <span class="font-semibold text-slate-900">Angular / marcada</span>
                <span class="mt-0.5 block text-xs text-slate-500">Esquinas definidas</span>
              </span>
