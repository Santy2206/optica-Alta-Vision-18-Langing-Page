---
// Carrusel de banners del CMS (colección "carrusel"). Va debajo del hero y solo
// se renderiza si hay slides activos. Se desplaza en loop continuo como el
// carrusel de opiniones (la lista va duplicada y traduce -50%).
import { getCollection } from 'astro:content';
import { waLink } from '../utils/whatsapp';
import '../styles/flow.css';

const slides = (await getCollection('carrusel', ({ data }) => data.active)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

{
  slides.length > 0 && (
    <section
      class="fl-bannercar"
      aria-roledescription="carousel"
      aria-label="Promociones destacadas"
    >
      <ul class="fl-bannercar__pista">
        {[...slides, ...slides].map((slide, i) => {
          const dup = i >= slides.length;
          const customLink = slide.data.link?.trim();
          const href =
            customLink ||
            waLink(`carrusel:${slide.id}`, 'Hola, vi el banner en la página y quiero más información');
          const isExternal = href.startsWith('http');
          return (
            <li
              class:list={['fl-bannercar__item', dup && 'fl-bannercar__dup']}
              aria-hidden={dup || undefined}
              inert={dup || undefined}
            >
              <a
                href={href}
                target={isExternal ? '_blank' : undefined}
                rel={isExternal ? 'noopener noreferrer' : undefined}
                data-cta={customLink ? undefined : `carrusel:${slide.id}`}
                class="fl-bannercar__slide"
                aria-label={dup ? undefined : `${slide.data.imageAlt} (banner ${(i % slides.length) + 1} de ${slides.length})`}
                tabindex={dup ? -1 : undefined}
              >
                <img
                  src={slide.data.image}
                  alt={dup ? '' : slide.data.imageAlt}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                  class="fl-bannercar__img"
                />
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  )
}
