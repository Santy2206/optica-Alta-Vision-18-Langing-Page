---
import { waLink } from '../utils/whatsapp';
import Icon from './Icon.astro';

const whatsappHref = waLink('header', 'Hola, quiero agendar un examen visual');

const navLinks = [
  { label: 'Inicio', href: '/' },
  { label: 'Catálogo', href: '/catalogo' },
  { label: 'Nosotros', href: '/nosotros' },
  { label: 'Servicios', href: '/#servicios' },
  { label: 'Ubicación', href: '/#ubicacion' },
];

const path = Astro.url.pathname;
const isActive = (href: string) => href === path || (href !== '/' && path.startsWith(href));
---

<header
  class="sticky top-0 z-50 bg-white transition-shadow"
  data-header
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-2 px-3 py-3 sm:px-4">
    <!-- Logo con dimensiones fijas (sin swap por onload) para evitar layout shift. -->
    <a href="/" class="flex shrink-0 items-center">
      <img src="/logo.webp" alt="Óptica Alta Visión 18 — inicio" width="310" height="96" class="h-10 w-auto md:h-14" />
    </a>

    <nav class="hidden items-center gap-6 lg:flex" aria-label="Navegación principal">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class:list={[
              'text-sm font-medium transition-colors hover:text-aguamarina',
              isActive(link.href) ? 'text-aguamarina' : 'text-slate-900',
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-1 sm:gap-2">
      <a
        href={whatsappHref}
        data-cta="header"
        class="inline-flex items-center gap-1.5 whitespace-nowrap rounded-full border-2 border-slate-900 bg-verde-neon px-3 py-2 text-sm font-semibold text-slate-900 shadow-sm transition-all hover:shadow-md sm:px-4"
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icon name="whatsapp" class="hidden h-4 w-4 sm:block" />
        Agendar examen
      </a>

      <button
        type="button"
        class="inline-flex items-center justify-center rounded-full p-2 text-slate-900 hover:bg-slate-100 lg:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <Icon name="menu" class="h-6 w-6" data-icon-menu />
        <Icon name="close" class="hidden h-6 w-6" data-icon-close />
      </button>
    </div>
  </div>

  <div class="h-[3px] w-full brand-bar" aria-hidden="true"></div>

  <nav
    id="mobile-menu"
    class="hidden flex-col gap-1 border-t border-slate-200 bg-white px-4 py-3 lg:hidden"
    aria-label="Navegación móvil"
    data-mobile-menu
  >
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          aria-current={isActive(link.href) ? 'page' : undefined}
          class:list={[
            'rounded-lg px-3 py-2 text-sm font-medium hover:bg-slate-100',
            isActive(link.href) ? 'text-aguamarina' : 'text-slate-900',
          ]}
          data-mobile-link
        >
          {link.label}
        </a>
      ))
    }
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
  const iconMenu = document.querySelector<HTMLElement>('[data-icon-menu]');
  const iconClose = document.querySelector<HTMLElement>('[data-icon-close]');
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-mobile-link]');

  if (toggle && menu) {
    const closeMenu = () => {
      menu.classList.add('hidden');
      menu.classList.remove('flex');
      toggle.setAttribute('aria-expanded', 'false');
      iconMenu?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    };

    const openMenu = () => {
      menu.classList.remove('hidden');
      menu.classList.add('flex');
      toggle.setAttribute('aria-expanded', 'true');
      iconMenu?.classList.add('hidden');
      iconClose?.classList.remove('hidden');
    };

    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      isOpen ? closeMenu() : openMenu();
    });

    links.forEach((link) => link.addEventListener('click', closeMenu));
  }

  // Sombra suave solo cuando la página está scrolleada (header sobre fondo blanco).
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    const SHADOW = ['shadow-md'];
    const onScroll = () => header.classList.toggle(SHADOW[0], window.scrollY > 4);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
