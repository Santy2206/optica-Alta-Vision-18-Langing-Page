---
import site from '../content/configuracion/site.json';
import Icon from './Icon.astro';

const whatsappHref = `https://wa.me/${site.telefono}?text=${encodeURIComponent('Hola, quiero agendar una cita')}`;

const navLinks = [
  { label: 'Catálogo', href: '#catalogo' },
  { label: 'Servicios', href: '#servicios' },
  { label: 'Ubicación', href: '#ubicacion' },
];
---

<header class="sticky top-0 z-50 bg-aguamarina shadow-sm">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3">
    <!-- Logo: guardar imagen en public/logo.png para activarla; el texto es fallback -->
    <a href="#" class="flex items-center text-lg font-bold text-white tracking-tight">
      <img
        src="/logo.png"
        alt="Alta Visión 18"
        class="hidden h-8 w-auto"
        onload="this.classList.remove('hidden'); this.nextElementSibling.classList.add('hidden');"
        onerror="this.classList.add('hidden'); this.nextElementSibling.classList.remove('hidden');"
      />
      <span class="">Alta Visión 18</span>
    </a>

    <nav class="hidden items-center gap-6 md:flex" aria-label="Navegación principal">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="text-sm font-medium text-white/90 hover:text-white hover:underline underline-offset-4 transition-colors"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <a
      href={whatsappHref}
      class="inline-flex items-center gap-1.5 rounded-full bg-verde-neon px-4 py-2 text-sm font-semibold text-slate-900 shadow-sm hover:shadow-md transition-all"
      target="_blank"
      rel="noopener noreferrer"
    >
      <Icon name="whatsapp" class="h-4 w-4" />
      Agenda tu cita
    </a>
  </div>
</header>
