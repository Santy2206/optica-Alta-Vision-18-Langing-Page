---
import site from '../content/configuracion/site.json';
import Icon from './Icon.astro';

const whatsappHref = `https://wa.me/${site.telefono}?text=${encodeURIComponent('Hola, quiero agendar una cita')}`;

const navLinks = [
  { label: 'Catálogo', href: '#catalogo' },
  { label: 'Servicios', href: '#servicios' },
  { label: 'Ubicación', href: '#ubicacion' },
];
---

<header class="sticky top-0 z-50 bg-aguamarina shadow-sm">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3">
    <!-- Logo: guardar imagen en public/logo.png para activarla; el texto es fallback -->
    <a href="#" class="flex items-center text-lg font-bold text-white tracking-tight">
      <img
        src="/logo.png"
        alt="Alta Visión 18"
        class="hidden h-8 w-auto"
        onload="this.classList.remove('hidden'); this.nextElementSibling.classList.add('hidden');"
        onerror="this.classList.add('hidden'); this.nextElementSibling.classList.remove('hidden');"
      />
      <span class="">Alta Visión 18</span>
    </a>

    <nav class="hidden items-center gap-6 md:flex" aria-label="Navegación principal">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="text-sm font-medium text-white/90 hover:text-white hover:underline underline-offset-4 transition-colors"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={whatsappHref}
        class="inline-flex items-center gap-1.5 rounded-full bg-verde-neon px-4 py-2 text-sm font-semibold text-slate-900 shadow-sm hover:shadow-md transition-all"
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icon name="whatsapp" class="h-4 w-4" />
        Agenda tu cita
      </a>

      <button
        type="button"
        class="inline-flex items-center justify-center rounded-full p-2 text-white hover:bg-white/10 md:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <Icon name="menu" class="h-6 w-6" data-icon-menu />
        <Icon name="close" class="hidden h-6 w-6" data-icon-close />
      </button>
    </div>
  </div>

  <nav
    id="mobile-menu"
    class="hidden flex-col gap-1 border-t border-white/20 bg-aguamarina px-4 py-3 md:hidden"
    aria-label="Navegación móvil"
    data-mobile-menu
  >
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          class="rounded-lg px-3 py-2 text-sm font-medium text-white/90 hover:bg-white/10 hover:text-white"
          data-mobile-link
        >
          {link.label}
        </a>
      ))
    }
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
  const iconMenu = document.querySelector<HTMLElement>('[data-icon-menu]');
  const iconClose = document.querySelector<HTMLElement>('[data-icon-close]');
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-mobile-link]');

  if (toggle && menu) {
    const closeMenu = () => {
      menu.classList.add('hidden');
      menu.classList.remove('flex');
      toggle.setAttribute('aria-expanded', 'false');
      iconMenu?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    };

    const openMenu = () => {
      menu.classList.remove('hidden');
      menu.classList.add('flex');
      toggle.setAttribute('aria-expanded', 'true');
      iconMenu?.classList.add('hidden');
      iconClose?.classList.remove('hidden');
    };

    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      isOpen ? closeMenu() : openMenu();
    });

    links.forEach((link) => link.addEventListener('click', closeMenu));
  }
</script>
