---
import { getCollection } from 'astro:content';
import site from '../utils/site';
import { waLink } from '../utils/whatsapp';
import Icon from './Icon.astro';

const whatsappHref = waLink('hero', 'Hola, quiero agendar mi examen visual');

// CTA secundario: abre el probador (TryOnModal) con la primera montura destacada que tenga SKU.
// Si no hay ninguna, el botón hace scroll al catálogo.
const catalogo = await getCollection('catalogo');
const tryOnItem = catalogo
  .filter((item) => item.data.featured)
  .map((item) => ({ item, color: item.data.colors[0], sku: item.data.tryOnSku ?? item.data.colors[0]?.tryOnSku }))
  .find(({ sku }) => Boolean(sku));

const microConfianza = ['Garantía de fábrica', 'Tarjeta y transferencia', site.horario].filter(Boolean);
const hasImage = Boolean(site.heroImagen);

const secondaryClass =
  'inline-flex items-center justify-center gap-2 rounded-full border-2 border-white px-6 py-3 font-semibold text-white transition-colors hover:bg-white hover:text-aguamarina';
---

<section class="bg-aguamarina py-14 md:py-20">
  <div
    class:list={[
      'mx-auto px-4',
      hasImage ? 'grid max-w-6xl items-center gap-10 md:grid-cols-2 md:gap-12' : 'max-w-3xl text-center',
    ]}
  >
    <div class="space-y-6">
      <h1 class="font-display text-3xl font-extrabold leading-tight text-white md:text-5xl">
        {site.hero.titulo}
      </h1>

      <p class="text-lg text-white/90 md:text-xl">{site.hero.subtitulo}</p>

      <div class:list={['flex flex-col gap-3 sm:flex-row', !hasImage && 'sm:justify-center']}>
        <a
          href={whatsappHref}
          data-cta="hero"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 rounded-full bg-verde-neon px-6 py-3 font-semibold text-slate-900 shadow-sm transition-all hover:shadow-md"
        >
          <Icon name="whatsapp" class="h-5 w-5" />
          Agendar mi examen por WhatsApp
        </a>

        {
          tryOnItem ? (
            <button
              type="button"
              class={secondaryClass}
              data-tryon-open
              data-slug={tryOnItem.item.id}
              data-sku={tryOnItem.sku}
              data-name={tryOnItem.item.data.name}
              data-frame={tryOnItem.color?.name ?? ''}
              data-lenses={JSON.stringify(tryOnItem.color?.lenses ?? [])}
            >
              <Icon name="eye" class="h-5 w-5" />
              Pruébate gafas con tu cámara
            </button>
          ) : (
            <a href="#catalogo" class={secondaryClass}>
              <Icon name="eye" class="h-5 w-5" />
              Pruébate gafas con tu cámara
            </a>
          )
        }
      </div>

      <ul
        class:list={[
          'flex flex-wrap items-center gap-x-4 gap-y-1 text-sm font-medium text-white',
          !hasImage && 'justify-center',
        ]}
        aria-label="Garantías y formas de pago"
      >
        {
          microConfianza.map((texto) => (
            <li class="flex items-center gap-1.5">
              <Icon name="check" class="h-4 w-4 shrink-0" />
              {texto}
            </li>
          ))
        }
      </ul>
    </div>

    {
      hasImage && (
        <img
          src={site.heroImagen}
          alt="Local de Óptica Alta Visión 18"
          width="1200"
          height="900"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="aspect-[4/3] w-full rounded-2xl object-cover shadow-lg"
        />
      )
    }
  </div>
</section>
