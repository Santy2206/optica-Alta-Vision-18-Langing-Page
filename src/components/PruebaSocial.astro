---
// Prueba social. Se renderiza solo si hay al menos un dato real: reseñas, testimonios,
// cifras (años/clientes) u optómetra. La garantía de fábrica quedó solo en la FAQ.
import { getCollection } from 'astro:content';
import site from '../utils/site';
import Icon from './Icon.astro';

const testimonios = (await getCollection('testimonios', ({ data }) => data.active)).sort(
  (a, b) => a.data.order - b.data.order,
);
const { rating, total, url: reviewsUrl } = site.googleReviews;
const { nombre, cargo } = site.optometra;

const fmtRating = (n: number) => n.toLocaleString('es-CO', { minimumFractionDigits: 1, maximumFractionDigits: 1 });

/** Iniciales del nombre para avatar (máx. 2 letras). No scrapea fotos de Google. */
const initials = (fullName: string) =>
  fullName
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((w) => w[0]?.toUpperCase() ?? '')
    .join('');

const cifras = [
  site.aniosExperiencia !== null && {
    valor: site.aniosExperiencia.toLocaleString('es-CO'),
    label: 'años de experiencia',
  },
  site.clientesAtendidos !== null && {
    valor: `+${site.clientesAtendidos.toLocaleString('es-CO')}`,
    label: 'clientes atendidos',
  },
].filter((c): c is { valor: string; label: string } => Boolean(c));

const show = rating !== null || testimonios.length > 0 || cifras.length > 0 || Boolean(nombre);
---

{
  show && (
    <section id="opiniones" class="bg-white py-16 md:py-24">
      <div class="mx-auto max-w-6xl px-4">
        <h2 class="mb-10 text-center text-2xl font-bold text-slate-900 md:text-3xl">
          {testimonios.length > 0
            ? 'Lo que dicen nuestros clientes'
            : rating !== null
              ? `${fmtRating(rating)} estrellas en Google`
              : 'Por qué elegirnos'}
        </h2>

        <div
          class:list={[
            'gap-8',
            testimonios.length > 0 ? 'grid md:grid-cols-[minmax(0,18rem)_1fr] md:items-stretch' : 'mx-auto max-w-sm',
          ]}
        >
          {
            (rating !== null || cifras.length > 0 || Boolean(nombre) || testimonios.length === 0) && (
              <div class="flex flex-col items-center justify-center gap-2 rounded-2xl border border-aguamarina/20 bg-brand-tint p-8 text-center">
                {rating !== null ? (
                  <>
                    <span class="font-display text-5xl font-extrabold text-slate-900">
                      {fmtRating(rating)}
                      <span class="sr-only"> de 5 estrellas</span>
                    </span>
                    <span class="flex gap-0.5 text-amber-500" aria-hidden="true">
                      {Array.from({ length: 5 }, (_, i) => (
                        <Icon name="star" filled class={i < Math.round(rating) ? 'h-5 w-5' : 'h-5 w-5 opacity-30'} />
                      ))}
                    </span>
                    <p class="text-sm text-slate-600">
                      {total !== null ? `${total.toLocaleString('es-CO')} reseñas en Google` : 'Calificación en Google'}
                    </p>
                    {reviewsUrl && (
                      <a
                        href={reviewsUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="mt-1 text-sm font-semibold text-slate-900 underline underline-offset-4 hover:text-fucsia"
                      >
                        Ver en Google
                      </a>
                    )}
                  </>
                ) : (
                  <p class="text-base font-semibold text-slate-900">Garantía de fábrica en todas las monturas</p>
                )}

                {cifras.length > 0 && (
                  <dl class="mt-4 flex w-full justify-center gap-8 border-t border-slate-200 pt-4">
                    {cifras.map((c) => (
                      <div class="flex flex-col-reverse items-center">
                        <dt class="text-xs font-medium text-slate-600">{c.label}</dt>
                        <dd class="font-display text-2xl font-extrabold text-slate-900">{c.valor}</dd>
                      </div>
                    ))}
                  </dl>
                )}

                {nombre && (
                  <p class="mt-3 text-sm text-slate-700">
                    Atendido por <strong class="text-slate-900">{nombre}</strong>
                    {cargo && `, ${cargo}`}
                  </p>
                )}
              </div>
            )
          }

          {
            testimonios.length > 0 && (
              <div
                class="relative min-w-0"
                aria-roledescription="carousel"
                aria-label="Opiniones de clientes"
                data-reviews-carousel
              >
                <div class="relative overflow-hidden">
                  <ul class="flex transition-transform duration-500 ease-out" data-reviews-track>
                    {testimonios.map(({ data }, i) => (
                      <li
                        class="w-full shrink-0 px-1 sm:w-1/2 sm:px-2 lg:w-1/3"
                        role="group"
                        aria-roledescription="slide"
                        aria-label={`${i + 1} de ${testimonios.length}`}
                        data-reviews-slide
                      >
                        <article class="flex h-full min-h-[14rem] flex-col gap-4 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                          <span
                            class="flex gap-0.5 text-amber-500"
                            role="img"
                            aria-label={`${data.estrellas} de 5 estrellas`}
                          >
                            {Array.from({ length: 5 }, (_, j) => (
                              <Icon
                                name="star"
                                filled
                                class={j < data.estrellas ? 'h-4 w-4' : 'h-4 w-4 opacity-30'}
                              />
                            ))}
                          </span>
                          <blockquote class="flex-1 text-sm leading-relaxed text-slate-700">
                            “{data.texto}”
                          </blockquote>
                          <div class="flex items-center gap-3 border-t border-slate-100 pt-3">
                            {data.foto ? (
                              <img
                                src={data.foto}
                                alt=""
                                width="40"
                                height="40"
                                loading="lazy"
                                class="h-10 w-10 shrink-0 rounded-full object-cover"
                              />
                            ) : (
                              <span
                                class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-aguamarina text-sm font-bold text-white"
                                aria-hidden="true"
                              >
                                {initials(data.nombre)}
                              </span>
                            )}
                            <div class="min-w-0">
                              <p class="truncate text-sm font-semibold text-slate-900">{data.nombre}</p>
                              {
                                (data.url || reviewsUrl) && (
                                  <a
                                    href={data.url ?? reviewsUrl!}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="mt-0.5 inline-flex items-center gap-1 text-xs font-medium text-slate-500 hover:text-aguamarina hover:underline"
                                  >
                                    <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" aria-hidden="true">
                                      <path
                                        fill="#4285F4"
                                        d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1Z"
                                      />
                                      <path
                                        fill="#34A853"
                                        d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23Z"
                                      />
                                      <path
                                        fill="#FBBC05"
                                        d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62Z"
                                      />
                                      <path
                                        fill="#EA4335"
                                        d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53Z"
                                      />
                                    </svg>
                                    Ver en Google
                                  </a>
                                )
                              }
                            </div>
                          </div>
                        </article>
                      </li>
                    ))}
                  </ul>
                </div>

                {testimonios.length > 1 && (
                  <div class="mt-5 flex items-center justify-center gap-3">
                    <button
                      type="button"
                      class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-slate-200 bg-white text-slate-700 shadow-sm transition-colors hover:border-aguamarina hover:text-aguamarina"
                      aria-label="Comentario anterior"
                      data-reviews-prev
                    >
                      <Icon name="chevron-left" class="h-5 w-5" />
                    </button>

                    <div class="flex gap-2" role="tablist" aria-label="Seleccionar comentario">
                      {testimonios.map((_, i) => (
                        <button
                          type="button"
                          class:list={[
                            'h-2.5 w-2.5 rounded-full transition-colors',
                            i === 0 ? 'bg-aguamarina' : 'bg-slate-300',
                          ]}
                          role="tab"
                          aria-label={`Ver comentario ${i + 1}`}
                          aria-selected={i === 0 ? 'true' : 'false'}
                          data-reviews-dot
                        />
                      ))}
                    </div>

                    <button
                      type="button"
                      class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-slate-200 bg-white text-slate-700 shadow-sm transition-colors hover:border-aguamarina hover:text-aguamarina"
                      aria-label="Siguiente comentario"
                      data-reviews-next
                    >
                      <Icon name="chevron-right" class="h-5 w-5" />
                    </button>
                  </div>
                )}
              </div>
            )
          }
        </div>
      </div>
    </section>
  )
}

<script>
  const root = document.querySelector<HTMLElement>('[data-reviews-carousel]');
  if (root) {
    const track = root.querySelector<HTMLElement>('[data-reviews-track]');
    const slides = root.querySelectorAll<HTMLElement>('[data-reviews-slide]');
    const dots = root.querySelectorAll<HTMLButtonElement>('[data-reviews-dot]');
    const prev = root.querySelector<HTMLButtonElement>('[data-reviews-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-reviews-next]');

    if (track && slides.length > 1) {
      let index = 0;
      let timer: ReturnType<typeof setInterval> | undefined;
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const perView = () => {
        if (window.matchMedia('(min-width: 1024px)').matches) return 3;
        if (window.matchMedia('(min-width: 640px)').matches) return 2;
        return 1;
      };

      const maxIndex = () => Math.max(0, slides.length - perView());

      const paintDots = () => {
        dots.forEach((dot, i) => {
          const active = i === index;
          dot.classList.toggle('bg-aguamarina', active);
          dot.classList.toggle('bg-slate-300', !active);
          dot.setAttribute('aria-selected', active ? 'true' : 'false');
        });
      };

      const goTo = (nextIndex: number) => {
        const max = maxIndex();
        index = ((nextIndex % (max + 1)) + (max + 1)) % (max + 1);
        const step = 100 / perView();
        track.style.transform = `translateX(-${index * step}%)`;
        paintDots();
      };

      const stop = () => {
        if (timer) clearInterval(timer);
      };

      const start = () => {
        if (prefersReducedMotion) return;
        stop();
        timer = setInterval(() => goTo(index + 1), 5500);
      };

      prev?.addEventListener('click', () => {
        goTo(index - 1);
        start();
      });
      next?.addEventListener('click', () => {
        goTo(index + 1);
        start();
      });
      dots.forEach((dot, i) => {
        dot.addEventListener('click', () => {
          goTo(Math.min(i, maxIndex()));
          start();
        });
      });

      root.addEventListener('mouseenter', stop);
      root.addEventListener('mouseleave', start);
      root.addEventListener('focusin', stop);
      root.addEventListener('focusout', start);
      window.addEventListener('resize', () => goTo(Math.min(index, maxIndex())));

      goTo(0);
      start();
    }
  }
</script>
