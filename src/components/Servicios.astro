---
import Icon from './Icon.astro';
import { waLink } from '../utils/whatsapp';

const services = [
  {
    icon: 'eye',
    title: 'Examen de optometría',
    description: 'Evaluación de agudeza visual y graduación con equipo especializado.',
  },
  {
    icon: 'wrench',
    title: 'Mantenimiento',
    description: 'Ajustes, cambio de tornillos, soldadura básica y limpieza profesional.',
  },
  {
    icon: 'shield',
    title: 'Garantías',
    description: 'Aseguramos tus gafas por defectos de fábrica con acompañamiento.',
  },
] as const;
---

<section id="servicios" class="bg-white py-16 md:py-24">
  <div class="mx-auto max-w-6xl px-4">
    <h2 class="mb-3 text-center text-2xl font-bold text-slate-900 md:text-3xl">
      Nuestros servicios
    </h2>
    <p class="mx-auto mb-10 max-w-xl text-center text-sm text-slate-600 md:text-base">
      Examen visual, mantenimiento y garantía en cada montura — con atención cercana de principio a fin.
    </p>

    <ul class="grid gap-8 sm:grid-cols-3">
      {
        services.map((service) => (
          <li class="flex flex-col items-center text-center">
            <span class="mb-3 flex h-16 w-16 items-center justify-center rounded-full bg-aguamarina text-white shadow-sm">
              <Icon name={service.icon} class="h-7 w-7" />
            </span>
            <h3 class="text-base font-semibold text-slate-900">{service.title}</h3>
            <p class="mt-1 max-w-xs text-sm text-slate-600">{service.description}</p>
          </li>
        ))
      }
    </ul>

    <div class="mt-10 text-center">
      <a
        href={waLink('servicios', 'Hola, quiero agendar un examen de optometría')}
        data-cta="servicios"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-full bg-verde-neon px-6 py-3 font-semibold text-slate-900 shadow-sm transition-all hover:shadow-md"
      >
        <Icon name="whatsapp" class="h-5 w-5" />
        Agendar examen de optometría
      </a>
    </div>
  </div>
</section>
