---
import Icon from './Icon.astro';

const services = [
  {
    icon: 'eye',
    title: 'Examen de optometría',
    description: 'Evaluación de agudeza visual y graduación con equipo especializado.',
  },
  {
    icon: 'layers',
    title: 'Lentes blandos',
    description: 'Venta y asesoría de lentes de contacto blandos según tu fórmula y estilo de vida.',
  },
  {
    icon: 'check',
    title: 'Kit de cuidado',
    description: 'Con tu compra recibes limpiador, estuche y pañuelo para cuidar tus gafas desde el primer día.',
  },
  {
    icon: 'wrench',
    title: 'Mantenimiento',
    description: 'Ajustes, cambio de tornillos, soldadura básica y limpieza profesional.',
  },
  {
    icon: 'shield',
    title: 'Garantías',
    description: 'Aseguramos tus gafas por defectos de fábrica con acompañamiento.',
  },
] as const;
---

<section id="servicios" class="relative overflow-hidden bg-white py-16 md:py-24">
  <svg
    class="pointer-events-none absolute -bottom-24 -right-20 hidden h-80 w-80 text-aguamarina/10 md:block"
    viewBox="0 0 200 200"
    aria-hidden="true"
  >
    <path
      fill="currentColor"
      d="M45.3,-58.8C58.6,-49.5,68.7,-34.8,72.9,-18.5C77.1,-2.3,75.4,15.6,67.5,30.2C59.6,44.8,45.5,56.2,29.8,63.6C14.1,71,-3.2,74.4,-19.6,71.1C-36,67.8,-51.5,57.7,-61.8,43.5C-72.1,29.2,-77.2,10.7,-74.8,-6.4C-72.4,-23.6,-62.5,-39.4,-49,-49C-35.5,-58.6,-18.5,-62,-0.8,-60.8C16.9,-59.6,33.9,-53.8,45.3,-58.8Z"
      transform="translate(100 100)"
    />
  </svg>

  <div class="relative mx-auto max-w-6xl px-4">
    <p class="mb-2 text-center text-sm font-bold uppercase tracking-wide text-fucsia">Lo que ofrecemos</p>
    <h2 class="mb-3 text-center text-2xl font-bold text-slate-900 md:text-3xl">
      Nuestros servicios
    </h2>
    <p class="mx-auto mb-10 max-w-xl text-center text-sm text-slate-600 md:text-base">
      Examen visual, lentes blandos, kit de cuidado, mantenimiento y garantía — con atención cercana de principio a fin.
    </p>

    <ul class="grid gap-8 sm:grid-cols-2 lg:grid-cols-5">
      {
        services.map((service, i) => (
          <li class="flex flex-col items-center text-center">
            <span
              class:list={[
                'mb-3 flex h-16 w-16 items-center justify-center rounded-full text-white shadow-sm',
                i % 2 === 0 ? 'bg-aguamarina' : 'bg-fucsia',
              ]}
            >
              <Icon name={service.icon} class="h-7 w-7" />
            </span>
            <h3 class="text-base font-semibold text-slate-900">{service.title}</h3>
            <p class="mt-1 max-w-xs text-sm text-slate-600">{service.description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
