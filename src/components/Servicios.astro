---
import Icon from './Icon.astro';
import site from '../content/configuracion/site.json';

const whatsappHref = `https://wa.me/${site.telefono}?text=${encodeURIComponent('Hola, quiero agendar una cita')}`;

const services = [
  {
    icon: 'eye',
    title: 'Examen de optometría',
    description: 'Evaluación de agudeza visual y graduación con equipo especializado.',
  },
  {
    icon: 'wrench',
    title: 'Mantenimiento',
    description: 'Ajustes, cambio de tornillos, soldadura básica y limpieza profesional.',
  },
  {
    icon: 'shield',
    title: 'Garantías',
    description: 'Aseguramos tus gafas por defectos de fábrica con acompañamiento.',
  },
  {
    icon: 'whatsapp',
    title: 'Agenda por WhatsApp',
    description: 'Escríbenos y te confirmamos tu cita el mismo día.',
    href: whatsappHref,
  },
  {
    icon: 'clock',
    title: site.horario,
    description: 'Horario de atención en el local.',
  },
] as const;
---

<section id="servicios" class="bg-white py-16 md:py-24">
  <div class="mx-auto max-w-6xl px-4">
    <h2 class="mb-3 text-center text-2xl font-bold text-slate-900 md:text-3xl">
      Nuestros servicios
    </h2>
    <p class="mx-auto mb-10 max-w-xl text-center text-sm text-slate-600 md:text-base">
      Examen visual, mantenimiento y garantía en cada montura — con atención cercana de principio a fin.
    </p>

    <div class="flex flex-wrap items-start justify-center gap-x-8 gap-y-8 sm:gap-x-12">
      {
        services.map((service) => {
          const badge = (
            <>
              <span class="mb-2 flex h-16 w-16 items-center justify-center rounded-full bg-aguamarina text-white shadow-sm transition-transform group-hover:scale-105">
                <Icon name={service.icon} class="h-7 w-7" />
              </span>
              <span class="max-w-[7rem] text-center text-xs font-semibold text-slate-800 sm:text-sm">
                {service.title}
              </span>
            </>
          );

          return service.href ? (
            <a
              href={service.href}
              target="_blank"
              rel="noopener noreferrer"
              title={service.description}
              class="group flex flex-col items-center"
            >
              {badge}
            </a>
          ) : (
            <div title={service.description} class="group flex flex-col items-center">
              {badge}
            </div>
          );
        })
      }
    </div>
  </div>
</section>
