---
import Icon from './Icon.astro';
import site from '../utils/site';
import { waLink } from '../utils/whatsapp';

const whatsappHref = waLink('confianza', 'Hola, quiero agendar un examen visual');

// Cifras solo con datos reales del CMS (Configuración).
const cifras = [
  site.aniosExperiencia !== null && { valor: site.aniosExperiencia.toLocaleString('es-CO'), label: 'años de experiencia' },
  site.clientesAtendidos !== null && {
    valor: `+${site.clientesAtendidos.toLocaleString('es-CO')}`,
    label: 'clientes atendidos',
  },
].filter((c): c is { valor: string; label: string } => Boolean(c));

const { nombre, cargo } = site.optometra;

const trustBadges = [
  { icon: 'whatsapp', label: 'Agenda por WhatsApp', href: whatsappHref },
  { icon: 'clock', label: site.horario },
  { icon: 'check', label: 'Efectivo, tarjeta o transferencia' },
] as const;
---

<section class="bg-slate-50 py-16 md:py-24">
  <div class="mx-auto max-w-6xl px-4">
    <h2 class="mb-8 text-center text-2xl font-bold text-slate-900 md:text-3xl">
      Por qué elegirnos
    </h2>

    {
      cifras.length > 0 && (
        <dl class="mb-8 flex flex-wrap justify-center gap-x-16 gap-y-6 text-center">
          {cifras.map((c) => (
            <div class="flex flex-col-reverse">
              <dt class="text-sm font-medium text-slate-600">{c.label}</dt>
              <dd class="font-display text-4xl font-extrabold text-slate-900 md:text-5xl">{c.valor}</dd>
            </div>
          ))}
        </dl>
      )
    }

    {
      nombre && (
        <p class="mb-8 text-center text-base text-slate-700">
          Atendido por <strong class="text-slate-900">{nombre}</strong>
          {cargo && `, ${cargo}`}
        </p>
      )
    }

    <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
      <div class="col-span-2 flex flex-col justify-center rounded-2xl bg-aguamarina p-5 text-slate-900 lg:col-span-1">
        <span class="mb-2 flex h-9 w-9 items-center justify-center rounded-full bg-white/40">
          <Icon name="shield" class="h-4 w-4" />
        </span>
        <p class="text-base font-bold leading-snug">Garantía de fábrica</p>
        <p class="text-sm">en todas las monturas</p>
      </div>

      {
        trustBadges.map((badge) => {
          const content = (
            <>
              <span class="mb-2 flex h-9 w-9 items-center justify-center rounded-full bg-white text-aguamarina shadow-sm">
                <Icon name={badge.icon} class="h-4 w-4" />
              </span>
              <p class="text-sm font-bold leading-snug text-slate-900">{badge.label}</p>
            </>
          );

          return 'href' in badge ? (
            <a
              href={badge.href}
              data-cta="confianza"
              target="_blank"
              rel="noopener noreferrer"
              class="flex flex-col justify-center rounded-2xl bg-white p-5 shadow-sm transition-shadow hover:shadow-md"
            >
              {content}
            </a>
          ) : (
            <div class="flex flex-col justify-center rounded-2xl bg-white p-5 shadow-sm">
              {content}
            </div>
          );
        })
      }
    </div>
  </div>
</section>
