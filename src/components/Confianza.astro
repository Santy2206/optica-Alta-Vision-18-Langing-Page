---
import Icon from './Icon.astro';

// TODO: cuando el cliente confirme cifras reales (años de experiencia, clientes atendidos),
// se pueden reintroducir como stats numéricos. Mientras tanto usamos hechos ya validados
// (ver FAQ.astro) en vez de placeholders inventados.
const trustPoints: { icon: 'shield' | 'eye' | 'check'; text: string }[] = [
  { icon: 'shield', text: 'Garantía por defectos de fábrica en todas las monturas' },
  { icon: 'eye', text: 'Atención personalizada en cada examen de optometría' },
  { icon: 'check', text: 'Pago en efectivo, tarjeta o transferencia' },
];
---

<section class="bg-slate-50 py-16 md:py-24">
  <div class="mx-auto max-w-6xl px-4">
    <div class="grid items-center gap-10 md:grid-cols-2">
      <!-- Trust points -->
      <div class="space-y-4">
        {
          trustPoints.map((point) => (
            <div class="flex items-center gap-3 rounded-2xl border border-slate-200 bg-white p-4">
              <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-aguamarina text-white">
                <Icon name={point.icon} class="h-5 w-5" />
              </span>
              <p class="text-sm font-medium text-slate-700">{point.text}</p>
            </div>
          ))
        }
      </div>

      <!-- Reseñas placeholder -->
      <div class="rounded-2xl border border-slate-200 bg-white p-6 text-center">
        <h3 class="mb-3 text-lg font-semibold text-slate-900">Lo que dicen nuestros clientes</h3>
        <p class="mb-4 text-sm text-slate-600">
          Reseñas de Google — pendiente vincular Google Business Profile
        </p>
        <!--
          TODO sesión 11_Lanzamiento:
          Reemplazar este placeholder con widget de reseñas reales.
          Opciones: Elfsight, SociableKIT o iframe del Place ID de GBP.
          Ejemplo Place ID placeholder (reemplazar cuando exista GBP):
          <iframe src="https://www.google.com/maps/embed?pb=!1m18..." loading="lazy"></iframe>
        -->
        <span class="inline-flex items-center gap-2 rounded-full bg-fucsia/10 px-3 py-1 text-xs font-semibold text-slate-900">
          <Icon name="star" class="h-3.5 w-3.5" />
          Reseñas pendientes
        </span>
      </div>
    </div>
  </div>
</section>
