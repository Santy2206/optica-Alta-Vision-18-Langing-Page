---
import Icon from './Icon.astro';
import site from '../content/configuracion/site.json';

const whatsappHref = `https://wa.me/${site.telefono}?text=${encodeURIComponent('Hola, quiero agendar una cita')}`;

// TODO: cuando el cliente confirme cifras reales (años de experiencia, clientes atendidos,
// reseñas de Google), reemplazar el badge de reseñas por datos reales. Mientras tanto
// usamos hechos ya validados en vez de placeholders inventados.
const trustBadges = [
  { icon: 'whatsapp', label: 'Agenda por WhatsApp', href: whatsappHref },
  { icon: 'clock', label: site.horario },
  { icon: 'check', label: 'Efectivo, tarjeta o transferencia' },
  { icon: 'star', label: 'Reseñas de Google — próximamente' },
] as const;
---

<section class="bg-slate-50 py-16 md:py-24">
  <div class="mx-auto max-w-6xl px-4">
    <h2 class="mb-8 text-center text-2xl font-bold text-slate-900 md:text-3xl">
      Por qué elegirnos
    </h2>

    <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
      <div class="col-span-2 flex flex-col justify-center rounded-2xl bg-aguamarina p-5 text-white sm:col-span-1">
        <span class="mb-2 flex h-9 w-9 items-center justify-center rounded-full bg-white/15">
          <Icon name="shield" class="h-4 w-4" />
        </span>
        <p class="text-base font-bold leading-snug">Garantía de fábrica</p>
        <p class="text-sm text-white/80">en todas las monturas</p>
      </div>

      {
        trustBadges.map((badge) => {
          const content = (
            <>
              <span class="mb-2 flex h-9 w-9 items-center justify-center rounded-full bg-white text-aguamarina shadow-sm">
                <Icon name={badge.icon} class="h-4 w-4" />
              </span>
              <p class="text-sm font-bold leading-snug text-slate-900">{badge.label}</p>
            </>
          );

          return badge.href ? (
            <a
              href={badge.href}
              target="_blank"
              rel="noopener noreferrer"
              class="flex flex-col justify-center rounded-2xl bg-white p-5 shadow-sm transition-shadow hover:shadow-md"
            >
              {content}
            </a>
          ) : (
            <div class="flex flex-col justify-center rounded-2xl bg-white p-5 shadow-sm">
              {content}
            </div>
          );
        })
      }
    </div>
  </div>
</section>
