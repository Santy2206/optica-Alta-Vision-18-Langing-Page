---
import { getCollection } from 'astro:content';
import { waLink } from '../utils/whatsapp';
import '../styles/flow.css';

const promos = await getCollection('promociones', ({ data }) => data.active === true);
---

{
  promos.length > 0 && (
    <section class="fl-sec fl-sec--tenue" aria-label="Promociones activas">
      <div class="fl-glow fl-glow--cian" style="top:-30vmax;left:-25vmax" aria-hidden="true" />
      <div class="fl-sec__inner">
        {promos.map((item) => {
          const origen = `promo:${item.id}`;
          const waHref = waLink(origen, `Hola, quiero aprovechar la promoción: ${item.data.title}`);

          return (
            <article class="fl-card fl-promo fl-reveal">
              <div>
                <span class="fl-promo__badge">Promoción</span>
                <h2 class="fl-promo__titulo">{item.data.title}</h2>
                <p class="fl-promo__texto">{item.data.description}</p>
                <a
                  href={waHref}
                  data-cta={origen}
                  class="fl-btn fl-btn--lima fl-promo__cta"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {item.data.ctaText}
                </a>
              </div>

              {item.data.image && item.data.image.trim() !== '' && (
                <div class="fl-promo__imgwrap">
                  <img
                    src={item.data.image}
                    alt={item.data.title}
                    loading="lazy"
                    class="fl-promo__img"
                  />
                </div>
              )}
            </article>
          );
        })}
      </div>
    </section>
  )
}
