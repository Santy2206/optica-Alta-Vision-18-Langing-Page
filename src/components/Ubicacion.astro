---
import site from '../utils/site';
import Icon from './Icon.astro';

// Formato legible del teléfono colombiano 573118812747 → +57 311 881 2747
const raw = site.telefono;
const formatted = raw.startsWith('57')
  ? `+57 ${raw.slice(2, 5)} ${raw.slice(5, 8)} ${raw.slice(8)}`
  : raw;
---

<section id="ubicacion" class="bg-brand-tint py-16 md:py-24">
  <div class="mx-auto max-w-6xl px-4">
    <div class:list={['grid items-start gap-10', site.googleMapsEmbedUrl && 'lg:grid-cols-2']}>
      <div class="space-y-6">
        <div>
          <h2 class="text-2xl font-bold text-slate-900 md:text-3xl">Encuéntranos</h2>
          <p class="mt-1 text-lg font-semibold text-slate-700">Alta Visión 18</p>
        </div>

        <div class="space-y-3">
          {site.direccion && (
            <div class="flex items-start gap-3 rounded-2xl border border-aguamarina/20 bg-white p-4">
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-aguamarina text-white">
                <Icon name="location" class="h-4 w-4" />
              </span>
              <p class="pt-1.5 text-sm text-slate-700 md:text-base">{site.direccion}</p>
            </div>
          )}

          {site.horario && (
            <div class="flex items-start gap-3 rounded-2xl border border-aguamarina/20 bg-white p-4">
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-aguamarina text-white">
                <Icon name="clock" class="h-4 w-4" />
              </span>
              <p class="pt-1.5 text-sm text-slate-700 md:text-base">{site.horario}</p>
            </div>
          )}

          <a
            href={`tel:+${site.telefono}`}
            class="flex items-center gap-3 rounded-2xl border border-aguamarina/20 bg-white p-4 transition-shadow hover:shadow-md"
          >
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-aguamarina text-white">
              <Icon name="phone" class="h-4 w-4" />
            </span>
            <p class="text-sm font-medium text-slate-900 md:text-base">{formatted}</p>
          </a>
        </div>


      </div>

      {
        site.googleMapsEmbedUrl && (
          <div class="rounded-2xl border border-aguamarina/20 bg-white p-2 shadow-sm">
            <iframe
              src={site.googleMapsEmbedUrl}
              title="Ubicación de Alta Visión 18"
              width="100%"
              height="350"
              style="border:0;"
              loading="lazy"
              allowfullscreen
              referrerpolicy="no-referrer-when-downgrade"
              class="rounded-xl"
            />
          </div>
        )
      }
    </div>
  </div>
</section>
