---
import site from '../content/configuracion/site.json';

// Formato legible del teléfono colombiano 573118812747 → +57 311 881 2747
const raw = site.telefono;
const formatted = raw.startsWith('57')
  ? `+57 ${raw.slice(2, 5)} ${raw.slice(5, 8)} ${raw.slice(8)}`
  : raw;
---

<section id="ubicacion" class="bg-aguamarina/10 py-16 md:py-24">
  <div class="mx-auto max-w-6xl px-4">
    <div class="grid items-start gap-10 lg:grid-cols-2">
      <div class="space-y-6">
        <h2 class="text-2xl font-bold text-slate-900 md:text-3xl">Encuéntranos</h2>

        <div class="space-y-3 text-slate-700">
          <p class="text-lg font-semibold text-aguamarina">Alta Visión 18</p>
          <p>{site.direccion}</p>
          <p>
            <span class="font-medium">Horario:</span>
            {site.horario}
          </p>
          <p>
            <span class="font-medium">Teléfono:</span>
            <a href={`tel:+${site.telefono}`} class="text-aguamarina hover:underline">
              {formatted}
            </a>
          </p>
        </div>
      </div>

      <div class="rounded-2xl border border-aguamarina/20 bg-white p-2 shadow-sm">
        {
          site.googleMapsEmbedUrl ? (
            <iframe
              src={site.googleMapsEmbedUrl}
              title="Ubicación de Alta Visión 18"
              width="100%"
              height="350"
              style="border:0;"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              class="rounded-xl"
            />
          ) : (
            <div class="flex aspect-[4/3] w-full items-center justify-center rounded-xl bg-slate-100 text-slate-500">
              <span>Mapa disponible próximamente</span>
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>
