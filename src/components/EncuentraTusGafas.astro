---
// Fusión de TiposRostro + TiposMarco: el test de rostro es el protagonista;
// las formas de rostro son accesos rápidos al resultado (data-facetest-manual).
import Icon from './Icon.astro';

const formas = [
  { id: 'ovalado', imagen: '/images/rostros/ovalado.svg', label: 'Ovalado' },
  { id: 'redondo', imagen: '/images/rostros/redondo.svg', label: 'Redondo' },
  { id: 'cuadrado', imagen: '/images/rostros/cuadrado.svg', label: 'Cuadrado' },
  { id: 'corazon', imagen: '/images/rostros/corazon.svg', label: 'Corazón' },
  { id: 'diamante', imagen: '/images/rostros/diamante.svg', label: 'Diamante' },
] as const;
---

<section id="encuentra-tus-gafas" class="bg-aguamarina/5 py-16 md:py-24">
  <div class="mx-auto max-w-4xl px-4 text-center">
    <h2 class="text-2xl font-bold text-slate-900 md:text-3xl">Encuentra las gafas que te favorecen</h2>
    <p class="mx-auto mt-3 max-w-xl text-sm text-slate-600 md:text-base">
      Descubre tu forma de rostro y te mostramos las monturas que mejor te quedan.
    </p>

    <button
      type="button"
      data-facetest-open
      class="mt-8 inline-flex items-center gap-2 rounded-full bg-slate-900 px-7 py-3.5 text-base font-semibold text-white shadow-sm transition-opacity hover:opacity-90"
    >
      <Icon name="eye" class="h-5 w-5" />
      Haz el test de rostro (1 minuto)
    </button>

    <p class="mb-5 mt-10 text-sm font-semibold text-slate-700">¿Ya conoces tu forma de rostro? Elígela:</p>

    <ul class="grid grid-cols-3 gap-4 sm:grid-cols-5">
      {
        formas.map((forma) => (
          <li>
            <button
              type="button"
              data-facetest-manual={forma.id}
              class="group flex w-full flex-col items-center gap-2 rounded-2xl bg-white p-3 shadow-sm transition-shadow hover:shadow-md"
            >
              <img
                src={forma.imagen}
                alt=""
                width="96"
                height="96"
                loading="lazy"
                class="h-16 w-16 object-contain transition-transform duration-300 group-hover:scale-105 sm:h-20 sm:w-20"
              />
              <span class="text-sm font-semibold text-slate-900">{forma.label}</span>
            </button>
          </li>
        ))
      }
    </ul>
  </div>
</section>
