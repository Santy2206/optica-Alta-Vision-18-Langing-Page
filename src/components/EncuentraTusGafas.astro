---
// Fusión de TiposRostro + TiposMarco: el test de rostro es el protagonista;
// las formas de rostro son accesos rápidos al resultado (data-facetest-manual).
import Icon from './Icon.astro';
import FrameShapeIcon from './FrameShapeIcon.astro';
import { frameRecommendations } from '../data/faceShapeQuiz';
import { frameShapeLabel } from '../data/frameShape';

const formas = [
  { id: 'ovalado', imagen: '/images/rostros/ovalado.svg', label: 'Ovalado' },
  { id: 'redondo', imagen: '/images/rostros/redondo.svg', label: 'Redondo' },
  { id: 'cuadrado', imagen: '/images/rostros/cuadrado.svg', label: 'Cuadrado' },
  { id: 'corazon', imagen: '/images/rostros/corazon.svg', label: 'Corazón' },
  { id: 'diamante', imagen: '/images/rostros/diamante.svg', label: 'Diamante' },
] as const;
---

<section id="encuentra-tus-gafas" class="relative overflow-hidden bg-white py-16 md:py-24">
  <svg
    class="pointer-events-none absolute -left-24 -top-16 hidden h-80 w-80 text-aguamarina/10 md:block"
    viewBox="0 0 200 200"
    aria-hidden="true"
  >
    <path
      fill="currentColor"
      d="M45.3,-58.8C58.6,-49.5,68.7,-34.8,72.9,-18.5C77.1,-2.3,75.4,15.6,67.5,30.2C59.6,44.8,45.5,56.2,29.8,63.6C14.1,71,-3.2,74.4,-19.6,71.1C-36,67.8,-51.5,57.7,-61.8,43.5C-72.1,29.2,-77.2,10.7,-74.8,-6.4C-72.4,-23.6,-62.5,-39.4,-49,-49C-35.5,-58.6,-18.5,-62,-0.8,-60.8C16.9,-59.6,33.9,-53.8,45.3,-58.8Z"
      transform="translate(100 100)"
    />
  </svg>

  <div class="relative mx-auto max-w-4xl px-4 text-center">
    <p class="mb-2 text-sm font-bold uppercase tracking-wide text-fucsia">Encuentra tu estilo</p>
    <h2 class="text-2xl font-bold text-slate-900 md:text-3xl">Encuentra las gafas que te favorecen</h2>
    <p class="mx-auto mt-3 max-w-xl text-sm text-slate-600 md:text-base">
      Descubre tu forma de rostro y te mostramos las monturas que mejor te quedan.
    </p>

    <button
      type="button"
      data-facetest-open
      class="mt-8 inline-flex items-center gap-2 rounded-full bg-slate-900 px-7 py-3.5 text-base font-semibold text-white shadow-sm transition-opacity hover:opacity-90"
    >
      <Icon name="eye" class="h-5 w-5" />
      Haz el test de rostro (1 minuto)
    </button>

    <p class="mb-6 mt-10 text-sm font-semibold text-slate-700">¿Ya conoces tu forma de rostro? Elígela:</p>

    <ul class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
      {
        formas.map((forma, i) => {
          const recomendadas = frameRecommendations[forma.id].slice(0, 2);
          return (
            <li class="h-full">
              <button
                type="button"
                data-facetest-manual={forma.id}
                class:list={[
                  'group relative flex h-full w-full flex-col items-center gap-2 rounded-2xl border-2 p-4 shadow-sm transition-all hover:-translate-y-0.5 hover:shadow-md',
                  i % 2 === 0
                    ? 'border-aguamarina/20 bg-aguamarina/5 hover:border-aguamarina'
                    : 'border-fucsia/20 bg-fucsia/5 hover:border-fucsia',
                ]}
              >
                <div class="relative">
                  <img
                    src={forma.imagen}
                    alt=""
                    width="128"
                    height="128"
                    loading="lazy"
                    class="h-24 w-24 object-contain transition-transform duration-300 group-hover:scale-105 sm:h-28 sm:w-28"
                  />
                  <FrameShapeIcon
                    shape={recomendadas[0]}
                    class="absolute inset-x-0 top-1/3 mx-auto h-8 w-16 text-slate-900/70"
                  />
                </div>
                <span class="text-sm font-semibold text-slate-900">{forma.label}</span>
                <span class="mt-auto text-center text-xs text-slate-500">Te quedan: {recomendadas.map((s) => frameShapeLabel[s]).join(' y ')}</span>
              </button>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
