const icon = icons[name] ?? icons.phone;
const isFilled = filled || !!icon.filled;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill={isFilled ? 'currentColor' : 'none'}
  stroke={isFilled ? 'none' : 'currentColor'}
  stroke-width={isFilled ? '0' : '1.5'}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={icon.path} />
</svg>
