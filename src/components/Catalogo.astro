---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import { tiposLente } from '../data/tiposLente';
import { priceLabel, isFallbackPrice } from '../utils/precio';
import { isPlaceholderImage } from '../utils/images';
import { getFrameShape } from '../data/frameShape';
import FrameShapeIcon from './FrameShapeIcon.astro';
import { getDisplayImage, getTryOnOverlayImage, getTryOnPhotochromicImage } from '../utils/cutout';

const all = await getCollection('catalogo');
const featured = all.filter((item) => item.data.featured);
// Home: máximo 6. Con menos de 2 "destacadas" el carrusel se ve como una tarjeta suelta,
// así que completamos con el resto del catálogo.
const MAX_HOME = 6;
// Las formuladas van primero (propuesta principal: examen + gafas formuladas); sort es estable.
const formuladasPrimero = (list: typeof all) =>
  [...list].sort((x, y) => Number(y.data.category === 'formuladas') - Number(x.data.category === 'formuladas'));
const items = formuladasPrimero(featured.length > 1 ? featured : all).slice(0, MAX_HOME);

const siteUrl = Astro.site ?? new URL(Astro.url.origin);

// Solo monturas con precio: Google exige offers/review/aggregateRating en Product.
const productSchemas = items.filter((item) => item.data.price !== null).map((item) => {
  const product: Record<string, unknown> = {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: item.data.name,
    brand: {
      '@type': 'Brand',
      name: item.data.brand,
    },
    image: new URL(item.data.image, siteUrl).href,
  };

  product.offers = {
    '@type': 'Offer',
    price: item.data.price,
    priceCurrency: 'COP',
    availability: 'https://schema.org/InStock',
    url: new URL('/catalogo', siteUrl).href,
  };

  return product;
});
---

{items.length > 0 && (
<section id="catalogo" class="bg-brand-tint py-12 md:py-24">
  <div class="mx-auto max-w-6xl px-4">
    <h2 class="mb-2 text-center text-2xl font-bold text-slate-900 md:mb-3 md:text-3xl">
      Monturas destacadas
    </h2>
    <p class="mx-auto mb-6 max-w-xl px-1 text-center text-sm leading-relaxed text-slate-600 md:mb-10 md:text-base">
      Elige tu montura y cotízala con el lente que necesitas, o pruébatela con tu cámara.
    </p>

    {
      (
        <>
          <div class="relative" data-catalogo-wrapper>
          {items.length > 1 && (
            <button
              type="button"
              class="absolute -left-1 top-[38%] z-10 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-slate-200 bg-white/95 text-slate-900 shadow-md backdrop-blur-sm transition-opacity hover:shadow-lg disabled:pointer-events-none disabled:opacity-0 sm:left-0 sm:-translate-x-4"
              aria-label="Anterior"
              data-catalogo-prev
            >
              <Icon name="chevron-left" class="h-5 w-5" />
            </button>
          )}

          <div
            class:list={[
              'flex gap-3 overflow-x-auto scroll-smooth px-1 pb-4 [-ms-overflow-style:none] [scrollbar-width:none] sm:gap-6 sm:px-0 [&::-webkit-scrollbar]:hidden',
              items.length > 1 ? 'snap-x snap-mandatory' : 'justify-center',
            ]}
            data-catalogo-track
          >
            {items.map((item) => {
              const firstColor = item.data.colors[0];
              const tryOnFrame = firstColor?.name ?? '';
              const tryOnLenses = firstColor?.lenses ?? [];
              // "Probar con cámara" solo aparece si ya existe el recorte transparente
              // (scripts/generate-cutouts.mjs) de la foto de este color / de la montura.
              const overlayImage = getTryOnOverlayImage(firstColor?.image || item.data.image);
              const overlayImagePhotochromic = getTryOnPhotochromicImage(firstColor?.image || item.data.image);
              // Foto con fondo recortado automáticamente (scripts/generate-cutouts.mjs),
              // o la original si el recorte todavía no corrió para esta foto.
              const displayImage = isPlaceholderImage(item.data.image)
                ? item.data.image
                : getDisplayImage(item.data.image);
              // Misma foto de fondo recortado que displayImage: si no, el fondo blanco de
              // esta foto no combina con el bg-slate-100 de la tarjeta al pasar el mouse.
              const hoverImage = firstColor?.modelImage ? getDisplayImage(firstColor.modelImage) : '';

              return (
                <article
                  class="flex w-[min(85%,20rem)] shrink-0 snap-center flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition-shadow hover:shadow-md sm:w-[45%] sm:snap-start lg:w-[30%] xl:w-[23%]"
                  data-catalogo-item
                  data-category={item.data.category}
                >
                  <div class="relative aspect-[4/3] bg-slate-100" data-photo-hover>
                    {isPlaceholderImage(item.data.image) ? (
                      <div class="flex h-full w-full items-center justify-center text-slate-400">
                        <FrameShapeIcon shape={getFrameShape(item.data) ?? 'ovalada'} class="h-14 w-14 sm:h-16 sm:w-16" />
                      </div>
                    ) : (
                      <img
                        src={displayImage}
                        alt={item.data.imageAlt}
                        loading="lazy"
                        class="h-full w-full object-cover"
                        data-product-image
                        data-default-image={displayImage}
                        data-hover-image={hoverImage}
                      />
                    )}
                  </div>
                  <div class="flex flex-1 flex-col gap-2 p-3.5 sm:p-4">
                    <div>
                      <h3 class="text-[0.95rem] font-semibold leading-snug text-slate-900 sm:text-base">{item.data.name}</h3>
                      <p class="text-sm text-slate-500">{item.data.brand}</p>
                    </div>

                    {item.data.colors.length > 0 && (
                      <div class="flex flex-wrap gap-2" role="group" aria-label="Colores del marco">
                        {item.data.colors.map((color, ci) => (
                          <button
                            type="button"
                            class:list={[
                              'h-6 w-6 rounded-full border border-slate-300 transition-shadow',
                              ci === 0 && 'ring-2 ring-offset-2 ring-slate-900',
                            ]}
                            style={
                              color.hex2
                                ? `background: linear-gradient(135deg, ${color.hex} 50%, ${color.hex2} 50%)`
                                : `background-color: ${color.hex}`
                            }
                            title={color.name}
                            aria-label={`Marco ${color.name}`}
                            data-swatch
                            data-image={color.image ?? ''}
                            data-model-image={color.modelImage ? getDisplayImage(color.modelImage) : ''}
                            data-overlay-image={getTryOnOverlayImage(color.image || item.data.image) ?? ''}
                            data-overlay-image-photochromic={getTryOnPhotochromicImage(color.image || item.data.image) ?? ''}
                            data-lenses={JSON.stringify(color.lenses)}
                          />
                        ))}
                      </div>
                    )}

                    <p class:list={[isFallbackPrice(item.data.price) ? "text-sm text-slate-600" : "text-base font-medium text-slate-900"]}>{priceLabel(item.data.price)}</p>
                    <button
                      type="button"
                      class="mt-auto inline-block rounded-full border-2 border-slate-900 bg-verde-neon px-4 py-2.5 text-center text-sm font-semibold text-slate-900 transition-shadow hover:shadow-md"
                      data-open-lens-modal
                      data-frame-name={item.data.name}
                      data-slug={item.id}
                    >
                      Cotizar esta montura
                    </button>
                    {overlayImage && (
                      <button
                        type="button"
                        class="inline-flex items-center justify-center gap-1.5 rounded-full border border-slate-300 px-4 py-2.5 text-center text-sm font-semibold text-slate-700 transition-colors hover:border-aguamarina hover:text-aguamarina"
                        data-tryon-open
                        data-slug={item.id}
                        data-overlay-image={overlayImage}
                        data-overlay-image-photochromic={overlayImagePhotochromic ?? ''}
                        data-name={item.data.name}
                        data-frame={tryOnFrame}
                        data-lenses={JSON.stringify(tryOnLenses)}
                      >
                        <Icon name="eye" class="h-4 w-4" />
                        Probar con cámara
                      </button>
                    )}
                  </div>
                </article>
              );
            })}
          </div>

          {items.length > 1 && (
            <button
              type="button"
              class="absolute -right-1 top-[38%] z-10 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-slate-200 bg-white/95 text-slate-900 shadow-md backdrop-blur-sm transition-opacity hover:shadow-lg disabled:pointer-events-none disabled:opacity-0 sm:right-0 sm:translate-x-4"
              aria-label="Siguiente"
              data-catalogo-next
            >
              <Icon name="chevron-right" class="h-5 w-5" />
            </button>
          )}

          {items.length > 1 && (
            <div
              class="mt-3 flex justify-center gap-2 sm:mt-4"
              role="tablist"
              aria-label="Seleccionar página"
              data-catalogo-dots
            />
          )}
          </div>

        </>
      )
    }

    <div class="mt-6 text-center sm:mt-8">
      <a
        href="/catalogo"
        class="inline-block rounded-full bg-slate-900 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-slate-800"
      >
        Ver catálogo completo
      </a>
    </div>
  </div>

  {productSchemas.map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}

  <div
    class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/60 p-4"
    role="dialog"
    aria-modal="true"
    aria-label="Elige el tipo de lente"
    data-lens-modal
  >
    <div class="w-full max-w-md rounded-2xl bg-white p-6 shadow-xl">
      <div class="mb-4 flex items-start justify-between gap-4">
        <div>
          <h3 class="text-lg font-bold text-slate-900">¿Qué tipo de lente quieres cotizar?</h3>
          <p class="text-sm text-slate-500">
            Montura: <span class="font-medium text-slate-700" data-lens-modal-frame />
          </p>
        </div>
        <button
          type="button"
          class="rounded-full p-1.5 text-slate-500 transition-colors hover:bg-slate-100 hover:text-slate-900"
          aria-label="Cerrar"
          data-close-lens-modal
        >
          <Icon name="close" class="h-5 w-5" />
        </button>
      </div>

      <div class="grid grid-cols-2 gap-3">
        {
          tiposLente.map((tipo) => (
            <button
              type="button"
              class="group relative overflow-hidden rounded-xl text-left shadow-sm transition-shadow hover:shadow-md"
              data-lens-modal-option
              data-lens-name={tipo.nombre}
            >
              <div class="aspect-[3/4] w-full overflow-hidden">
                <img
                  src={tipo.imagen}
                  alt={`Lentes ${tipo.nombre}`}
                  loading="lazy"
                  class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                />
              </div>
              <span class="absolute inset-x-0 bottom-2 mx-auto flex w-fit items-center justify-center rounded-full bg-white px-3 py-1.5 text-xs font-semibold text-slate-900 shadow-md">
                {tipo.nombre}
              </span>
            </button>
          ))
        }
      </div>

      <button
        type="button"
        class="mt-4 w-full text-center text-sm font-medium text-slate-500 underline-offset-4 hover:text-slate-700 hover:underline"
        data-skip-lens
      >
        Prefiero preguntar sin elegir el lente
      </button>
    </div>
  </div>
</section>
)}

<script>
  import { waLink } from '../utils/whatsapp';

  const wrapper = document.querySelector<HTMLElement>('[data-catalogo-wrapper]');
  const track = document.querySelector<HTMLElement>('[data-catalogo-track]');
  const prev = document.querySelector<HTMLButtonElement>('[data-catalogo-prev]');
  const next = document.querySelector<HTMLButtonElement>('[data-catalogo-next]');
  const dotsContainer = document.querySelector<HTMLElement>('[data-catalogo-dots]');
  const slides = track?.querySelectorAll<HTMLElement>(':scope > article') ?? [];


  if (track && slides.length > 1) {
    const slideWidth = () => {
      const visibleSlide = Array.from(slides).find((s) => !s.classList.contains('hidden'));
      return (visibleSlide?.getBoundingClientRect().width ?? 0) + 24; // gap-6 = 24px
    };

    const maxScrollLeft = () => track.scrollWidth - track.clientWidth;

    // Cuántas posiciones de scroll realmente existen (depende de cuántas tarjetas
    // caben por vista, que cambia según el breakpoint) — no siempre una por tarjeta.
    const pageCount = () => {
      const max = maxScrollLeft();
      if (max <= 4) return 1;
      return Math.round(max / slideWidth()) + 1;
    };

    const currentIndex = () => Math.round(track.scrollLeft / slideWidth());

    let dots: HTMLButtonElement[] = [];

    const buildDots = () => {
      if (!dotsContainer) return;
      const count = pageCount();
      if (dots.length === count) return;

      dotsContainer.innerHTML = '';
      dots = Array.from({ length: count }, (_, i) => {
        const dot = document.createElement('button');
        dot.type = 'button';
        // 24px de área táctil (WCAG target-size) con el punto visible de 10px vía bg-clip-content.
        dot.className = 'h-6 w-6 rounded-full bg-slate-300 bg-clip-content p-[7px] transition-colors';
        dot.setAttribute('role', 'tab');
        dot.setAttribute('aria-label', `Ver página ${i + 1}`);
        dot.addEventListener('click', () => goTo(i));
        dotsContainer.appendChild(dot);
        return dot;
      });
    };

    const goTo = (index: number) => {
      const count = pageCount();
      const clamped = ((index % count) + count) % count;
      track.scrollTo({ left: Math.min(slideWidth() * clamped, maxScrollLeft()), behavior: 'smooth' });
    };

    const updateUI = () => {
      buildDots();
      const index = currentIndex();
      prev?.toggleAttribute('disabled', track.scrollLeft <= 4);
      next?.toggleAttribute('disabled', track.scrollLeft >= maxScrollLeft() - 4);
      dots.forEach((dot, i) => {
        const active = i === index;
        dot.classList.toggle('bg-aguamarina', active);
        dot.classList.toggle('bg-slate-300', !active);
        dot.setAttribute('aria-selected', active ? 'true' : 'false');
      });
    };

    prev?.addEventListener('click', () => goTo(currentIndex() - 1));
    next?.addEventListener('click', () => {
      const atEnd = track.scrollLeft >= maxScrollLeft() - 4;
      atEnd ? goTo(0) : goTo(currentIndex() + 1);
    });

    track.addEventListener('scroll', updateUI);
    window.addEventListener('resize', updateUI);
    updateUI();

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let timer: ReturnType<typeof setInterval> | undefined;

    const stopAuto = () => {
      if (timer) clearInterval(timer);
    };

    const startAuto = () => {
      if (prefersReducedMotion) return;
      stopAuto();
      timer = setInterval(() => {
        const atEnd = track.scrollLeft >= maxScrollLeft() - 4;
        atEnd ? goTo(0) : goTo(currentIndex() + 1);
      }, 4000);
    };

    wrapper?.addEventListener('mouseenter', stopAuto);
    wrapper?.addEventListener('mouseleave', startAuto);
    wrapper?.addEventListener('focusin', stopAuto);
    wrapper?.addEventListener('focusout', startAuto);

    startAuto();
  }

  document.addEventListener('click', (e) => {
    const swatch = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-swatch]');
    if (!swatch) return;

    const article = swatch.closest('article');
    if (!article) return;

    const image = article.querySelector<HTMLImageElement>('[data-product-image]');
    if (image) {
      if (swatch.dataset.image) {
        image.src = swatch.dataset.image;
        image.dataset.defaultImage = swatch.dataset.image;
      }
      image.dataset.hoverImage = swatch.dataset.modelImage ?? '';
    }

    article.querySelectorAll<HTMLButtonElement>('[data-swatch]').forEach((s) => {
      const selected = s === swatch;
      s.classList.toggle('ring-2', selected);
      s.classList.toggle('ring-offset-2', selected);
      s.classList.toggle('ring-slate-900', selected);
    });
  });

  document.querySelectorAll<HTMLElement>('[data-photo-hover]').forEach((container) => {
    const image = container.querySelector<HTMLImageElement>('[data-product-image]');
    if (!image) return;

    container.addEventListener('mouseenter', () => {
      if (image.dataset.hoverImage) image.src = image.dataset.hoverImage;
    });

    container.addEventListener('mouseleave', () => {
      if (image.dataset.defaultImage) image.src = image.dataset.defaultImage;
    });
  });

  const lensModal = document.querySelector<HTMLElement>('[data-lens-modal]');
  const lensModalFrame = document.querySelector<HTMLElement>('[data-lens-modal-frame]');
  const lensModalOptions = document.querySelectorAll<HTMLButtonElement>('[data-lens-modal-option]');
  const openLensButtons = document.querySelectorAll<HTMLButtonElement>('[data-open-lens-modal]');
  const closeLensButton = document.querySelector<HTMLButtonElement>('[data-close-lens-modal]');
  const skipLensButton = document.querySelector<HTMLButtonElement>('[data-skip-lens]');
  let currentFrameName = '';
  let currentOrigen = '';

  const openLensModal = (frameName: string, slug: string) => {
    currentFrameName = frameName;
    currentOrigen = `cotizador:${slug}`;
    // data-cta dinámico: el tracker de BaseLayout lo lee al hacer clic.
    lensModalOptions.forEach((b) => (b.dataset.cta = currentOrigen));
    if (skipLensButton) skipLensButton.dataset.cta = currentOrigen;
    if (lensModalFrame) lensModalFrame.textContent = frameName;
    lensModal?.classList.remove('hidden');
    lensModal?.classList.add('flex');
  };

  const closeLensModal = () => {
    lensModal?.classList.add('hidden');
    lensModal?.classList.remove('flex');
  };

  const sendWhatsApp = (message: string) => {
    window.open(waLink(currentOrigen, message), '_blank', 'noopener');
  };

  openLensButtons.forEach((button) => {
    button.addEventListener('click', () => {
      openLensModal(button.dataset.frameName ?? '', button.dataset.slug ?? '');
    });
  });

  closeLensButton?.addEventListener('click', closeLensModal);

  lensModal?.addEventListener('click', (e) => {
    if (e.target === lensModal) closeLensModal();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeLensModal();
  });

  lensModalOptions.forEach((button) => {
    button.addEventListener('click', () => {
      const lensName = button.dataset.lensName ?? '';
      sendWhatsApp(`Hola, quiero cotizar unas gafas con lente ${lensName} y montura ${currentFrameName}`);
      closeLensModal();
    });
  });

  skipLensButton?.addEventListener('click', () => {
    sendWhatsApp(`Hola, quiero información sobre ${currentFrameName}`);
    closeLensModal();
  });
</script>
