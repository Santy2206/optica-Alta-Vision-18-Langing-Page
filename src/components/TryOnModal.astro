---
import Icon from './Icon.astro';
import site from '../utils/site';
---

<!--
  Modal de prueba virtual compartido. Cualquier botón en la página con
  data-tryon-open + data-overlay-image + data-name + data-slug (y opcionalmente
  data-overlay-image-photochromic + data-frame + data-lenses JSON) abre este modal
  (delegación de eventos).
-->
<div
  class="fixed inset-0 z-[60] hidden items-center justify-center bg-slate-900/70 p-4"
  role="dialog"
  aria-modal="true"
  aria-label="Prueba virtual de gafas"
  data-tryon-modal
  data-cta-tried={site.probador.ctaTexto}
>
  <div class="flex max-h-[92vh] w-full max-w-md flex-col overflow-y-auto rounded-2xl bg-white shadow-xl">
    <div class="flex items-center justify-between gap-4 border-b border-slate-100 p-4">
      <div>
        <p class="text-sm font-bold text-slate-900">Prueba virtual</p>
        <p class="text-xs text-slate-500">
          <span data-tryon-current-label>—</span>
        </p>
      </div>
      <button
        type="button"
        class="rounded-full p-1.5 text-slate-500 transition-colors hover:bg-slate-100 hover:text-slate-900"
        aria-label="Cerrar"
        data-tryon-close
      >
        <Icon name="close" class="h-5 w-5" />
      </button>
    </div>

    <div class="relative aspect-[4/3] w-full bg-slate-900" data-tryon-stage>
      <video data-tryon-video autoplay playsinline muted class="absolute inset-0 h-full w-full -scale-x-100 object-cover"></video>
      <canvas data-tryon-canvas class="absolute inset-0 h-full w-full"></canvas>

      <div data-tryon-loading class="absolute inset-0 z-30 flex items-center justify-center bg-slate-900/80 text-sm font-medium text-white">
        Cargando cámara…
      </div>

      <div
        class="absolute inset-0 z-40 hidden flex-col items-center justify-center gap-3 bg-slate-900/95 p-6 text-center text-sm text-white"
        data-tryon-error
      >
        <p data-tryon-error-message>No pudimos acceder a tu cámara.</p>
        <p class="text-xs text-white/70">
          Verifica los permisos de cámara del navegador e intenta de nuevo.
        </p>
      </div>
    </div>

    <div class="hidden border-t border-slate-100 p-4" data-tryon-lens-panel>
      <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-slate-500">
        Color del lente: <span class="normal-case text-slate-900" data-tryon-lens-label>—</span>
      </p>
      <div class="flex flex-wrap gap-2" role="group" aria-label="Color del lente" data-tryon-lenses></div>
    </div>

    <div class="sticky bottom-0 border-t border-slate-100 bg-white p-4" data-tryon-cta>
      <a
        href="#"
        target="_blank"
        rel="noopener noreferrer"
        class="border-2 border-slate-900 flex items-center justify-center gap-2 rounded-full bg-verde-neon px-4 py-3 text-center text-sm font-semibold text-slate-900 shadow-sm transition-shadow hover:shadow-md"
        data-tryon-whatsapp
      >
        <Icon name="whatsapp" class="h-4 w-4" />
        <span data-tryon-whatsapp-label>Pregúntanos por esta montura</span>
      </a>
    </div>
  </div>
</div>

<script>
  import { waLink } from '../utils/whatsapp';
  import { startTryOnOverlay, preloadTryOnLandmarker, type TryOnOverlayController } from '../scripts/tryOnOverlay';

  type Lens = { name: string; hex: string };

  const modal = document.querySelector<HTMLElement>('[data-tryon-modal]');
  const video = document.querySelector<HTMLVideoElement>('[data-tryon-video]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-tryon-canvas]');
  const loadingLabel = document.querySelector<HTMLElement>('[data-tryon-loading]');
  const closeButton = document.querySelector('[data-tryon-close]');
  const currentLabel = document.querySelector('[data-tryon-current-label]');
  const errorPanel = document.querySelector('[data-tryon-error]');
  const errorMessage = document.querySelector<HTMLElement>('[data-tryon-error-message]');
  const whatsappLink = document.querySelector<HTMLAnchorElement>('[data-tryon-whatsapp]');

  // Imagen de la montura en memoria (no está en el DOM): tryOnOverlay.ts la dibuja
  // en el canvas cada frame, leyendo siempre su src/dimensiones actuales.
  const glassesImg = new Image();
  // URLs de las dos variantes generadas por scripts/generate-cutouts.mjs para la montura/
  // color actual: lente transparente (normal) y lente oscurecido (fotocromático activado).
  let overlayUrl = '';
  let overlayUrlPhotochromic = '';

  let stream: MediaStream | null = null;
  let overlayController: TryOnOverlayController | null = null;
  let hasTried = false;

  const showError = (message: string) => {
    if (errorMessage) errorMessage.textContent = message;
    errorPanel?.classList.remove('hidden');
    errorPanel?.classList.add('flex');
    loadingLabel?.classList.add('hidden');
  };

  const hideError = () => {
    errorPanel?.classList.add('hidden');
    errorPanel?.classList.remove('flex');
  };

  const lensPanel = document.querySelector('[data-tryon-lens-panel]');
  const lensContainer = document.querySelector('[data-tryon-lenses]');
  const lensLabel = document.querySelector('[data-tryon-lens-label]');

  // Disponibles en todas las monturas sin que el negocio tenga que agregarlas a mano en
  // cada una desde el CMS. "Normal" solo se agrega cuando el marco no tiene sus propios
  // colores de lente (si ya los tiene, el primero de esos hace de opción "normal").
  const NORMAL_LENS: Lens = { name: 'Normal', hex: '#E8ECEF' };
  const PHOTOCHROMIC_LENS: Lens = { name: 'Fotocromático', hex: '#9AA5B1' };

  let current = { name: '', slug: '', frame: '', lens: '' };
  const whatsappLabel = document.querySelector<HTMLElement>('[data-tryon-whatsapp-label]');
  // Texto editable desde el CMS (Configuración → Probador virtual).
  const ctaTried = modal?.dataset.ctaTried || 'Me gustan, ¿las tienen disponibles?';

  const updateTexts = () => {
    const montura = current.frame ? `${current.name} — marco ${current.frame}` : current.name;
    if (currentLabel) currentLabel.textContent = montura;
    if (lensLabel) lensLabel.textContent = current.lens || '—';
    if (whatsappLink) {
      const detalle = [
        current.name,
        current.frame && `color ${current.frame}`,
        current.lens && `lente ${current.lens}`,
      ]
        .filter(Boolean)
        .join(', ');
      const origen = `probador:${current.slug}`;
      whatsappLink.href = waLink(
        origen,
        hasTried
          ? `Hola, me probé virtualmente las gafas ${detalle} y me gustan. ¿Las tienen disponibles?`
          : `Hola, quiero información sobre las gafas ${detalle}.`,
      );
      whatsappLink.dataset.cta = origen;
    }
    if (whatsappLabel) {
      whatsappLabel.textContent = hasTried ? ctaTried : 'Pregúntanos por esta montura';
    }
  };

  // El color del lente es solo informativo (se ve en el mensaje de WhatsApp): no hay forma
  // de retintar en vivo una foto plana con un color arbitrario, a diferencia de un modelo
  // 3D. "Fotocromático" es la excepción: sí cambia la imagen que dibuja el overlay, a la
  // variante con el lente oscurecido generada en build (scripts/generate-cutouts.mjs).
  const applyLensImage = (lensName: string) => {
    const isPhotochromic = lensName === PHOTOCHROMIC_LENS.name;
    glassesImg.src = (isPhotochromic && overlayUrlPhotochromic) || overlayUrl;
  };

  const selectLens = (lens: Lens) => {
    current.lens = lens.name;
    updateTexts();
    applyLensImage(lens.name);
    lensContainer?.querySelectorAll('button').forEach((b) => {
      const active = b.dataset.name === lens.name;
      b.classList.toggle('border-slate-900', active);
      b.classList.toggle('border-slate-300', !active);
      b.setAttribute('aria-pressed', active ? 'true' : 'false');
    });
  };

  const renderLenses = (frameLenses: Lens[]) => {
    if (!lensContainer || !lensPanel) return;
    const base = frameLenses.length > 0 ? frameLenses : [NORMAL_LENS];
    const lenses = base.some((l) => l.name === PHOTOCHROMIC_LENS.name) ? base : [...base, PHOTOCHROMIC_LENS];
    lensContainer.replaceChildren();
    lensPanel.classList.toggle('hidden', lenses.length === 0);

    lenses.forEach((lens) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.dataset.name = lens.name;
      button.className =
        'inline-flex items-center gap-1.5 rounded-full border border-slate-300 px-3 py-1.5 text-xs font-medium text-slate-700 transition-colors hover:border-aguamarina';
      const dot = document.createElement('span');
      dot.className = 'h-3.5 w-3.5 rounded-full border border-slate-300';
      dot.style.backgroundColor = lens.hex;
      button.append(dot, document.createTextNode(lens.name));
      button.addEventListener('click', () => selectLens(lens));
      lensContainer.appendChild(button);
    });

    const active = lenses[0];
    if (active) {
      current.lens = active.name;
      applyLensImage(active.name);
      lensContainer.querySelectorAll('button').forEach((b, i) => {
        b.classList.toggle('border-slate-900', i === 0);
        b.classList.toggle('border-slate-300', i !== 0);
        b.setAttribute('aria-pressed', i === 0 ? 'true' : 'false');
      });
    }
  };

  const parseLenses = (raw: string | undefined): Lens[] => {
    try {
      return JSON.parse(raw || '[]');
    } catch {
      return [];
    }
  };

  const openModal = async ({
    overlayImage,
    overlayImagePhotochromic,
    name,
    slug,
    frame,
    lenses,
  }: {
    overlayImage: string;
    overlayImagePhotochromic: string;
    name: string;
    slug: string;
    frame: string;
    lenses: Lens[];
  }) => {
    if (!modal || !video || !canvas) return;
    hideError();
    loadingLabel?.classList.remove('hidden');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    current = { name, slug, frame, lens: '' };
    hasTried = false;
    overlayUrl = overlayImage;
    overlayUrlPhotochromic = overlayImagePhotochromic;
    glassesImg.src = overlayUrl;
    renderLenses(lenses);
    updateTexts();

    if (stream) {
      // Ya hay cámara abierta (se cambió de color/montura sin cerrar el modal):
      // solo se actualiza la imagen que dibuja el overlay en curso.
      loadingLabel?.classList.add('hidden');
      hasTried = true;
      updateTexts();
      return;
    }

    preloadTryOnLandmarker();

    try {
      stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user' } });
    } catch {
      showError('No pudimos acceder a tu cámara. Verifica los permisos de tu navegador e intenta de nuevo.');
      return;
    }

    video.srcObject = stream;
    try {
      await video.play();
    } catch {
      showError('No pudimos iniciar la cámara. Intenta de nuevo.');
      return;
    }

    loadingLabel?.classList.add('hidden');
    hasTried = true;
    updateTexts();
    overlayController = startTryOnOverlay(video, canvas, glassesImg);
  };

  const closeModal = () => {
    if (!modal) return;
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    overlayController?.stop();
    overlayController = null;
    stream?.getTracks().forEach((track) => track.stop());
    stream = null;
    if (video) video.srcObject = null;
  };

  // Delegación de eventos: cualquier botón [data-tryon-open] en la página abre este modal,
  // sin importar qué componente lo haya renderizado (catálogo, más vendidas, etc).
  document.addEventListener('click', (event) => {
    const target = event.target as Element | null;
    const button = target?.closest<HTMLElement>('[data-tryon-open]');
    if (button?.dataset.overlayImage) {
      openModal({
        overlayImage: button.dataset.overlayImage,
        overlayImagePhotochromic: button.dataset.overlayImagePhotochromic || '',
        name: button.dataset.name || 'esta montura',
        slug: button.dataset.slug || 'sin-slug',
        frame: button.dataset.frame || '',
        lenses: parseLenses(button.dataset.lenses),
      });
      return;
    }

    // Elegir un color de marco en la tarjeta deja listo "Probar con cámara"
    // con ese marco (si tiene foto con fondo recortado disponible).
    const swatch = target?.closest<HTMLElement>('[data-swatch]');
    const tryOnButton = swatch?.closest('article')?.querySelector<HTMLElement>('[data-tryon-open]');
    if (swatch && tryOnButton) {
      const overlayImage = swatch.dataset.overlayImage || '';
      tryOnButton.classList.toggle('hidden', !overlayImage);
      if (overlayImage) {
        tryOnButton.dataset.overlayImage = overlayImage;
        tryOnButton.dataset.overlayImagePhotochromic = swatch.dataset.overlayImagePhotochromic || '';
        tryOnButton.dataset.frame = swatch.title;
        tryOnButton.dataset.lenses = swatch.dataset.lenses || '[]';
      }
    }
  });

  closeButton?.addEventListener('click', closeModal);

  modal?.addEventListener('click', (event) => {
    if (event.target === modal) closeModal();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeModal();
  });
</script>
