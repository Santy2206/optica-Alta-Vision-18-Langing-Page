---
// Selector de tipo de lente para monturas "formuladas" del catálogo.
// Cualquier botón con data-lente-open + data-name + data-origen abre este modal
// (delegación de eventos); al elegir se abre WhatsApp con la montura + el lente.
import Icon from '../Icon.astro';
import { tiposLente } from '../../data/tiposLente';
import { getTryOnOverlayImage } from '../../utils/cutout';
import { getCollection } from 'astro:content';
import { readFileSync } from 'node:fs';
import path from 'node:path';
import '../../styles/flow.css';

// Mini-visual del progresivo: mismo marco + máscara del cristal que la escena de
// lentes del home (scripts/generate-flow-lens-mask.mjs → lente-mascara.{json,png}).
const lensMask = JSON.parse(
  readFileSync(path.join(process.cwd(), 'public', 'images', 'flow', 'lente-mascara.json'), 'utf-8'),
) as { slug: string; lenses: Array<{ x0: number; x1: number; y0: number; y1: number }> };
const lensItem = (await getCollection('catalogo')).find((i) => i.id === lensMask.slug);
const lensFrame = lensItem
  ? getTryOnOverlayImage(lensItem.data.colors[0]?.image || lensItem.data.image)
  : null;

// Zonas del progresivo: líneas a 1/3 y 2/3 y "neblina" en las esquinas inferiores (idéntico al home).
const pct = (n: number) => `${(n * 100).toFixed(1)}%`;
const progFondo = [
  'linear-gradient(to bottom, transparent 33%, rgba(255,255,255,.55) 33%, rgba(255,255,255,.55) calc(33% + 1px), transparent calc(33% + 1px), transparent 66%, rgba(255,255,255,.55) 66%, rgba(255,255,255,.55) calc(66% + 1px), transparent calc(66% + 1px))',
  ...lensMask.lenses.flatMap((l) => [
    `radial-gradient(ellipse ${((l.x1 - l.x0) * 55).toFixed(0)}% 42% at ${pct(l.x0)} 100%, rgba(255,255,255,.5), transparent 70%)`,
    `radial-gradient(ellipse ${((l.x1 - l.x0) * 55).toFixed(0)}% 42% at ${pct(l.x1)} 100%, rgba(255,255,255,.5), transparent 70%)`,
  ]),
  'linear-gradient(to bottom, rgba(1,159,216,.18), rgba(1,159,216,.05) 45%, rgba(194,17,115,.14))',
].join(',');
---

<div
  class="fl-lente"
  role="dialog"
  aria-modal="true"
  aria-labelledby="lente-titulo"
  data-lente-modal
  hidden
>
  <div class="fl-lente__backdrop" data-lente-close></div>
  <div class="fl-lente__card">
    <div class="fl-lente__head">
      <div>
        <p class="fl-eyebrow">Cotiza tu fórmula</p>
        <h2 id="lente-titulo" class="fl-lente__titulo">Elige el tipo de lente</h2>
        <p class="fl-lente__marco" data-lente-frame>—</p>
      </div>
      <button type="button" class="fl-lente__cerrar" aria-label="Cerrar" data-lente-close>
        <Icon name="close" />
      </button>
    </div>

    <div class="fl-lente__opciones" role="list">
      {
        tiposLente.map((tipo) => (
          <button type="button" class="fl-lente__opt" data-lente-opt={tipo.nombre}>
            {tipo.visual === 'progresivo' && lensFrame ? (
              <span class="fl-lente__thumb fl-lente__thumb--prog">
                <img src={lensFrame} alt="" loading="lazy" class="fl-lente__thumb-frame" />
                <span class="fl-lente__thumb-fx" style={`background:${progFondo}`} aria-hidden="true" />
              </span>
            ) : (
              <span class="fl-lente__thumb">
                <img src={tipo.imagen} alt="" loading="lazy" />
                {tipo.imagenActiva && (
                  <img src={tipo.imagenActiva} alt="" loading="lazy" class="fl-lente__thumb-activa" />
                )}
                {tipo.tinte && (
                  <span
                    class="fl-lente__thumb-tinte"
                    style={`background: linear-gradient(135deg, transparent 25%, ${tipo.tinte} 55%, color-mix(in srgb, ${tipo.tinte} 55%, #fff) 75%, transparent 95%)`}
                    aria-hidden="true"
                  />
                )}
              </span>
            )}
            <span class="fl-lente__txt">
              <span>{tipo.nombre}</span>
              {tipo.descripcion && <small>{tipo.descripcion}</small>}
            </span>
          </button>
        ))
      }
      <button type="button" class="fl-lente__opt fl-lente__opt--plano" data-lente-opt="">
        <span>Solo la montura / aún no lo sé</span>
      </button>
    </div>

    <p class="fl-lente__nota">Te abrimos WhatsApp con la montura y el lente elegidos.</p>
  </div>
</div>

<script>
  import { waLink, trackCta } from '../../utils/whatsapp';

  const modal = document.querySelector<HTMLElement>('[data-lente-modal]');
  const frameLabel = modal?.querySelector<HTMLElement>('[data-lente-frame]');
  let origen = 'catalogo';
  let nombre = '';

  const abrir = (nombreMarco: string, origenMarco: string) => {
    nombre = nombreMarco;
    origen = origenMarco;
    if (frameLabel) frameLabel.textContent = nombre;
    modal?.removeAttribute('hidden');
    document.body.style.overflow = 'hidden';
  };

  const cerrar = () => {
    modal?.setAttribute('hidden', '');
    document.body.style.overflow = '';
  };

  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;

    const opener = t.closest<HTMLElement>('[data-lente-open]');
    if (opener) {
      abrir(opener.dataset.name ?? '', opener.dataset.origen ?? 'catalogo');
      return;
    }

    if (!modal || modal.hasAttribute('hidden')) return;

    if (t.closest('[data-lente-close]')) {
      cerrar();
      return;
    }

    const opt = t.closest<HTMLElement>('[data-lente-opt]');
    if (opt) {
      const tipo = opt.dataset.lenteOpt ?? '';
      const ref = tipo ? `${origen}:lente-${tipo.toLowerCase().replace(/\s+/g, '-')}` : origen;
      const mensaje = tipo
        ? `Hola, me interesa ${nombre} con lentes ${tipo}`
        : `Hola, me interesa ${nombre}`;
      trackCta(ref);
      window.open(waLink(ref, mensaje), '_blank', 'noopener,noreferrer');
      cerrar();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.hasAttribute('hidden')) cerrar();
  });
</script>
