---
// "Las más vendidas": riel horizontal con todas las monturas marcadas
// `featured` en el CMS (sin tope; las más recientes primero, igual que antes).
// Se oculta sola si no hay destacadas. Estilo Flow, igual que el catálogo.
import { getCollection } from 'astro:content';
import { waLink } from '../../utils/whatsapp';
import { priceLabel, isFallbackPrice } from '../../utils/precio';
import { isPlaceholderImage } from '../../utils/images';
import { getDisplayImage, getTryOnOverlayImage, getTryOnPhotochromicImage } from '../../utils/cutout';
import Icon from '../Icon.astro';
import '../../styles/flow.css';

const vendidas = (await getCollection('catalogo', ({ data }) => data.featured)).sort(
  // createdAt (ISO) descendente; las sin fecha cuentan como más viejas.
  (a, b) => (b.data.createdAt ?? '').localeCompare(a.data.createdAt ?? ''),
);
---

{
  vendidas.length > 0 && (
    <section class="fl-sec" aria-labelledby="vendidas-titulo">
      <div class="fl-glow fl-glow--iris" style="top:-30vmax;right:-25vmax" aria-hidden="true" />
      <div class="fl-sec__inner">
        <div class="fl-vendidas__head">
          <div class="fl-reveal">
            <p class="fl-eyebrow">Favoritas de la casa</p>
            <h2 id="vendidas-titulo" class="fl-h2">
              Las más <span class="fl-grad">vendidas</span>
            </h2>
          </div>
          <a href="/catalogo" class="fl-link fl-vendidas__ver fl-reveal" style="--d:.12s">
            Ver catálogo completo →
          </a>
        </div>

        {/* Carrusel continuo: la lista va duplicada y traduce -50% (loop).
            Los duplicados son aria-hidden/inert. */}
        <div class="fl-vendidas__riel fl-reveal" style="--d:.15s">
          <button type="button" class="fl-vendidas__nav fl-vendidas__nav--prev" data-nav="prev" aria-label="Monturas anteriores">
            ‹
          </button>
          <button type="button" class="fl-vendidas__nav fl-vendidas__nav--next" data-nav="next" aria-label="Monturas siguientes">
            ›
          </button>
          <ul class="fl-vendidas" aria-label="Monturas más vendidas">
            {[...vendidas, ...vendidas].map((item, i) => {
              const dup = i >= vendidas.length;
              const origen = `vendidas:${item.id}`;
              const waHref = waLink(origen, `Hola, me interesa ${item.data.name}`);
              const firstColor = item.data.colors[0];
              const src = firstColor?.image || item.data.image;
              const displayImage = isPlaceholderImage(item.data.image)
                ? item.data.image
                : getDisplayImage(src);
              // Igual que en el catálogo: el try-on solo aparece si ya existe el
              // recorte transparente de la foto de este color / de la montura.
              const overlayImage = getTryOnOverlayImage(src);
              const overlayImagePhotochromic = getTryOnPhotochromicImage(src);
              return (
                <li
                  class:list={['fl-card fl-vendida', dup && 'fl-vendida--dup']}
                  aria-hidden={dup || undefined}
                  inert={dup || undefined}
                >
                  <a href="/catalogo" class="fl-vendida__foto" aria-label={dup ? undefined : `Ver ${item.data.name} en el catálogo`} tabindex={dup ? -1 : undefined}>
                    <img
                      src={displayImage}
                      alt={dup ? '' : item.data.imageAlt}
                      loading="lazy"
                      decoding="async"
                      class="fl-vendida__img"
                    />
                  </a>
                  <div class="fl-vendida__info">
                    <p class="fl-vendida__nombre" title={item.data.name}>{item.data.name}</p>
                    <p class="fl-vendida__marca">{item.data.brand}</p>
                    {/* Siempre renderiza la fila (vacía si no hay colores) para que
                        precio y CTA queden alineados entre tarjetas. */}
                    <div class="fl-vendida__swatches" aria-label="Colores disponibles">
                      {item.data.colors.map((c) => (
                        <span
                          class="fl-vendida__swatch"
                          title={c.name}
                          style={
                            c.hex2
                              ? `background: linear-gradient(135deg, ${c.hex} 50%, ${c.hex2} 50%)`
                              : `background-color: ${c.hex}`
                          }
                        />
                      ))}
                    </div>
                    <p class:list={['fl-vendida__precio', isFallbackPrice(item.data.price) && 'fl-vendida__precio--suave']}>
                      {priceLabel(item.data.price)}
                    </p>
                    {item.data.category === 'formuladas' ? (
                      /* Igual que en el catálogo: las formuladas abren el
                         selector de tipo de lente antes de ir a WhatsApp. */
                      <button
                        type="button"
                        class="fl-btn fl-btn--lima fl-btn--sm fl-vendida__cta"
                        data-lente-open
                        data-name={item.data.name}
                        data-origen={origen}
                        tabindex={dup ? -1 : undefined}
                      >
                        Me interesa
                      </button>
                    ) : (
                      <a href={waHref} data-cta={dup ? undefined : origen} class="fl-btn fl-btn--lima fl-btn--sm fl-vendida__cta" target="_blank" rel="noopener noreferrer" tabindex={dup ? -1 : undefined}>
                        Me interesa
                      </a>
                    )}
                    {overlayImage && (
                      <button
                        type="button"
                        class="fl-btn fl-btn--linea fl-btn--sm"
                        data-tryon-open
                        data-slug={item.id}
                        data-overlay-image={overlayImage}
                        data-overlay-image-photochromic={overlayImagePhotochromic ?? ''}
                        data-name={item.data.name}
                        data-frame={firstColor?.name ?? ''}
                        data-lenses={JSON.stringify(firstColor?.lenses ?? [])}
                        tabindex={dup ? -1 : undefined}
                      >
                        <Icon name="eye" class="h-4 w-4" />
                        Probar con cámara
                      </button>
                    )}
                  </div>
                </li>
              );
            })}
          </ul>
        </div>
      </div>
    </section>
  )
}

<script>
  // Carrusel "más vendidas": corre solo en loop; al tocar una tarjeta queda bajo
  // el dedo (loop infinito: al pasar el borde envuelve a la copia idéntica), y al
  // volver a desplazar la página retoma el movimiento desde donde quedó.
  const riel = document.querySelector<HTMLElement>('.fl-vendidas');
  if (riel) {
    const DURACION_S = 75; // igual que `fl-vendidas-scroll` en flow.css
    let inicioX = 0;
    let inicioOffset = 0;
    let movio = false;

    const mitad = () => riel.scrollWidth / 2;
    const wrap = (x: number) => {
      const m = mitad();
      while (x < -m) x += m;
      while (x > 0) x -= m;
      return x;
    };
    const offsetActual = () => {
      const tx = new DOMMatrixReadOnly(getComputedStyle(riel).transform).m41;
      return Number.isFinite(tx) ? tx : 0;
    };
    // Mover la fase del loop a un offset dado: animation-delay negativo hace
    // que la animación continúe desde ese punto (sirve esté corriendo o en pausa).
    const irAOffset = (x: number) => {
      if (riel.classList.contains('is-arrastrando')) {
        riel.classList.remove('is-arrastrando');
        riel.style.transform = '';
      }
      const dur = parseFloat(getComputedStyle(riel).animationDuration) || DURACION_S;
      riel.style.animationDelay = `${-((-wrap(x) / mitad()) * dur)}s`;
    };

    // Flechas prev/next: saltar una tarjeta en cada dirección.
    const pitch = () => {
      const card = riel.querySelector('li');
      const gap = parseFloat(getComputedStyle(riel).gap) || 0;
      return (card?.offsetWidth ?? 260) + gap;
    };
    const cont = riel.parentElement;
    cont?.querySelector('[data-nav="prev"]')?.addEventListener('click', () => irAOffset(offsetActual() + pitch()));
    cont?.querySelector('[data-nav="next"]')?.addEventListener('click', () => irAOffset(offsetActual() - pitch()));

    // Retomar el loop solo cuando el usuario deja de interactuar: suelta el
    // dedo y pasan unos segundos, o vuelve a desplazar la página.
    let timerRetomar = 0;
    const reanudar = () => {
      if (!riel.classList.contains('is-arrastrando')) return;
      irAOffset(offsetActual());
    };
    const programarRetomar = () => {
      clearTimeout(timerRetomar);
      timerRetomar = window.setTimeout(reanudar, 4000);
    };

    riel.addEventListener('pointerdown', (e) => {
      clearTimeout(timerRetomar);
      if (e.pointerType === 'mouse') return;
      inicioX = e.clientX;
      inicioOffset = offsetActual();
      movio = false;
      // Las animaciones CSS pisan los estilos inline: hay que apagarla para poder
      // mover la pista con transform a mano.
      riel.classList.add('is-arrastrando');
      riel.style.transform = `translateX(${inicioOffset}px)`;
    });

    window.addEventListener('pointermove', (e) => {
      if (!riel.classList.contains('is-arrastrando') || e.pointerType === 'mouse') return;
      const delta = e.clientX - inicioX;
      if (Math.abs(delta) > 4) movio = true;
      riel.style.transform = `translateX(${wrap(inicioOffset + delta)}px)`;
    }, { passive: true });

    window.addEventListener('pointerup', () => {
      if (!riel.classList.contains('is-arrastrando')) return;
      inicioOffset = offsetActual();
      // Si hubo arrastre, tragarse el click que sigue al soltar (evita abrir el
      // link cuando el dedo se soltó encima de una tarjeta/botón).
      if (movio) {
        riel.addEventListener('click', (ev) => ev.preventDefault(), { capture: true, once: true });
      }
      // Tras unos segundos sin tocar nada, el carrusel retoma solo.
      programarRetomar();
    });

    // Al volver a scrollear la página, reanudar el loop desde el punto donde quedó.
    window.addEventListener('scroll', reanudar, { passive: true });

    // Si el foco sale del riel (tab), también retoma.
    riel.addEventListener('focusout', (e) => {
      if (!riel.contains(e.relatedTarget as Node | null)) reanudar();
    });
  }
</script>
