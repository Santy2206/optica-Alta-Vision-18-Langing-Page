---
// Opiniones de clientes (reseñas de Google de la colección `testimonios`) en estilo Flow.
import { getCollection } from 'astro:content';
import site from '../../utils/site';
import Icon from '../Icon.astro';
import '../../styles/flow.css';

const testimonios = (await getCollection('testimonios', ({ data }) => data.active)).sort(
  (a, b) => a.data.order - b.data.order,
);
const { rating, total, url: reviewsUrl } = site.googleReviews;
const fmtRating = (n: number) => n.toLocaleString('es-CO', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const initials = (fullName: string) =>
  fullName
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((w) => w[0]?.toUpperCase() ?? '')
    .join('');
const ACC = ['#019FD8', '#C21173', '#7CB928', '#6A47B8'];
---

{
  (testimonios.length > 0 || rating !== null) && (
    <section id="opiniones" class="fl-sec fl-sec--tenue fl-centro" aria-labelledby="opiniones-titulo">
      <div class="fl-glow fl-glow--magenta" style="top:-25vmax;left:-25vmax" aria-hidden="true" />
      <div class="fl-sec__inner">
        <p class="fl-eyebrow fl-reveal">Opiniones</p>
        <h2 id="opiniones-titulo" class="fl-h2 fl-reveal" style="--d:.08s">
          Lo que dicen <span class="fl-grad">nuestros clientes</span>
        </h2>

        {rating !== null && (
          <div class="fl-resumen fl-reveal" style="--d:.14s">
            <span class="fl-resumen__nota">
              {fmtRating(rating)}
              <span class="sr-only"> de 5 estrellas</span>
            </span>
            <span class="fl-estrellas fl-estrellas--g" aria-hidden="true">
              {Array.from({ length: 5 }, (_, i) => (
                <Icon name="star" filled class={i < Math.round(rating) ? 'fl-i' : 'fl-i fl-apagada'} />
              ))}
            </span>
            <span class="fl-resumen__txt">
              {total !== null ? `${total.toLocaleString('es-CO')} reseñas en Google` : 'Calificación en Google'}
            </span>
            {reviewsUrl && (
              <a href={reviewsUrl} target="_blank" rel="noopener noreferrer" class="fl-link">
                Ver en Google
              </a>
            )}
          </div>
        )}

        {testimonios.length > 0 && (
          <div class="fl-opiniones-wrap fl-reveal">
          <ul class="fl-opiniones" aria-label="Opiniones de clientes">
            {[...testimonios, ...testimonios].map(({ data }, i) => {
              // La segunda mitad duplica los items para el carrusel infinito de móvil;
              // queda oculta a lectores de pantalla y al foco, e invisible en escritorio.
              const dup = i >= testimonios.length;
              return (
                <li
                  class:list={['fl-opinion fl-card', dup && 'fl-opinion--dup']}
                  style={`--acc:${ACC[i % ACC.length]};--d:${(i % 3) * 0.1}s`}
                  aria-hidden={dup || undefined}
                  inert={dup || undefined}
                >
                  <span class="fl-estrellas" role="img" aria-label={`${data.estrellas} de 5 estrellas`}>
                    {Array.from({ length: 5 }, (_, j) => (
                      <Icon name="star" filled class={j < data.estrellas ? 'fl-i' : 'fl-i fl-apagada'} />
                    ))}
                  </span>
                  <blockquote class="fl-opinion__texto">“{data.texto}”</blockquote>
                  <div class="fl-opinion__autor">
                    {data.foto ? (
                      <img src={data.foto} alt="" width="40" height="40" loading="lazy" class="fl-avatar" />
                    ) : (
                      <span class="fl-avatar" aria-hidden="true">
                        {initials(data.nombre)}
                      </span>
                    )}
                    <div>
                      <p class="fl-opinion__nombre">{data.nombre}</p>
                      {(data.url || reviewsUrl) && (
                        <a href={data.url ?? reviewsUrl!} target="_blank" rel="noopener noreferrer" class="fl-opinion__google">
                          Reseña de Google
                        </a>
                      )}
                    </div>
                  </div>
                </li>
              );
            })}
          </ul>
          </div>
        )}
      </div>
    </section>
  )
}

<script>
  // Carrusel móvil: al tocar una opinión la pista queda bajo el dedo — el usuario
  // la arrastra a su ritmo para leer (loop infinito: al pasar el borde envuelve a
  // la copia idéntica). Cuando vuelve a desplazar la página, el carrusel retoma el
  // movimiento automático desde donde quedó (animation-delay negativo).
  const lista = document.querySelector<HTMLElement>('.fl-opiniones');
  if (lista) {
    const DURACION_S = 75; // igual que `fl-opiniones-scroll` en flow.css
    let inicioX = 0;
    let inicioOffset = 0;
    let movio = false;

    const mitad = () => lista.scrollWidth / 2;
    const wrap = (x: number) => {
      const m = mitad();
      while (x < -m) x += m;
      while (x > 0) x -= m;
      return x;
    };
    const offsetActual = () => {
      const tx = new DOMMatrixReadOnly(getComputedStyle(lista).transform).m41;
      return Number.isFinite(tx) ? tx : 0;
    };

    lista.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse') return;
      inicioX = e.clientX;
      inicioOffset = offsetActual();
      movio = false;
      // Las animaciones CSS pisan los estilos inline: hay que apagarla para poder
      // mover la pista con transform a mano.
      lista.classList.add('is-arrastrando');
      lista.style.transform = `translateX(${inicioOffset}px)`;
    });

    window.addEventListener('pointermove', (e) => {
      if (!lista.classList.contains('is-arrastrando') || e.pointerType === 'mouse') return;
      const delta = e.clientX - inicioX;
      if (Math.abs(delta) > 4) movio = true;
      lista.style.transform = `translateX(${wrap(inicioOffset + delta)}px)`;
    }, { passive: true });

    window.addEventListener('pointerup', () => {
      if (!lista.classList.contains('is-arrastrando')) return;
      inicioOffset = offsetActual();
      // Si hubo arrastre, tragarse el click que sigue al soltar (evita abrir el
      // link "Reseña de Google" cuando el dedo se soltó sobre él).
      if (movio) {
        lista.addEventListener('click', (ev) => ev.preventDefault(), { capture: true, once: true });
      }
    });

    // Al volver a scrollear la página, reanudar el loop desde el punto donde quedó.
    window.addEventListener('scroll', () => {
      if (!lista.classList.contains('is-arrastrando')) return;
      const progreso = -wrap(offsetActual()) / mitad();
      lista.style.animationDelay = `${-(progreso * DURACION_S)}s`;
      lista.classList.remove('is-arrastrando');
      lista.style.transform = '';
    }, { passive: true });
  }
</script>
