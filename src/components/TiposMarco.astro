---
import site from '../content/configuracion/site.json';

const whatsappHref = (mensaje: string) =>
  `https://wa.me/${site.telefono}?text=${encodeURIComponent(mensaje)}`;

const formas = [
  { imagen: '/images/tipos-marco/clasicas.svg', label: 'Clásicas' },
  { imagen: '/images/tipos-marco/redondas.svg', label: 'Redondas' },
  { imagen: '/images/tipos-marco/cuadradas.svg', label: 'Cuadradas' },
  { imagen: '/images/tipos-marco/aviador.svg', label: 'Aviador' },
  { imagen: '/images/tipos-marco/geometrico.svg', label: 'Geométricas' },
  { imagen: '/images/tipos-marco/browline.svg', label: 'Browline' },
] as const;
---

<section id="tipos-marco" class="bg-white py-16 md:py-24">
  <div class="mx-auto max-w-6xl px-4">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 class="text-2xl font-extrabold text-slate-900 md:text-3xl">
          Monturas para cada estilo
        </h2>
        <p class="mt-2 text-sm text-slate-600 md:text-base">
          Elige la forma de marco que más te favorece.
        </p>
      </div>
      <a
        href="/catalogo"
        class="inline-block whitespace-nowrap rounded-full bg-slate-900 px-5 py-2.5 text-sm font-semibold text-white transition-opacity hover:opacity-90"
      >
        Ver catálogo completo
      </a>
    </div>

    <div class="flex gap-6 overflow-x-auto pb-2 [-ms-overflow-style:none] [scrollbar-width:none] sm:grid sm:grid-cols-3 sm:overflow-visible lg:grid-cols-6 [&::-webkit-scrollbar]:hidden">
      {
        formas.map((forma) => (
          <a
            href={whatsappHref(`Hola, busco monturas estilo ${forma.label.toLowerCase()}`)}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex w-32 shrink-0 flex-col items-center gap-3 sm:w-auto"
          >
            <div class="relative flex aspect-square w-full items-center justify-center overflow-hidden rounded-[63%_37%_54%_46%/43%_37%_63%_57%] bg-aguamarina/12">
              <img
                src={forma.imagen}
                alt={`Monturas estilo ${forma.label}`}
                loading="lazy"
                class="h-[80%] w-[80%] rounded-full object-cover transition-transform duration-300 group-hover:scale-105"
              />
            </div>
            <span class="text-center text-sm font-bold uppercase tracking-wide text-slate-900">
              {forma.label}
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>
