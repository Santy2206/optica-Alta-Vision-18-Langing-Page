---
const formas = [
  { id: 'redondo', imagen: '/images/rostros/redondo.svg', label: 'Redondo' },
  { id: 'corazon', imagen: '/images/rostros/corazon.svg', label: 'Corazón' },
  { id: 'diamante', imagen: '/images/rostros/diamante.svg', label: 'Diamante' },
  { id: 'ovalado', imagen: '/images/rostros/ovalado.svg', label: 'Ovalado' },
  { id: 'cuadrado', imagen: '/images/rostros/cuadrado.svg', label: 'Cuadrado' },
] as const;
---

<section class="bg-aguamarina/5 py-16 md:py-24">
  <div class="mx-auto max-w-6xl px-4">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 class="text-2xl font-bold text-slate-900 md:text-3xl">Elige según tu forma de rostro</h2>
        <p class="mt-2 text-sm text-slate-600 md:text-base">
          Cada rostro luce mejor con ciertas monturas — te ayudamos a encontrar la tuya.
        </p>
      </div>
      <button
        type="button"
        data-facetest-open
        class="inline-block whitespace-nowrap rounded-full bg-slate-900 px-5 py-2.5 text-sm font-semibold text-white transition-opacity hover:opacity-90"
      >
        Haz el test de tu rostro
      </button>
    </div>

    <div class="grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-5">
      {
        formas.map((forma) => (
          <button type="button" data-facetest-manual={forma.id} class="group flex flex-col items-center gap-3">
            <div class="aspect-square w-full max-w-[9rem] overflow-hidden">
              <img
                src={forma.imagen}
                alt={`Rostro ${forma.label}`}
                loading="lazy"
                class="h-full w-full object-contain transition-transform duration-300 group-hover:scale-105"
              />
            </div>
            <span class="text-center text-sm font-bold uppercase tracking-wide text-slate-900">
              {forma.label}
            </span>
          </button>
        ))
      }
    </div>
    <p class="mt-4 text-center text-xs text-slate-500">
      ¿No sabes cuál es tu forma? Elige una manualmente o{' '}
      <button type="button" data-facetest-open class="font-semibold text-aguamarina underline-offset-2 hover:underline">
        haz el test completo
      </button>
      .
    </p>
  </div>
</section>
