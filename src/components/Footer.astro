---
import site from '../utils/site';
import Icon from './Icon.astro';

// Formato legible del teléfono colombiano 573118812747 → +57 311 881 2747
const raw = site.telefono;
const formatted = raw.startsWith('57') ? `+57 ${raw.slice(2, 5)} ${raw.slice(5, 8)} ${raw.slice(8)}` : raw;

const { instagram, facebook } = site.redesSociales;
const { lat, lng } = site.geo;
const comoLlegarHref = lat !== null && lng !== null ? `https://www.google.com/maps?q=${lat},${lng}` : site.googleReviews.url;
---

<footer class="bg-brand-footer pb-12 text-slate-700">
  <div class="h-[3px] w-full brand-bar" aria-hidden="true"></div>
  <div class="mx-auto max-w-6xl px-4 pt-12">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <!-- Marca -->
      <div class="space-y-4">
        <span class="inline-block rounded-xl bg-white p-2">
          <img src="/logo.webp" alt="Óptica Alta Visión 18" width="310" height="96" loading="lazy" class="h-9 w-auto" />
        </span>
        <p class="text-sm text-slate-600">Optometría profesional y monturas para toda la familia.</p>
      </div>

      <!-- Contacto -->
      <div class="space-y-3">
        <p class="text-sm font-semibold uppercase tracking-wide text-slate-600">Contacto</p>
        {site.direccion && <p class="text-sm text-slate-700">{site.direccion}</p>}
        <a href={`tel:+${site.telefono}`} class="block text-sm text-slate-700 hover:text-slate-900 hover:underline">
          {formatted}
        </a>
      </div>

      <!-- Horario y ubicación -->
      <div class="space-y-3">
        <p class="text-sm font-semibold uppercase tracking-wide text-slate-600">Horario</p>
        {site.horario && <p class="text-sm text-slate-700">{site.horario}</p>}
        {
          comoLlegarHref && (
            <a
              href={comoLlegarHref}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-sm font-semibold text-slate-900 hover:underline"
            >
              <Icon name="location" class="h-4 w-4" />
              Cómo llegar
            </a>
          )
        }
      </div>

      <!-- Redes -->
      {
        (instagram || facebook) && (
          <div class="space-y-3">
            <p class="text-sm font-semibold uppercase tracking-wide text-slate-600">Síguenos en redes</p>
            <ul class="flex flex-wrap gap-3">
              {instagram && (
                <li>
                  <a
                    href={instagram}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 rounded-full bg-aguamarina px-3 py-1.5 text-sm font-semibold text-white transition-all hover:bg-slate-900"
                  >
                    <Icon name="instagram" class="h-4 w-4" />
                    Instagram
                  </a>
                </li>
              )}
              {facebook && (
                <li>
                  <a
                    href={facebook}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 rounded-full bg-aguamarina px-3 py-1.5 text-sm font-semibold text-white transition-all hover:bg-slate-900"
                  >
                    <Icon name="facebook" class="h-4 w-4" />
                    Facebook
                  </a>
                </li>
              )}
            </ul>
          </div>
        )
      }
    </div>

    <div class="mt-10 border-t border-slate-900/15 pt-6 text-center text-sm text-slate-600">
      © {new Date().getFullYear()} Alta Visión 18. Todos los derechos reservados.
    </div>
  </div>
</footer>
