---
// Silueta SVG lineal de montura, por forma. Usada como reemplazo de foto cuando el
// catálogo todavía tiene una imagen "Foto pendiente" del CMS, y como icono en
// "Encuentra tus gafas". No depende de fotos reales, así que nunca queda vacía.
import type { FrameShape } from '../data/frameShape';

interface Props {
  shape: FrameShape;
  class?: string;
}

const { shape, class: className = 'h-10 w-10' } = Astro.props;

// Dos lentes + puente + inicio de varillas, en un viewBox común de 64×32.
const LENSES: Record<FrameShape, string> = {
  redonda: '<circle cx="16" cy="16" r="12"/><circle cx="48" cy="16" r="12"/>',
  ovalada: '<ellipse cx="16" cy="16" rx="13" ry="10"/><ellipse cx="48" cy="16" rx="13" ry="10"/>',
  cuadrada: '<rect x="4" y="5" width="24" height="22" rx="3"/><rect x="36" y="5" width="24" height="22" rx="3"/>',
  rectangular: '<rect x="3" y="8" width="26" height="16" rx="2"/><rect x="35" y="8" width="26" height="16" rx="2"/>',
  clubmaster:
    '<path d="M4 9 Q4 26 16 26 Q28 26 28 9" stroke-width="1.5"/><path d="M3 9 Q16 5 29 9" stroke-width="5"/><path d="M36 9 Q36 26 48 26 Q60 26 60 9" stroke-width="1.5"/><path d="M35 9 Q48 5 61 9" stroke-width="5"/>',
  aviador:
    '<path d="M4 14 Q4 6 16 6 Q28 6 28 16 Q28 27 16 27 Q4 27 4 14Z"/><path d="M36 14 Q36 6 48 6 Q60 6 60 16 Q60 27 48 27 Q36 27 36 14Z"/>',
  'cat-eye':
    '<path d="M4 18 Q3 6 17 7 Q29 8 27 18 Q25 26 15 25 Q5 24 4 18Z"/><path d="M36 18 Q35 6 49 7 Q61 8 59 18 Q57 26 47 25 Q37 24 36 18Z"/>',
};

const path = LENSES[shape];
---

<svg viewBox="-4 0 72 32" class={className} fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
  <Fragment set:html={path} />
  <path d="M28 14h8" stroke-width="2.5" />
  <path d="M4 15 L-2 12" stroke-width="2.5" />
  <path d="M60 15 L66 12" stroke-width="2.5" />
</svg>
