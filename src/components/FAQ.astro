---
// Preguntas y schema FAQPage salen de utils/faq.ts (compartido con la versión Flow).
import { faqs, faqSchema as schema } from '../utils/faq';
import { waLink } from '../utils/whatsapp';
import Icon from './Icon.astro';

const origen = 'faq';
---

<section id="faq" class="bg-white py-16 md:py-24">
  <div class="mx-auto max-w-3xl px-4">
    <h2 class="mb-10 text-center text-2xl font-bold text-slate-900 md:text-3xl">
      Preguntas frecuentes
    </h2>

    <div class="space-y-4">
      {
        faqs.map((item) => (
          <details class="group rounded-2xl border border-slate-200 bg-white open:ring-1 open:ring-aguamarina/30">
            <summary class="flex cursor-pointer list-none items-center justify-between p-4 text-base font-semibold text-slate-900">
              {item.q}
              <span class="ml-2 text-slate-900 transition-transform group-open:rotate-45" aria-hidden="true">
                +
              </span>
            </summary>
            <p class="border-t border-slate-100 p-4 text-sm text-slate-600">{item.a}</p>
          </details>
        ))
      }
    </div>

    <div class="mt-10 flex flex-col items-center gap-4 text-center">
      <p class="text-lg font-semibold text-slate-900">¿Tienes otra pregunta?</p>
      <a
        href={waLink(origen, 'Hola, tengo una pregunta')}
        data-cta={origen}
        target="_blank"
        rel="noopener noreferrer"
        class="border-2 border-slate-900 inline-flex items-center gap-2 rounded-full bg-verde-neon px-6 py-3 font-semibold text-slate-900 shadow-sm transition-all hover:shadow-md"
      >
        <Icon name="whatsapp" class="h-5 w-5" />
        Pregúntanos por WhatsApp
      </a>
    </div>
  </div>

  {faqs.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
</section>
